---
const { active = "" } = Astro.props;
const inboxUrl = "https://www.dropbox.com/scl/fo/l073m5tkhprle70lmyszw/ALC8vEJfILXuKqpmTWKw6Cg?rlkey=03rjgx0hhnzj7t8u4hsxzyr74&st=c6omhyut&dl=0";
const uploadUrl = "https://www.dropbox.com/request/4ha3swzj8zyl4mez6j8g";
---

<a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
<header class="site-header">
  <a class="brand" href="/drachenhalle/" aria-label="DIE Drachenhalle – Startseite">
    <img
      class="brand-mark"
      src="/drachenhalle/brand/die-drachenhalle-logo.png"
      width="52"
      height="52"
      alt=""
      aria-hidden="true"
    />
    <span class="brand-copy">
      <strong>Drachenhalle</strong>
      <small>Z:Route · DIE</small>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="Hauptnavigation">
    <a class:list={[{ "is-active": active === "news" }]} href="/drachenhalle/">Aktuelles</a>
    <a class:list={[{ "is-active": active === "events" }]} href="/drachenhalle/termine/">Termine</a>
    <a class:list={[{ "is-active": active === "gallery" }]} href="/drachenhalle/galerie/">Galerie</a>
    <a class:list={[{ "is-active": active === "informationen" }]} href="/drachenhalle/docs/">Drachenwissen</a>
    <a class:list={[{ "is-active": active === "gestaltung" }]} href="/drachenhalle/docs/styleguides/">Styleguides</a>
  </nav>

  <div class="header-actions">
    <a class="inbox-link" href={inboxUrl} target="_blank" rel="noopener noreferrer" aria-label="Dropbox-Inbox ansehen (öffnet in neuem Tab)">
      <span class="action-label-full" aria-hidden="true">Inbox ansehen</span>
      <span class="action-label-short" aria-hidden="true">Inbox</span>
      <span aria-hidden="true">↗</span>
    </a>
    <a class="upload-link" href={uploadUrl} target="_blank" rel="noopener noreferrer" aria-label="Datei bei Dropbox einreichen (öffnet in neuem Tab)">
      <span class="action-label-full" aria-hidden="true">Datei einreichen</span>
      <span class="action-label-short" aria-hidden="true">Einreichen</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <details class="mobile-menu">
    <summary>
      <span class="mobile-menu-icon" aria-hidden="true"></span>
      <span>Menü</span>
    </summary>
    <div class="mobile-menu-panel">
      <nav aria-label="Mobile Hauptnavigation">
        <a class:list={[{ "is-active": active === "news" }]} href="/drachenhalle/">Aktuelles</a>
        <a class:list={[{ "is-active": active === "events" }]} href="/drachenhalle/termine/">Termine</a>
        <a class:list={[{ "is-active": active === "gallery" }]} href="/drachenhalle/galerie/">Galerie</a>
        <a class:list={[{ "is-active": active === "informationen" }]} href="/drachenhalle/docs/">Drachenwissen</a>
        <a class:list={[{ "is-active": active === "gestaltung" }]} href="/drachenhalle/docs/styleguides/">Styleguides</a>
      </nav>
      <div class="mobile-menu-actions">
        <a class="inbox-link" href={inboxUrl} target="_blank" rel="noopener noreferrer">Inbox ansehen <span aria-hidden="true">↗</span></a>
        <a class="upload-link" href={uploadUrl} target="_blank" rel="noopener noreferrer">Datei einreichen <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </details>
</header>
