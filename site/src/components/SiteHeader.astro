---
import InboxLink from "./InboxLink.astro";

const { active = "" } = Astro.props;
const uploadUrl = "https://www.dropbox.com/request/4ha3swzj8zyl4mez6j8g";
const currentPath = Astro.url.pathname;
const navigationItems = [
  {
    key: "news",
    label: "Aktuelles",
    links: [
      { label: "Übersicht", href: "/drachenhalle/" },
      { label: "Neuigkeiten", href: "/drachenhalle/#neuigkeiten" },
      { label: "Letztes Update", href: "/drachenhalle/#letztes-update" },
    ],
  },
  {
    key: "tutorials",
    label: "Tutorials",
    links: [
      { label: "Neu in der Drachenhalle", href: "/drachenhalle/docs/dein-einstieg-bei-uns/" },
      { label: "Profilbild im Spiel", href: "/drachenhalle/docs/profilbild-im-spiel/" },
    ],
  },
  {
    key: "informationen",
    label: "Drachenwissen",
    links: [
      { label: "Übersicht", href: "/drachenhalle/docs/" },
      { label: "Tipps", href: "/drachenhalle/docs/tipps/" },
      { label: "Event-Guides", href: "/drachenhalle/docs/events/" },
      { label: "Eventankündigungen", href: "/drachenhalle/docs/eventankuendigungen/" },
    ],
  },
  {
    key: "alliance",
    label: "Allianz",
    links: [
      { label: "Übersicht", href: "/drachenhalle/docs/allianz/" },
      { label: "Unsere Regeln", href: "/drachenhalle/docs/allianzregeln/" },
      { label: "Unsere Offiziere", href: "/drachenhalle/docs/unsere-offiziere/" },
      { label: "Unsere Verantwortlichkeiten", href: "/drachenhalle/docs/unsere-verantwortlichkeiten/" },
    ],
  },
  {
    key: "events",
    label: "Termine",
    links: [
      { label: "Übersicht", href: "/drachenhalle/termine/" },
      { label: "Monatskalender", href: "/drachenhalle/termine/#kalender" },
      { label: "Kommende Events", href: "/drachenhalle/termine/#kommende-termine" },
      { label: "Vergangene Events", href: "/drachenhalle/termine/#vergangene-termine" },
    ],
  },
  {
    key: "gallery",
    label: "Galerie",
    links: [
      { label: "Alle Bilder", href: "/drachenhalle/galerie/" },
      { label: "Chatbilder", href: "/drachenhalle/galerie/?kategorie=Chatbild" },
      { label: "Reaktionsbilder", href: "/drachenhalle/galerie/?kategorie=Reaktionsbild" },
      { label: "Avatare", href: "/drachenhalle/galerie/?kategorie=Avatar" },
      { label: "Charaktermodelle", href: "/drachenhalle/galerie/?kategorie=Charaktermodell" },
    ],
  },
];

const isCurrentLink = (href) => !href.includes("#") && !href.includes("?") && href === currentPath;
---

<a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
<header class="site-header">
  <a class="brand" href="/drachenhalle/" aria-label="DIE Drachenhalle – Startseite">
    <img
      class="brand-mark"
      src="/drachenhalle/brand/die-drachenhalle-logo.png"
      width="52"
      height="52"
      alt=""
      aria-hidden="true"
    />
    <span class="brand-copy">
      <strong>Drachenhalle</strong>
      <small>Z:Route · DIE</small>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="Hauptnavigation">
    {navigationItems.map((item) => (
      <details class:list={["nav-group", { "is-active": active === item.key }]}>
        <summary aria-label={`${item.label}: Untermenü öffnen`}>
          <span>{item.label}</span>
          <span class="nav-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="nav-dropdown">
          {item.links.map((link) => (
            <a href={link.href} aria-current={isCurrentLink(link.href) ? "page" : undefined}>{link.label}</a>
          ))}
        </div>
      </details>
    ))}
  </nav>

  <div class="header-actions">
    <a class="upload-link" href={uploadUrl} target="_blank" rel="noopener noreferrer" aria-label="Datei bei Dropbox einreichen (öffnet in neuem Tab)">
      <span class="action-label-full" aria-hidden="true">Datei einreichen</span>
      <span class="action-label-short" aria-hidden="true">Einreichen</span>
      <span aria-hidden="true">↗</span>
    </a>
    <button class="upload-help-trigger" type="button" aria-label="Hilfe zum Einreichen von Dateien" aria-haspopup="dialog" aria-controls="upload-help-dialog" title="So funktioniert das Einreichen">
      <span aria-hidden="true">?</span>
    </button>
    <InboxLink />
  </div>

  <details class="mobile-menu">
    <summary>
      <span class="mobile-menu-icon" aria-hidden="true"></span>
      <span>Menü</span>
    </summary>
    <div class="mobile-menu-panel">
      <nav class="mobile-nav" aria-label="Mobile Hauptnavigation">
        {navigationItems.map((item) => (
          <details class:list={["mobile-nav-group", { "is-active": active === item.key }]}>
            <summary>
              <span>{item.label}</span>
              <span class="nav-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div>
              {item.links.map((link) => (
                <a href={link.href} aria-current={isCurrentLink(link.href) ? "page" : undefined}>{link.label}</a>
              ))}
            </div>
          </details>
        ))}
      </nav>
      <div class="mobile-menu-actions">
        <a class="upload-link" href={uploadUrl} target="_blank" rel="noopener noreferrer">Datei einreichen <span aria-hidden="true">↗</span></a>
        <button class="upload-help-trigger" type="button" aria-label="Hilfe zum Einreichen von Dateien" aria-haspopup="dialog" aria-controls="upload-help-dialog" title="So funktioniert das Einreichen">
          <span aria-hidden="true">?</span>
        </button>
        <InboxLink />
      </div>
    </div>
  </details>
</header>

<dialog class="upload-help-dialog" id="upload-help-dialog" aria-labelledby="upload-help-title">
  <div class="upload-help-content">
    <div class="upload-help-heading">
      <div>
        <p class="eyebrow">Datei einreichen</p>
        <h2 id="upload-help-title">So funktioniert der Upload</h2>
      </div>
      <button class="upload-help-close" type="button" aria-label="Hilfe schließen" title="Schließen" data-upload-help-close>×</button>
    </div>

    <ol class="upload-help-steps">
      <li>
        <strong>Datei auswählen</strong>
        <span>Wähle in der Dropbox-Dateianfrage das Bild oder Dokument aus, das du einreichen möchtest.</span>
      </li>
      <li>
        <strong>Ingame-Namen eintragen</strong>
        <span>Nutze deinen Ingame-Namen. Als E-Mail-Adresse genügt eine formal gültige Beispieladresse wie <code>spielername@example.com</code>.</span>
      </li>
      <li>
        <strong>Upload bestätigen</strong>
        <span>Tippe auf „Hochladen“. Die anschließende Bestätigung zeigt dir, dass die Datei erfolgreich übermittelt wurde.</span>
      </li>
    </ol>

    <p class="upload-privacy-note">
      <strong>Bitte keine personenbezogenen Daten angeben.</strong>
      Verwende weder deinen echten Namen noch eine private E-Mail-Adresse oder andere persönliche Angaben. Ingame-Name und Beispieladresse reichen aus.
    </p>

    <p class="upload-inbox-note">
      Nach dem Abschicken kannst du über das Inbox-Symbol prüfen, ob deine Datei angekommen ist und noch auf die Verarbeitung wartet.
    </p>

    <div class="upload-help-actions">
      <a class="upload-link" href={uploadUrl} target="_blank" rel="noopener noreferrer">Datei auswählen <span aria-hidden="true">↗</span></a>
      <InboxLink />
    </div>
  </div>
</dialog>

<script>
  const navigationGroups = document.querySelectorAll(".desktop-nav .nav-group");

  navigationGroups.forEach((group) => {
    group.addEventListener("toggle", () => {
      if (!group.hasAttribute("open")) return;
      navigationGroups.forEach((otherGroup) => {
        if (otherGroup !== group) otherGroup.removeAttribute("open");
      });
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    navigationGroups.forEach((group) => {
      if (!group.contains(event.target)) group.removeAttribute("open");
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    navigationGroups.forEach((group) => group.removeAttribute("open"));
  });

  const uploadHelpDialog = document.querySelector("#upload-help-dialog");
  const uploadHelpTriggers = document.querySelectorAll(".upload-help-trigger");
  const uploadHelpClose = document.querySelector("[data-upload-help-close]");

  if (uploadHelpDialog instanceof HTMLDialogElement) {
    uploadHelpTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => uploadHelpDialog.showModal());
    });

    uploadHelpClose?.addEventListener("click", () => uploadHelpDialog.close());
    uploadHelpDialog.addEventListener("click", (event) => {
      if (event.target === uploadHelpDialog) uploadHelpDialog.close();
    });
  }
</script>
