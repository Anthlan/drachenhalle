.battle-chronicle[hidden]{display:none}.battle-chronicle{border-top:1px solid #a47c4255;margin:1.2rem 0;padding-top:.4rem}.battle-chronicle h3{color:#efd19a;font-size:1.12rem;margin:1.3rem 0 .6rem}.battle-chronicle p{line-height:1.7}.battle-closing{color:#efd19a;font-style:italic}.battle-credit{font-size:.85rem;color:#aeb2bb}.trophy-dialog:has(.battle-chronicle:not([hidden])){max-width:740px}.victory-link img{width:100%;max-width:620px}

