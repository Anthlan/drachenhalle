---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HallAnthlan from "../components/HallAnthlan.astro";
import gallery from "../data/gallery.generated.json";
import { earlyGuardianLegends } from "../data/guardian-legends";
const legendImages = Object.fromEntries(earlyGuardianLegends.map(legend => {
  const image = gallery.items.find(item => item.sourcePath.endsWith(legend.imageFile));
  if (!image) throw new Error(`Das Legendenbild für Wächter ${legend.level} fehlt in der Galerie.`);
  return [legend.level, { url: image.webUrl, thumbnail: image.webUrl, alt: legend.imageAlt, caption: `Fiktives Legendenbild zum ${legend.level}er vergrößern ↗` }];
}));
const victory = gallery.items.find(item => item.sourcePath.endsWith("2026_10_04_2204_Waechter140_Drachenherz_Anthlan.png"));
if (!victory) throw new Error("Das Erinnerungsbild zum Wächter auf Stufe 140 fehlt in der Galerie.");
const victory150 = gallery.items.find(item => item.sourcePath.endsWith("2026_10_04_2204_Waechter150_Drachenherz_Anthlan_Boshos.png"));
if (!victory150) throw new Error("Das neue Erinnerungsbild zum Wächter auf Stufe 150 fehlt in der Galerie.");
const victory160 = gallery.items.find(item => item.sourcePath.endsWith("2026_10_04_2113_Waechter160_Drachenherz_Anthlan_Killergruppe_Hulkster666.png"));
if (!victory160) throw new Error("Das Erinnerungsbild zum Wächter auf Stufe 160 fehlt in der Galerie.");
const victoryImages = {
  ...legendImages,
  140: { url: victory.webUrl, thumbnail: victory.webUrl, alt: "Drachenherz und Anthlan in ihren M2-Ausstattungen beim ersten Sieg über einen Wächter auf Stufe 140.", caption: "Erinnerungsbild zum 140er vergrößern ↗" },
  150: { url: victory150.webUrl, thumbnail: victory150.webUrl, alt: "Drachenherz und Anthlan stehen beim besiegten Wächter auf Stufe 150 im Mittelpunkt. Boshos unterstützt im Hintergrund nach seinem finalen Schlag.", caption: "Neues Erinnerungsbild zum 150er vergrößern ↗" },
  160: { url: victory160.webUrl, thumbnail: victory160.webUrl, alt: "Drachenherz und Anthlan stehen gemeinsam im Mittelpunkt beim gefallenen Wächter auf Stufe 160. Killergruppe und Hulkster666 unterstützen sie im Hintergrund.", caption: "Erinnerungsbild zum 02.10.2026 vergrößern ↗" },
};
const battleIntroductions = {
  140: "Eine fixe Idee von Drachenherz und Anthlan: einfach die nächste Stufe versuchen. Nach 60 % Schaden im ersten Anlauf fällt der 140er im zweiten – und macht Mut auf mehr.",
  150: "Vom Erfolg beim 140er beflügelt, gehen Drachenherz und Anthlan die nächste Stufe an. Nur 40 % Schaden im ersten Versuch. Doch mit Unterstützung fällt der 150er schon im zweiten Anlauf.",
  160: "Was als Feier für Anthlans neue T9 begann, wurde zu einer Schlacht, die wir so schnell nicht vergessen. Zwei Angriffe. Sechs Mitstreiter. Ein hart erkämpfter Meilenstein.",
};
const dates: Record<number, string> = {100:"2026-08-13",110:"2026-08-20",120:"2026-08-28",130:"2026-09-05",140:"2026-09-08",150:"2026-09-08",160:"2026-10-02"};
const trophies = Array.from({length:11}, (_, index) => {
  const level = 100 + index * 10;
  const date = dates[level];
  return {level,date,won:level<=160,estimated:level<140,label:date ? new Intl.DateTimeFormat("de-DE",{day:"2-digit",month:"long",year:"numeric",timeZone:"UTC"}).format(new Date(`${date}T12:00:00Z`)) : "Dieser Ehrenplatz wartet auf uns."};
});
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <meta name="description" content="Betritt die Ruhmeshalle unserer Allianzzentrale: Wächtertrophäen, gemeinsame Siege und die nächsten Herausforderungen bis Stufe 200." />
  <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" /><title>Ruhmeshalle · DIE Drachenhalle</title>
</head>
<body><div class="page-shell"><SiteHeader active="alliance" />
<main id="main-content" class="hall">
  <nav class="breadcrumbs" aria-label="Brotkrümelnavigation"><a href="/drachenhalle/">Start</a><span>/</span><a href="/drachenhalle/docs/allianz/">Allianz</a><span>/</span><span aria-current="page">Ruhmeshalle</span></nav>
  <header class="hall-heading"><div><p class="eyebrow">Allianzzentrale · Der Raum unserer Siege</p><h1>Die Ruhmeshalle</h1><p>Sieben Köpfe an der Wand. Vier Plätze für das, was noch kommt.</p></div><div class="record"><small>Höchster Sieg</small><strong>160</strong><span>Wächterstufe</span></div></header>
  <div class="room-toolbar"><p id="guide-hint">Wähle eine Trophäe oder sprich Anthlan an.</p><div><button data-guide-pause aria-pressed="false">Anthlan anhalten</button><button data-fire aria-pressed="true">Kaminfeuer an</button><button data-light aria-pressed="false">Abendstimmung</button></div></div>
  <div class="room-scroll" tabindex="0" aria-label="Trophäenraum; auf kleinen Bildschirmen seitlich verschiebbar">
    <section class="room" aria-label="Interaktive Trophäenwand in unserer Allianzzentrale">
      <div class="room-shade"></div><div class="room-heading"><span>DIE</span><strong>Gemeinsam stärker</strong></div>
      <div class="mounts">
        {trophies.map(trophy => <button class:list={["mount",{"empty":!trophy.won,"latest":trophy.level===160}]} data-trophy={trophy.level} aria-label={`Wächter Stufe ${trophy.level}: ${trophy.won ? `besiegt, ${trophy.estimated ? "Datum geschätzt" : "Datum bestätigt"}` : "noch offen"}. Details öffnen.`}>
          <span class="mount-art">{trophy.won ? <img src="/drachenhalle/brand/guardian-trophy-head.webp" alt="" style={`filter:sepia(${(trophy.level-100)/160}) brightness(${.8+(trophy.level-100)/180})`} /> : <span class="empty-shield"><span aria-hidden="true">◇</span></span>}</span>
          <span class="mount-plaque"><strong>{trophy.level}</strong><small>{trophy.won ? "Besiegt" : "Ehrenplatz frei"}</small></span>
        </button>)}
      </div>
      <div class="fireplace" aria-hidden="true"><div class="fire-glow"></div><div class="fire-bed"></div><div class="fire-sprite"></div><div class="embers"><i></i><i></i><i></i></div></div><div class="fire-reflection" aria-hidden="true"></div>
      <HallAnthlan />
      <p class="room-motto">Unsere Siege bleiben. Unsere Geschichte wächst.</p>
    </section>
  </div>
  <nav class="trophy-navigation" aria-label="Wächterstufe direkt auswählen">{trophies.map(trophy=><button data-trophy={trophy.level} class:list={[{"unclaimed":!trophy.won}]}>{trophy.level}<span class="sr-only"> {trophy.won?"besiegt":"offen"}</span></button>)}</nav>
  <p class="hall-note">Stufe 100–130: Siege bestätigt, Daten rückblickend geschätzt anhand von 83 Spieltagen am 03.10.2026 (angenommener Start: 13.07.2026). Stufe 140 und 150: 08.09.2026. Stufe 160: 02.10.2026.</p>
  <dialog class="trophy-dialog" aria-labelledby="trophy-title">
    <form method="dialog"><button class="close">Schließen ×</button></form>
    <p class="eyebrow" data-status></p><h2 id="trophy-title"></h2><p class="victory-date" data-date></p><p data-story></p>
    <a class="victory-link" href={victory.webUrl} target="_blank" rel="noopener"><img src={victory.webUrl} width="640" height="427" alt="Drachenherz und Anthlan beim Sieg über Wächter Stufe 140." /><span>Erinnerungsbild zum 140er vergrößern ↗</span></a>
    {earlyGuardianLegends.map(legend => (
      <section class="battle-chronicle" data-chronicle={legend.level} hidden aria-label={`Fiktive Legende zu Wächter Stufe ${legend.level}`}>
        <p class="battle-credit">Fiktive Geschichte und erfundene DIE-Mitglieder. Der Sieg ist bestätigt; Figuren und Handlung sind frei erzählt. Das Datum ist geschätzt.</p>
        <h3>{legend.title}</h3>
        {legend.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        <p class="battle-closing">{legend.closing}</p>
      </section>
    ))}
    <section class="battle-chronicle" data-chronicle="140" hidden aria-label="Chronik unserer ersten Wächtertötung auf Stufe 140">
      <p class="battle-credit">Rückblick nach der Erinnerung von Anthlan. Der genaue damalige Kampfbericht ist nicht mehr vorhanden.</p>
      <h3>Eine fixe Idee, zwei Mitstreiter</h3>
      <p>Drachenherz und Anthlan wollten wissen, was gemeinsam schon möglich war. Eine neue Wächterstufe ausprobieren – warum eigentlich nicht? Aus der fixen Idee wurde kurzerhand eine Jagd auf einen 140er.</p>
      <h3>60 % im ersten Anlauf</h3>
      <p>Schon der erste Angriff machte Mut: 60 % Schaden. Der Wächter stand noch, aber der neue Gegner ließ sich erstaunlich gut bezwingen. Ein zweiter Anlauf musste trotzdem her.</p>
      <p>Dann fiel der 140er. Drachenherz und Anthlan hatten den nächsten Meilenstein geschafft – und der Erfolg fühlte sich gut genug an, um gleich die nächste Frage zu stellen: Was geht wohl beim 150er?</p>
      <p class="battle-closing">Eine fixe Idee. Zwei Anläufe. Ein neuer Meilenstein – und plötzlich war die nächste Stufe zum Greifen nah.</p>
      <p class="battle-credit">Im Mittelpunkt dieser Jagd: Drachenherz und Anthlan.</p>
    </section>
    <section class="battle-chronicle" data-chronicle="150" hidden aria-label="Chronik unserer ersten Wächtertötung auf Stufe 150">
      <p class="battle-credit">Rückblick nach der Erinnerung von Anthlan. Der genaue damalige Kampfbericht ist nicht mehr vorhanden.</p>
      <h3>Nach dem 140er ist vor dem 150er</h3>
      <p>Der überraschend gute Erfolg beim 140er hatte Drachenherz und Anthlan auf eine Idee gebracht: weitergehen. Die beiden suchten einen Wächter auf Stufe 150 und legten los.</p>
      <h3>40 % – das wird kein Spaziergang</h3>
      <p>Der erste Angriff zeigte den Unterschied zur vorherigen Stufe deutlich. Nur 40 % Schaden. Drachenherz und Anthlan stellten sich auf drei Anläufe und viele Verluste ein. Dieser Wächter würde ihnen mehr abverlangen.</p>
      <h3>Unterstützung macht den Unterschied</h3>
      <p>Die Hauptaufgabe lag wieder bei Drachenherz und Anthlan. Doch diesmal machte die Unterstützung ihrer Mitstreiter den Unterschied: Schon beim zweiten Versuch konnte der Wächter besiegt werden.</p>
      <p>Boshos setzte den finalen Schlag. Er brachte damit zu Ende, was Drachenherz und Anthlan begonnen und mit ihren Kämpfen vorangetrieben hatten. Ein gemeinsamer Sieg – früher als nach dem ersten Anlauf erwartet.</p>
      <p class="battle-closing">Drei Anläufe befürchtet. Zwei gebraucht. Drachenherz und Anthlan gingen voran, ihre Unterstützer halfen, den nächsten Meilenstein nach Hause zu bringen.</p>
      <p class="battle-credit">Drachenherz und Anthlan trugen die Hauptaufgabe. Boshos setzte mit der Unterstützung der Mitstreiter den Schlusspunkt.</p>
    </section>
    <section class="battle-chronicle" data-chronicle="160" hidden aria-label="Chronik unserer ersten Wächtertötung auf Stufe 160">
      <h3>Neue T9. Ein großer Plan.</h3>
      <p>Anthlans neue T9-Soldaten waren ein guter Grund zum Feiern. Drachenherz und Anthlan hatten dafür eine Idee, die deutlich größer war als ein gemütlicher Abend: eine Wächterjagd. Ein neuer Meilenstein sollte her. Stufe 160.</p>
      <h3>Erster Angriff: zu groß für einen Happen</h3>
      <p>Gemeinsam mit ButterflySong zogen die beiden los. Die Arme ahnte wohl noch nicht, worauf sie sich eingelassen hatte. Drachenherz und Anthlan erledigten jeweils ein gegnerisches Team; Drachenherz schaffte sogar noch die Hälfte des dritten. Doch der Wächter war zu stark, um ihn in einem einzigen Anlauf zu bezwingen.</p>
      <h3>Zweiter Angriff: 60 % Restleben, neue Hoffnung</h3>
      <p>Der Wächter war geschwächt, aber noch lange nicht besiegt. Diesmal schlossen sich Hulkster666, Markus78 und Killergruppe den beiden an. Drachenherz räumte das erste Team ab. Anthlan fehlte diesmal das letzte Quäntchen Glück: Vom zweiten Team blieben 10 % übrig. Hulkster666 traf auf das dritte Team – und bekam keinen Stich.</p>
      <p>In der nächsten Runde beseitigte Drachenherz die Reste von Anthlans Gegner. Für Markus78 blieb das nahezu volle dritte Team. Ein ungleicher Kampf, in dem auch er keine Chance hatte. Schließlich stellte sich Drachenherz diesem Gegner. Er brachte ihn an den Rand der Niederlage, doch am Ende zwang das dritte Team auch ihn in die Knie. Knapp. Aber noch nicht vorbei.</p>
      <h3>Gemeinsam bis zum letzten Schritt</h3>
      <p>Was vom dritten Team übrig war, brachte Killergruppe schließlich zur Strecke. Der Wächter fiel. Nach zwei Angriffen und einer verlustreichen Schlacht für beide Seiten gehörte Stufe 160 zum ersten Mal unserer Allianz.</p>
      <p class="battle-closing">Es war kein schöner Sieg. Aber es war ein denkwürdiger Tag für DIE. Drachenherz und Anthlan hatten diese Jagd geplant und mit ihren Kämpfen vorangetrieben. Mit der Unterstützung ihrer Mitstreiter wurde aus ihrem großen Plan schließlich unser gemeinsamer Meilenstein.</p>
      <p class="battle-credit">Dabei waren: Drachenherz, Anthlan, ButterflySong, Hulkster666, Markus78 und Killergruppe.</p>
    </section>
    <div class="dialog-navigation"><button data-previous>← Vorheriger Platz</button><button data-next>Nächster Platz →</button></div>
  </dialog>
</main><SiteFooter /></div></body>
</html>
<script define:vars={{trophies, victoryImages, battleIntroductions}}>
  const dialog = document.querySelector('.trophy-dialog');
  let current = 0;
  function showTrophy(index) {
    current = index;
    const trophy = trophies[index];
    document.querySelector('#trophy-title').textContent = `Wächter · Stufe ${trophy.level}`;
    document.querySelector('[data-status]').textContent = trophy.estimated ? 'Die namenlosen Helden · Fiktive Legende' : trophy.won ? 'Trophäe unserer Gemeinschaft' : 'Unser nächstes Kapitel';
    document.querySelector('[data-date]').textContent = trophy.won ? `${trophy.label} · Datum ${trophy.estimated ? 'geschätzt' : 'bestätigt'}` : trophy.label;
    document.querySelector('[data-story]').textContent = !trophy.won ? 'Das Schild ist noch leer. Hier wird der Wächterkopf hängen, wenn wir diese Stufe zum ersten Mal gemeinsam bezwingen.' : trophy.estimated ? 'An die Namen der tapferen Helden kann sich heute niemand mehr erinnern. Doch ihre Leistungen gingen in die Geschichte von DIE ein. Diese Legenden geben den frühen Siegen ein Gesicht.' : battleIntroductions[trophy.level];
    document.querySelectorAll('[data-chronicle]').forEach(chronicle => { chronicle.hidden = Number(chronicle.dataset.chronicle) !== trophy.level; });
    const memory = victoryImages[trophy.level];
    const memoryLink = document.querySelector('.victory-link');
    memoryLink.hidden = !memory;
    if (memory) {
      memoryLink.href = memory.url;
      memoryLink.querySelector('img').src = memory.thumbnail;
      memoryLink.querySelector('img').alt = memory.alt;
      memoryLink.querySelector('span').textContent = memory.caption;
    }
    dialog.scrollTop = 0;
    document.querySelector('[data-previous]').disabled = index === 0;
    document.querySelector('[data-next]').disabled = index === trophies.length - 1;
    if (!dialog.open) dialog.showModal();
  }
  document.querySelectorAll('[data-trophy]').forEach(button => button.addEventListener('click', () => showTrophy(trophies.findIndex(trophy => trophy.level === Number(button.dataset.trophy)))));
  document.querySelector('[data-previous]').addEventListener('click', () => showTrophy(Math.max(0,current-1)));
  document.querySelector('[data-next]').addEventListener('click', () => showTrophy(Math.min(trophies.length-1,current+1)));
  dialog.addEventListener('click', event => { if(event.target===dialog) dialog.close(); });
  document.querySelector('[data-fire]').addEventListener('click', event => {
    const off = document.querySelector('.room').classList.toggle('fire-off');
    event.currentTarget.setAttribute('aria-pressed', String(!off));
    event.currentTarget.textContent = off ? 'Kaminfeuer aus' : 'Kaminfeuer an';
  });
  document.querySelector('[data-light]').addEventListener('click', event => {
    const dim = document.querySelector('.room').classList.toggle('evening');
    event.currentTarget.setAttribute('aria-pressed',String(dim));
  });
</script>
<style>
