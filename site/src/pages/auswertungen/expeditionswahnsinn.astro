---
import SocialMeta from "../../components/SocialMeta.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ReducedView from "../../components/ReducedView.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";
import "../../styles/expedition.css";
import data from "../../data/expedition-2026-10-10.json";
import analysisText from "../../../../content/Drachenwissen/Analysen/de/2026_10_10_Expeditionswahnsinn.md?raw";
import { marked } from "marked";
const analysisHtml = marked.parse(analysisText.replace(/^# .*\r?\n/, ""));
import { analyzeExpedition, share } from "../../scripts/expedition-analysis";
const analysis = analyzeExpedition(data.players, data.alliances);
const home = analysis.servers.find(s => s.server === 105)!;
const opponent = analysis.servers.find(s => s.server === 97)!;
const pairPoints = home.points + opponent.points;
const pairCount = home.count + opponent.count;
const number = (value: number) => Math.round(value).toLocaleString("de-DE");
const percent = (value: number) => (value * 100).toLocaleString("de-DE", {maximumFractionDigits:1}) + " %";
const title = "Expeditionswahnsinn · Hauptstadteroberung · DIE Drachenhalle";
const description = "Die Hauptstadteroberung vom 10.10.2026: S105 und S97 im Vergleich, Beteiligung und Punkte je Allianz sowie die vollständige Spielerrangliste.";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} /><title>{title}</title>
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <SocialMeta title={title} description={description} />
  </head>
  <body><ReducedView /><div class="page-shell">
    <SiteHeader active="alliance" />
    <main id="main-content" class="expedition">
      <div class="content-share-actions"><button type="button" class="tip-article-share" data-share-page data-share-url="/drachenhalle/auswertungen/expeditionswahnsinn/">Teilen</button><button type="button" class="tip-article-share" data-share-page data-share-reduced data-share-url="/drachenhalle/auswertungen/expeditionswahnsinn/">Reduziert teilen</button></div><header class="exp-hero">
        <div><p class="eyebrow">Event-Auswertung · 10. Oktober 2026</p><h1>Expeditionswahnsinn<span>Hauptstadteroberung</span></h1><p>Wer war dabei? Wer hat die Punkte getragen? Vergleicht unsere Beteiligung auf S105 mit S97 und schaut euch jede Allianz im Detail an.</p><div class="exp-jumps"><a href="#allianzen">Allianzen vergleichen ↓</a><a href="#spieler">Spieler finden ↓</a><a href="#daten">Datengrundlage ↓</a><a href="#analyse">Analyse lesen ↓</a></div></div>
        <div class="exp-seal"><strong>{analysis.count}</strong><span>Spieler in der vollständigen Rangliste</span><small>Stand der Screenshots: 10.10.2026 · 16:49 Uhr</small></div>
      </header>

      <section aria-labelledby="server-title" class="exp-section">
        <div class="exp-heading"><div><p class="eyebrow">Unser Server und der Gegner</p><h2 id="server-title">S105 vs. S97</h2></div><span class="exp-caption">Anteile beziehen sich hier auf diese beiden Server.</span></div>
        <div class="exp-scorecards">
          {[home,opponent].map(server => <article class:list={["exp-scorecard",server.server===105?"home":"opponent"]}>
            <div class="exp-card-label"><span>S{server.server}</span><small>{server.server===105?"Unser Server":"Gegnerserver"}</small></div>
            <strong class="exp-total">{number(server.points)}<small>Punkte</small></strong>
            <div class="exp-card-stats"><div><b>{server.count}</b><span>Teilnehmer</span></div><div><b>{number(server.average)}</b><span>Ø Punkte / Teilnehmer</span></div><div><b>{number(server.median)}</b><span>Median / Teilnehmer</span></div></div>
            <p><b>{percent(share(server.points,pairPoints))}</b> der gemeinsamen Punkte · <b>{percent(share(server.count,pairCount))}</b> der Teilnehmer</p>
          </article>)}
        </div>
        <div class="exp-comparison">
          <div class="exp-heading"><h3>Wie verteilen sich die Anteile?</h3><div class="exp-toggle" role="group" aria-label="Serververgleich nach Kennzahl"><button type="button" data-server-metric="points" aria-pressed="true">Punkte</button><button type="button" data-server-metric="count" aria-pressed="false">Teilnehmer</button></div></div>
          <div class="exp-share-bar" id="server-share-bar" role="img" aria-label={`Punkteanteile: S105 ${percent(share(home.points,pairPoints))}, S97 ${percent(share(opponent.points,pairPoints))}`}><span class="home" style={`width:${share(home.points,pairPoints)*100}%`}>S105 · {percent(share(home.points,pairPoints))}</span><span class="opponent" style={`width:${share(opponent.points,pairPoints)*100}%`}>S97 · {percent(share(opponent.points,pairPoints))}</span></div>
          <p id="server-insight" class="exp-insight">S105 stellt {percent(share(home.count,pairCount))} der Teilnehmer und erzielt {percent(share(home.points,pairPoints))} der Punkte im direkten Vergleich.</p>
        </div>
        <aside class="exp-extra"><strong>Weitere Server in der Rangliste</strong><span>S112: 1 Spieler · 17.000 Punkte</span><span>S108: 1 Spieler · 11.920 Punkte</span><span>S110: 1 Spieler · 108 Punkte</span><small>Diese drei Einträge werden separat gezählt und sind im direkten Vergleich oben nicht enthalten.</small></aside>
      </section>

      <section class="exp-section" id="allianzen" aria-labelledby="alliance-title">
        <div class="exp-heading"><div><p class="eyebrow">Breite Beteiligung oder wenige große Beiträge?</p><h2 id="alliance-title">Allianzen im Vergleich</h2></div></div>
        <div class="exp-controls">
          <label>Server<select id="exp-server"><option value="">Alle Server</option><option value="105">S105 · unser Server</option><option value="97">S97 · Gegnerserver</option><option value="other">Weitere Server</option></select></label>
          <label>Kennzahl<select id="exp-metric"><option value="points">Gesamtpunkte</option><option value="count">Teilnehmer</option><option value="participation">Beteiligungsquote</option><option value="average">Punkte pro Teilnehmer</option><option value="pointsPerMember">Punkte pro Allianzmitglied</option></select></label>
          <label class="exp-search">Allianz suchen<input id="exp-alliance-search" type="search" placeholder="Zum Beispiel DIE, GGR oder CrusaderZ" /></label>
        </div>
        <p class="exp-caption" id="chart-caption">Die 15 Allianzen mit den meisten Punkten. Wählt einen Balken für die Details.</p>
        <div class="exp-chart" id="exp-chart" aria-label="Allianzvergleich">
          {analysis.alliances.slice(0,15).map(alliance => <button type="button" class="exp-bar-row" data-alliance={alliance.key} title={`${alliance.name}: ${number(alliance.points)} Punkte`}><span class="exp-bar-label"><b>{alliance.tag||"—"}</b><small>S{alliance.server}</small></span><span class="exp-bar-track"><span class:list={["exp-bar-fill",alliance.server===105?"home":"opponent"]} style={`width:${share(alliance.points,analysis.alliances[0].points)*100}%`}></span></span><strong>{number(alliance.points)}</strong></button>)}
        </div>
        <p class="exp-caption">Beteiligungsquote = Spieler in der Rangliste ÷ Mitgliederzahl. Mitgliederzahlen liegen für 20 Allianzen von S105 vor. „—“ bedeutet, dass die Grundlage fehlt.</p>
        <details class="exp-alliance-table"><summary>Alle Allianzen als sortierte Tabelle <span id="alliance-table-count"></span></summary><div class="exp-table-scroll"><table><thead><tr><th>Allianz</th><th>Server</th><th>Teilnehmer</th><th>Mitglieder</th><th>Beteiligung</th><th>Punkte</th><th>Ø / Teilnehmer</th><th>Anteil am Server</th></tr></thead><tbody id="exp-alliance-rows"></tbody></table></div></details>
        <noscript><p>Der Serververgleich und die Grafik sind ohne JavaScript lesbar. Für Filter, Allianzdetails und die Spielersuche bitte JavaScript aktivieren.</p></noscript>
      </section>

      <section id="allianz-detail" class="exp-section exp-detail" aria-labelledby="detail-title">
        <div class="exp-heading"><div><p class="eyebrow">Eine Allianz unter der Lupe</p><h2 id="detail-title" tabindex="-1">Unsere Allianz DIE</h2></div><label>Allianz auswählen<select id="exp-detail-select">{analysis.alliances.map(a=><option value={a.key} selected={a.tag==="DIE"}>[{a.tag||"—"}] {a.name} · S{a.server}</option>)}</select></label></div>
        <div id="exp-detail-content"></div>
      </section>

      <section id="spieler" class="exp-section" aria-labelledby="players-title">
        <div class="exp-heading"><div><p class="eyebrow">Jeder Beitrag zählt</p><h2 id="players-title">Die vollständige Rangliste</h2></div><button class="exp-export" type="button" id="exp-export">Auswahl als CSV herunterladen ↓</button></div>
        <div class="exp-controls"><label class="exp-search">Spieler suchen<input id="exp-player-search" type="search" placeholder="Spielername oder Rang" /></label><label>Allianz<select id="exp-player-alliance"><option value="">Alle Allianzen</option>{analysis.alliances.map(a=><option value={a.key}>[{a.tag||"—"}] {a.name} · S{a.server}</option>)}</select></label><label>Sortieren<select id="exp-player-sort"><option value="rank">Rang aufsteigend</option><option value="name">Spielername A–Z</option><option value="points-asc">Punkte aufsteigend</option></select></label></div>
        <p id="exp-player-count" class="exp-caption" aria-live="polite"></p>
        <div class="exp-table-scroll"><table><thead><tr><th>Rang</th><th>Spieler</th><th>Allianz</th><th>Server</th><th>Punkte</th></tr></thead><tbody id="exp-player-rows"></tbody></table></div>
        <div class="exp-pagination"><button type="button" id="exp-prev">← Zurück</button><span id="exp-page" aria-live="polite"></span><button type="button" id="exp-next">Weiter →</button></div>
      </section>

      <section id="daten" class="exp-section exp-method" aria-labelledby="method-title"><p class="eyebrow">So lesen wir die Zahlen</p><h2 id="method-title">Datengrundlage & Einordnung</h2><div class="exp-method-grid"><div><h3>Vollständige Rangliste</h3><p>563 Spieler mit mindestens einem Punkt, erfasst aus 60 Screenshots. Der Stand der Bilder ist der 10.10.2026 gegen 16:49 Uhr. Die Zahlen beschreiben diesen Stand, nicht den Ausgang der Schlacht.</p></div><div><h3>Mitglieder und Beteiligung</h3><p>20 Allianzüberblicke von S105 liefern die Mitgliederzahlen. Jeder Ranglisteneintrag zählt als Teilnehmer. Punkte pro Allianzmitglied berücksichtigen auch Mitglieder ohne Ranglisteneintrag. Die Mitgliederzahl ist eine Momentaufnahme.</p></div><div><h3>Durchschnitt und Median</h3><p>Der Durchschnitt verteilt alle Punkte auf die Teilnehmer. Der Median zeigt den Wert in der Mitte: Eine Hälfte liegt darüber, die andere darunter. Einzelne sehr starke Spieler beeinflussen den Durchschnitt stärker.</p></div><div><h3>Wer trägt die Punkte?</h3><p>Top-1-, Top-5- und Top-10-Anteile beziehen sich auf die Punkte der ausgewählten Allianz. Ein hoher Anteil zeigt, wie stark wenige Spieler das Gesamtergebnis prägen.</p></div></div><p class="exp-caption">Keine Serverangabe im Bild gilt als S105. S97, S108, S110 und S112 werden nach ihrer sichtbaren Angabe geführt. Vier Spieler haben keine Allianzangabe. Die Kürzel Asg (S105) und ASG (S97) gehören zu verschiedenen Allianzen.</p></section>
      <section id="analyse" class="exp-section exp-written-analysis" aria-labelledby="written-analysis-title"><p class="eyebrow">Einordnung und nächste Schritte</p><h2 id="written-analysis-title">Analyse zur Hauptstadteroberung</h2><div set:html={analysisHtml} /></section>
    </main><p class="share-feedback" role="status" aria-live="polite" data-share-feedback></p><SiteFooter />
  </div><script>import "../../scripts/expedition-dashboard"; import { initializeImageActions } from "../../scripts/image-actions"; initializeImageActions();</script></body>
</html>
