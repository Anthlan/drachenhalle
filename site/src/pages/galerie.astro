---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ImageActionIcon from "../components/ImageActionIcon.astro";
import galleryData from "../data/gallery.generated.json";

const galleryItems = galleryData.items;
const categoryLabels = {
  Chatbild: "Chatbilder",
  Reaktionsbild: "Reaktionsbilder",
  Avatar: "Avatare",
  Charaktermodell: "Charaktere",
  Allianz: "Allianz",
  Tipp: "Tipps",
  Anleitung: "Anleitungen",
  Stilguide: "Stilguide",
  Strategie: "Strategien",
  Analyse: "Analysen",
};
const categories = Object.entries(categoryLabels)
  .map(([value, label]) => ({
    value,
    label,
    count: galleryItems.filter((item) => item.category === value).length,
  }))
  .filter((category) => category.count > 0);
const people = [...new Set(galleryItems.flatMap((item) => item.people))].sort((left, right) =>
  left.localeCompare(right, "de"),
);
const styles = galleryData.styles;
const avatarSets = galleryData.avatarSets ?? [];
const chatAndReactionImageCount = galleryItems.filter((item) =>
  ["Chatbild", "Reaktionsbild"].includes(item.category),
).length;
const referenceCount = galleryItems.filter((item) => ["Avatar", "Charaktermodell"].includes(item.category)).length;
const dateFormatter = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date) => date ? dateFormatter.format(new Date(`${date}T00:00:00Z`)) : "Ohne Datum";
const originalFileName = (item) => item.sourcePath.split("/").at(-1) ?? "die-bild.png";
const originalImageUrl = (item) => {
  const encodedPath = item.sourcePath.split("/").map((segment) => encodeURIComponent(segment)).join("/");
  return `https://raw.githubusercontent.com/Anthlan/drachenhalle/main/${encodedPath}`;
};
const originalMimeType = (item) => {
  const extension = originalFileName(item).split(".").at(-1)?.toLowerCase();
  if (extension === "jpg" || extension === "jpeg") return "image/jpeg";
  if (extension === "webp") return "image/webp";
  return "image/png";
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Die Bilderwelt der DIE Drachenhalle mit Chatbildern, Reaktionsbildern, Charaktermodellen und Allianzmotiven."
    />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Galerie · DIE Drachenhalle</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="gallery" />

      <main id="main-content">
        <section class="archive-intro" aria-labelledby="archive-title">
          <div>
            <p class="eyebrow">Bilder aus der Drachenhalle</p>
            <h1 id="archive-title">Bilder und Geschichten der Drachenritter</h1>
          </div>
          <p class="intro-copy">
            Durchsuche Chatbilder, Reaktionsbilder, Charakterreferenzen und Allianzmaterial. Die Originale bleiben mit ihrer
            vollständigen Qualität und Historie im GitHub-Repository erhalten.
          </p>
          <dl class="archive-stats" aria-label="Umfang der Galerie">
            <div><dt>{galleryData.imageCount}</dt><dd>Bilder</dd></div>
            <div><dt>{chatAndReactionImageCount}</dt><dd>Chat- &amp; Reaktionsbilder</dd></div>
            <div><dt>{referenceCount}</dt><dd>Referenzen</dd></div>
          </dl>
        </section>

        <section class="gallery-section" id="galerie" aria-labelledby="gallery-title">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Die vollständige Bildsammlung</p>
              <h2 id="gallery-title">Galerie</h2>
            </div>
            <p class="gallery-hint">Bild auswählen, die Galerieseite teilen oder das Original herunterladen.</p>
          </div>

          <div class="gallery-toolbar">
            <div class="category-list" role="group" aria-label="Nach Kategorie filtern">
              <button class="category-chip is-selected" type="button" data-category="all" aria-pressed="true">
                Alle <span>{galleryItems.length}</span>
              </button>
              {categories.map((category) => (
                <button class="category-chip" type="button" data-category={category.value} aria-pressed="false">
                  {category.label} <span>{category.count}</span>
                </button>
              ))}
            </div>

            <div class="people-filter">
              <label for="people-filter">Person</label>
              <select id="people-filter">
                <option value="all">Alle Personen</option>
                {people.map((person) => <option value={person}>{person}</option>)}
              </select>
            </div>

            <div class="gallery-select-filter">
              <label for="style-filter">Stil</label>
              <select id="style-filter">
                <option value="all">Alle Stile</option>
                {styles.map((style) => (
                  <option value={style.value}>{style.value} – {style.label} ({style.count})</option>
                ))}
              </select>
            </div>

            <div class="gallery-select-filter">
              <label for="avatar-set-filter">Avatar-Serie</label>
              <select id="avatar-set-filter">
                <option value="all">Alle Serien</option>
                {avatarSets.map((set) => (
                  <option value={set.value}>{set.label} ({set.count})</option>
                ))}
              </select>
            </div>

            <div class="gallery-result-tools">
              <p class="result-count" id="result-count" aria-live="polite">{galleryItems.length} Bilder</p>
              <button
                type="button"
                class="gallery-action gallery-filter-share"
                data-share-page
                data-share-url="/drachenhalle/galerie/"
                aria-label="Aktuelle Galerieauswahl teilen"
                title="Aktuelle Auswahl teilen"
              >
                <ImageActionIcon type="share" />
                <span>Auswahl teilen</span>
              </button>
            </div>
          </div>

          <div class="gallery-grid" id="gallery-grid">
            {galleryItems.map((item, index) => (
              <article
                id={`bild-${item.id}`}
                class="gallery-card"
                data-category={item.category}
                data-people={item.people.join("|")}
                data-style={item.style ?? ""}
                data-style-label={item.styleLabel ?? ""}
                data-avatar-set={item.avatarSet ?? ""}
                data-avatar-set-label={item.avatarSetLabel ?? ""}
                data-avatar-set-status={item.avatarSetStatus ?? ""}
                data-title={item.title}
                data-date={item.date ?? ""}
                data-date-label={formatDate(item.date)}
                data-web={item.webUrl}
                data-original={item.repositoryUrl}
                data-original-image={originalImageUrl(item)}
                data-original-name={originalFileName(item)}
                data-original-mime={originalMimeType(item)}
                data-page-url={`/drachenhalle/galerie/#bild-${item.id}`}
              >
                <button class="gallery-open" type="button" aria-label={`${item.title} öffnen`}>
                  <div class="image-frame">
                    <img
                      src={item.thumbnailUrl}
                      alt={item.title}
                      loading={index < 8 ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <span class="gallery-badges">
                      <span class="category-badge">{item.category}</span>
                      {item.style && <span class="style-badge" title={item.styleLabel}>{item.style}</span>}
                      {item.avatarSet && <span class="style-badge" title={item.avatarSetLabel}>{item.avatarSet}</span>}
                    </span>
                  </div>
                  <div class="card-copy">
                    <div>
                      <h3>{item.title}</h3>
                      <p>{item.people.length ? item.people.join(" · ") : "DIE"}</p>
                    </div>
                    <time datetime={item.date ?? undefined}>{formatDate(item.date)}</time>
                  </div>
                </button>
                <div class="gallery-card-actions" aria-label={`Aktionen für ${item.title}`}>
                  <button
                    type="button"
                    class="gallery-action"
                    data-share-image
                    data-share-url={`/drachenhalle/galerie/#bild-${item.id}`}
                    aria-label={`${item.title} teilen`}
                    title="Teilen"
                  >
                    <ImageActionIcon type="share" />
                  </button>
                  <button
                    type="button"
                    class="gallery-action"
                    data-save-image
                    data-original-url={originalImageUrl(item)}
                    data-file-name={originalFileName(item)}
                    data-mime-type={originalMimeType(item)}
                    aria-label={`Original von ${item.title} speichern`}
                    title="Original speichern"
                  >
                    <ImageActionIcon type="download" />
                  </button>
                </div>
              </article>
            ))}
          </div>

          <div class="gallery-empty" id="gallery-empty" hidden>
            <strong>Keine passenden Bilder gefunden.</strong>
            <span>Wähle eine andere Kategorie, Person oder einen anderen Stil.</span>
          </div>
        </section>

        <section class="next-sections" aria-label="Weitere Bereiche der Drachenhalle">
          <a class="section-link" href="/drachenhalle/docs/">
            <span>01</span>
            <h2>Drachenwissen</h2>
            <p>Tipps, Strategien und Informationen für den Spiel- und Allianzalltag.</p>
            <strong>Bereich öffnen →</strong>
          </a>
          <a class="section-link" href="/drachenhalle/docs/styleguides/">
            <span>02</span>
            <h2>Styleguides</h2>
            <p>Verbindliche Bildsprache, Gestaltung und Textformatierung.</p>
            <strong>Bereich öffnen →</strong>
          </a>
        </section>
      </main>

      <dialog class="gallery-dialog" id="gallery-dialog" aria-labelledby="detail-title">
        <div class="dialog-layout">
          <div class="dialog-stage">
            <button class="dialog-close" type="button" data-dialog-close aria-label="Detailansicht schließen">×</button>
            <img id="detail-image" alt="" />
            <div class="dialog-navigation" aria-label="Zwischen Bildern wechseln">
              <button type="button" id="detail-previous" aria-label="Vorheriges Bild">←</button>
              <span id="detail-position"></span>
              <button type="button" id="detail-next" aria-label="Nächstes Bild">→</button>
            </div>
          </div>
          <aside class="dialog-details">
            <p class="eyebrow" id="detail-category"></p>
            <h2 id="detail-title"></h2>
            <dl>
              <div><dt>Personen</dt><dd id="detail-people"></dd></div>
              <div><dt>Datum</dt><dd id="detail-date"></dd></div>
              <div id="detail-style-row"><dt>Stil</dt><dd id="detail-style"></dd></div>
              <div id="detail-avatar-set-row"><dt>Avatar-Serie</dt><dd id="detail-avatar-set"></dd></div>
            </dl>
            <div class="dialog-image-actions" aria-label="Bildaktionen">
              <button class="detail-share" id="detail-share" type="button" data-share-image aria-label="Bild teilen" title="Teilen">
                <ImageActionIcon type="share" />
              </button>
              <button class="detail-download" id="detail-download" type="button" data-save-image aria-label="Originalbild speichern" title="Original speichern">
                <ImageActionIcon type="download" />
              </button>
            </div>
            <a class="detail-original" id="detail-original" href="#" target="_blank" rel="noopener noreferrer">
              Original auf GitHub öffnen <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </dialog>

      <p class="share-feedback" role="status" aria-live="polite" aria-atomic="true" data-share-feedback></p>

      <SiteFooter />
    </div>

    <script>
      import { initializeImageActions } from "../scripts/image-actions";

      const cards = [...document.querySelectorAll(".gallery-card")];
      const categoryButtons = [...document.querySelectorAll(".category-chip[data-category]")];
      const peopleFilter = document.querySelector("#people-filter");
      const styleFilter = document.querySelector("#style-filter");
      const avatarSetFilter = document.querySelector("#avatar-set-filter");
      const resultCount = document.querySelector("#result-count");
      const filterShare = document.querySelector(".gallery-filter-share");
      const emptyState = document.querySelector("#gallery-empty");
      const dialog = document.querySelector("#gallery-dialog");
      const detailImage = document.querySelector("#detail-image");
      const detailTitle = document.querySelector("#detail-title");
      const detailCategory = document.querySelector("#detail-category");
      const detailPeople = document.querySelector("#detail-people");
      const detailDate = document.querySelector("#detail-date");
      const detailStyle = document.querySelector("#detail-style");
      const detailStyleRow = document.querySelector("#detail-style-row");
      const detailAvatarSet = document.querySelector("#detail-avatar-set");
      const detailAvatarSetRow = document.querySelector("#detail-avatar-set-row");
      const detailOriginal = document.querySelector("#detail-original");
      const detailShare = document.querySelector("#detail-share");
      const detailDownload = document.querySelector("#detail-download");
      const detailPosition = document.querySelector("#detail-position");
      const previousButton = document.querySelector("#detail-previous");
      const nextButton = document.querySelector("#detail-next");
      let selectedCategory = "all";
      let visibleCards = cards;
      let currentIndex = 0;

      function buildGalleryUrl(hash = "") {
        const url = new URL("/drachenhalle/galerie/", window.location.origin);

        if (selectedCategory !== "all") url.searchParams.set("kategorie", selectedCategory);
        if (peopleFilter.value !== "all") url.searchParams.set("person", peopleFilter.value);
        if (styleFilter.value !== "all") url.searchParams.set("stil", styleFilter.value);
        if (avatarSetFilter.value !== "all") url.searchParams.set("serie", avatarSetFilter.value);
        url.hash = hash;

        return `${url.pathname}${url.search}${url.hash}`;
      }

      function updateCategoryButtons() {
        categoryButtons.forEach((button) => {
          const selected = button.dataset.category === selectedCategory;
          button.classList.toggle("is-selected", selected);
          button.setAttribute("aria-pressed", String(selected));
        });
      }

      function updateShareTargets(updateAddress = false) {
        filterShare.dataset.shareUrl = buildGalleryUrl();

        cards.forEach((card) => {
          const pageUrl = buildGalleryUrl(`#${card.id}`);
          card.dataset.pageUrl = pageUrl;
          const shareButton = card.querySelector("[data-share-image]");
          if (shareButton instanceof HTMLButtonElement) shareButton.dataset.shareUrl = pageUrl;
        });

        const activeCard = visibleCards[currentIndex];
        if (dialog.open && activeCard) detailShare.dataset.shareUrl = activeCard.dataset.pageUrl;

        if (updateAddress) {
          const linkedCard = window.location.hash.startsWith("#bild-")
            ? document.getElementById(window.location.hash.slice(1))
            : null;
          const hash = linkedCard && visibleCards.includes(linkedCard) ? window.location.hash : "";
          history.replaceState(null, "", buildGalleryUrl(hash));
        }
      }

      function applyFilters({ updateAddress = false } = {}) {
        const selectedPerson = peopleFilter.value;
        const selectedStyle = styleFilter.value;
        visibleCards = cards.filter((card) => {
          const categoryMatches = selectedCategory === "all" || card.dataset.category === selectedCategory;
          const people = (card.dataset.people ?? "").split("|").filter(Boolean);
          const personMatches = selectedPerson === "all" || people.includes(selectedPerson);
          const styleMatches = selectedStyle === "all" || card.dataset.style === selectedStyle;
          const avatarSetMatches = avatarSetFilter.value === "all" || card.dataset.avatarSet === avatarSetFilter.value;
          const visible = categoryMatches && personMatches && styleMatches && avatarSetMatches;
          card.hidden = !visible;
          return visible;
        });

        resultCount.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? "Bild" : "Bilder"}`;
        emptyState.hidden = visibleCards.length !== 0;
        updateShareTargets(updateAddress);
      }

      function showCard(card) {
        currentIndex = visibleCards.indexOf(card);
        detailImage.src = card.dataset.web;
        detailImage.alt = card.dataset.title;
        detailTitle.textContent = card.dataset.title;
        detailCategory.textContent = card.dataset.category;
        detailPeople.textContent = card.dataset.people ? card.dataset.people.split("|").join(" · ") : "DIE";
        detailDate.textContent = card.dataset.dateLabel;
        const hasStyle = Boolean(card.dataset.style);
        detailStyleRow.hidden = !hasStyle;
        detailStyle.textContent = hasStyle ? `${card.dataset.style} – ${card.dataset.styleLabel}` : "";
        const hasAvatarSet = Boolean(card.dataset.avatarSet);
        detailAvatarSetRow.hidden = !hasAvatarSet;
        detailAvatarSet.textContent = hasAvatarSet
          ? `${card.dataset.avatarSetLabel} · ${card.dataset.avatarSetStatus}`
          : "";
        detailOriginal.href = card.dataset.original;
        detailShare.dataset.shareUrl = card.dataset.pageUrl;
        detailDownload.dataset.originalUrl = card.dataset.originalImage;
        detailDownload.dataset.fileName = card.dataset.originalName;
        detailDownload.dataset.mimeType = card.dataset.originalMime;
        detailPosition.textContent = `${currentIndex + 1} / ${visibleCards.length}`;
        previousButton.disabled = visibleCards.length < 2;
        nextButton.disabled = visibleCards.length < 2;

        if (!dialog.open) {
          dialog.showModal();
          document.documentElement.classList.add("dialog-open");
        }

        history.replaceState(null, "", card.dataset.pageUrl);
      }

      categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectedCategory = button.dataset.category;
          updateCategoryButtons();
          applyFilters({ updateAddress: true });
        });
      });

      peopleFilter.addEventListener("change", () => applyFilters({ updateAddress: true }));
      styleFilter.addEventListener("change", () => applyFilters({ updateAddress: true }));
      avatarSetFilter.addEventListener("change", () => applyFilters({ updateAddress: true }));
      cards.forEach((card) => {
        card.querySelector(".gallery-open").addEventListener("click", () => showCard(card));
      });

      const initialParams = new URLSearchParams(window.location.search);
      const initialCategory = initialParams.get("kategorie");
      const initialPerson = initialParams.get("person");
      const initialStyle = initialParams.get("stil");
      const initialAvatarSet = initialParams.get("serie");

      if (initialCategory && categoryButtons.some((button) => button.dataset.category === initialCategory)) {
        selectedCategory = initialCategory;
      }
      if (initialPerson && [...peopleFilter.options].some((option) => option.value === initialPerson)) {
        peopleFilter.value = initialPerson;
      }
      if (initialStyle && [...styleFilter.options].some((option) => option.value === initialStyle)) {
        styleFilter.value = initialStyle;
      }
      if (initialAvatarSet && [...avatarSetFilter.options].some((option) => option.value === initialAvatarSet)) {
        avatarSetFilter.value = initialAvatarSet;
      }

      updateCategoryButtons();
      applyFilters({ updateAddress: true });
      initializeImageActions();

      const linkedCard = window.location.hash.startsWith("#bild-")
        ? document.getElementById(window.location.hash.slice(1))
        : null;
      if (linkedCard?.classList.contains("gallery-card") && visibleCards.includes(linkedCard)) showCard(linkedCard);

      previousButton.addEventListener("click", () => {
        currentIndex = (currentIndex - 1 + visibleCards.length) % visibleCards.length;
        showCard(visibleCards[currentIndex]);
      });

      nextButton.addEventListener("click", () => {
        currentIndex = (currentIndex + 1) % visibleCards.length;
        showCard(visibleCards[currentIndex]);
      });

      document.querySelector("[data-dialog-close]").addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        document.documentElement.classList.remove("dialog-open");
        detailImage.removeAttribute("src");
        history.replaceState(null, "", buildGalleryUrl());
      });

      dialog.addEventListener("keydown", (event) => {
        if (visibleCards.length < 2) return;

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          previousButton.click();
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          nextButton.click();
        }
      });
    </script>
  </body>
</html>
