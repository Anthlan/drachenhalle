---
import "../../styles/global.css";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ImageActionIcon from "../../components/ImageActionIcon.astro";
import docsData from "../../data/docs.generated.json";
import galleryData from "../../data/gallery.generated.json";

export function getStaticPaths() {
  return docsData.items.map((document) => ({
    params: { slug: document.slug },
    props: { document },
  }));
}

const { document } = Astro.props;
const publicDocuments = docsData.items.filter((item) => !item.hidden);
const topLevelSectionDocuments = publicDocuments.filter(
  (item) => item.section === document.section && !item.parentSlug,
);
const activeCollectionSlug = document.parentSlug ?? document.slug;
const childDocuments = publicDocuments.filter(
  (item) => item.parentSlug === activeCollectionSlug && item.section === document.section,
);
const sectionDocuments = topLevelSectionDocuments.flatMap((item) =>
  item.slug === activeCollectionSlug ? [item, ...childDocuments] : [item],
);
const activeSection = document.section === "Tutorials"
  ? "tutorials"
  : document.section === "Allianz"
    ? "alliance"
    : document.section === "Drachenwissen"
      ? "informationen"
      : "";
const overviewUrl = document.hidden
  ? "/drachenhalle/rat/"
  : document.section === "Gestaltung"
    ? "/drachenhalle/docs/styleguides/"
    : document.section === "Tutorials"
      ? "/drachenhalle/docs/tutorials/"
      : document.section === "Allianz"
        ? "/drachenhalle/docs/allianz/"
        : "/drachenhalle/docs/";
const overviewLabel = document.hidden
  ? "Allianzrat"
  : document.section === "Gestaltung"
    ? "Styleguides"
    : document.section;
const tipArtOptions = ["Anleitung", "Strategie", "Optimierung"];
const tipTopicOptions = ["Allianz", "Events", "Kampf", "Truppen", "Aufbau", "Weltkarte"];
const isTipsOverview = document.slug === "tipps" && childDocuments.length > 0;
const isEventsOverview = document.slug === "events" && childDocuments.length > 0;
const isEventAnnouncementsOverview = document.slug === "eventankuendigungen" && childDocuments.length > 0;
const isAllianceOverview = document.slug === "allianz" && childDocuments.length > 0;
const isTutorialOverview = document.slug === "tutorials" && childDocuments.length > 0;
const isCuratedHubOverview = isAllianceOverview || isTutorialOverview;
const isBriefKnowledgeArticle = ["tip", "event"].includes(document.kind);
const isOnboarding = document.kind === "onboarding";
const isOfficerRoster = document.kind === "officers";
const isResponsibilities = document.kind === "responsibilities";
const isAllianceDocument = document.section === "Allianz";
const isHealingTip = document.slug === "tipp-08-soldaten-schneller-heilen";
const hasShareableArticle = document.hidden || isBriefKnowledgeArticle || isOnboarding || isAllianceDocument || document.kind === "alliance";
const tutorialStorageKey = document.tutorialStorageKey ?? `die-${document.slug}-step-v1`;
const tutorialProgressLabel = document.tutorialProgressLabel ?? "Fortschritt im Einstieg";
const tutorialNavLabel = document.tutorialNavLabel ?? "Schritte des Einstiegs";
const tutorialCompleteLabel = document.tutorialCompleteLabel ?? "Einstieg abschließen ✦";
const tutorialCompletionTitle = document.tutorialCompletionTitle ?? "Willkommen in der Drachenhalle!";
const tutorialCompletionText = document.tutorialCompletionText ?? "Du hast den Einstieg erfolgreich abgeschlossen.";
const tutorialCharacters = document.tutorialCharacters ?? [
  {
    position: "left",
    src: "/drachenhalle/brand/tutorial-chibi-davinci1986.webp",
    alt: "DaVinci1986 als Chibi-Figur, zwinkernd und mit einladender Geste",
  },
  {
    position: "right",
    src: "/drachenhalle/brand/tutorial-chibi-anthlan.webp",
    alt: "Anthlan als Chibi-Figur, zwinkernd und mit Daumen nach oben",
  },
];

const latestPersonImage = (category, person) => galleryData.items
  .filter((item) => item.category === category && item.people?.some((name) => name.toLowerCase() === person.toLowerCase()))
  .sort((left, right) => `${right.date ?? ""} ${right.time ?? ""}`.localeCompare(`${left.date ?? ""} ${left.time ?? ""}`))[0]
  ?.webUrl ?? null;

const officerProfiles = [
  {
    id: "mysteryz",
    name: "mysteryZ",
    subtitle: "R4 · Vize",
    description: "Vertritt Anthlan bei Bedarf und unterstützt die Führung bei übergreifenden Fragen und diplomatischen Themen.",
    imageUrl: latestPersonImage("Charaktermodell", "mysteryZ"),
  },
  {
    id: "somea",
    name: "Somea",
    subtitle: "R4",
    description: "Ist eine zentrale Anlaufstelle für Gemeinschaft, Mitgliederverwaltung und ein gutes Miteinander.",
    imageUrl: latestPersonImage("Charaktermodell", "Somea"),
  },
  {
    id: "davinci1986",
    name: "DaVinci1986",
    subtitle: "R4",
    description: "Begleitet die Aufnahme neuer Mitglieder und unterstützt zusätzlich die Organisation unseres Güterzugs.",
    imageUrl: latestPersonImage("Charaktermodell", "DaVinci1986"),
  },
  {
    id: "drachenherz",
    name: "Drachenherz",
    subtitle: "R4",
    description: "Unterstützt die Kampf- und Eventkoordination, insbesondere bei PvP-Ereignissen und gemeinsamen Angriffen.",
    imageUrl: latestPersonImage("Charaktermodell", "Drachenherz"),
  },
  {
    id: "helltrain",
    name: "Helltrain",
    subtitle: "R4",
    description: "Kümmert sich um die Vorbereitung und Koordination des Allianz-Hinterhalts.",
    imageUrl: latestPersonImage("Charaktermodell", "Helltrain"),
  },
  {
    id: "thor63",
    name: "Thor63",
    subtitle: "R4 · neu im Offiziersteam",
    description: "Verstärkt neu unser Offiziersteam. Ein fester Verantwortungsbereich ist derzeit noch nicht zugeordnet.",
    imageUrl: latestPersonImage("Charaktermodell", "Thor63"),
  },
];

const responsibilityPlayers = [
  {
    id: "mysteryz",
    name: "mysteryZ",
    imageUrl: latestPersonImage("Avatar", "mysteryZ"),
  },
  {
    id: "somea",
    name: "Somea",
    imageUrl: latestPersonImage("Avatar", "Somea"),
  },
  {
    id: "davinci1986",
    name: "DaVinci1986",
    imageUrl: latestPersonImage("Avatar", "DaVinci1986"),
  },
  {
    id: "drachenherz",
    name: "Drachenherz",
    imageUrl: latestPersonImage("Avatar", "Drachenherz"),
  },
  {
    id: "helltrain",
    name: "Helltrain",
    imageUrl: latestPersonImage("Avatar", "Helltrain"),
  },
  {
    id: "thor63",
    name: "Thor63",
    imageUrl: latestPersonImage("Avatar", "Thor63"),
    available: false,
  },
  {
    id: "anthlan",
    name: "Anthlan",
    imageUrl: latestPersonImage("Avatar", "Anthlan"),
  },
];

const responsibilities = [
  {
    id: "butler",
    icon: "🛡️",
    title: "Butler und Vize",
    officerId: "mysteryz",
    officerLabel: "mysteryZ",
    description: "Vertretung von Anthlan, übergreifende Entscheidungen und diplomatische Absprachen.",
  },
  {
    id: "goettin",
    icon: "👑",
    title: "Göttin",
    officerId: "somea",
    officerLabel: "Somea",
    description: "Gemeinschaft, Mitgliederverwaltung, Sorgen, Fairness und unser Miteinander.",
  },
  {
    id: "rekrutierer",
    icon: "📣",
    title: "Rekrutierer",
    officerId: "davinci1986",
    officerLabel: "DaVinci1986",
    description: "Interessenten, Aufnahme und Begleitung neuer Mitglieder.",
  },
  {
    id: "zugbeauftragter",
    icon: "🚂",
    title: "Zugbeauftragter",
    officerId: "davinci1986",
    officerLabel: "DaVinci1986",
    description: "Organisation des Güterzugs und Auswahl eines Begleitoffiziers.",
  },
  {
    id: "kriegsherr",
    icon: "⚔️",
    title: "Kriegsherr",
    officerId: "drachenherz",
    officerLabel: "Drachenherz",
    description: "PvP-Events, Pandora, Sammelangriffe und übergreifende Kampfkoordination.",
  },
  {
    id: "hinterhalt",
    icon: "🏰",
    title: "Hinterhaltsbeauftragter",
    officerId: "helltrain",
    officerLabel: "Helltrain",
    description: "Planung und Koordination des Allianz-Hinterhalts.",
  },
  {
    id: "forschung",
    icon: "🔬",
    title: "Forschungsdirektor",
    officerId: "anthlan",
    officerLabel: "Offen · derzeit Anthlan",
    description: "Allianzforschung, priorisierte Forschungsziele und Führungsstern.",
  },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={document.summary} />
    {document.hidden && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>{document.title} · DIE Drachenhalle</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active={activeSection} />

      <main class="document-main" id="main-content">
        <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
          <a href="/drachenhalle/">Start</a>
          {document.url !== overviewUrl && (
            <>
              <span aria-hidden="true">/</span>
              <a href={overviewUrl}>{overviewLabel}</a>
            </>
          )}
          <span aria-hidden="true">/</span>
          <span aria-current="page">{document.title}</span>
        </nav>

        <div class:list={["document-layout", { "is-knowledge-page": document.imageUrl, "is-hidden-document": document.hidden, "is-hub-overview": isCuratedHubOverview }]}>
          {!document.hidden && !isCuratedHubOverview && <aside class="document-sidebar">
            <p class="eyebrow">{document.section}</p>
            <a class="docs-overview-link" href={overviewUrl}>← {overviewLabel}</a>
            {sectionDocuments.length > 0 && (
              <nav class="document-section-nav" aria-label={`Weitere Dokumente aus ${document.section}`}>
                <span>In diesem Bereich</span>
                {sectionDocuments.map((item) => (
                  <a
                    class:list={[{ "is-current": item.slug === document.slug, "is-child": item.parentSlug }]}
                    href={item.url}
                    aria-current={item.slug === document.slug ? "page" : undefined}
                  >
                    {item.title}
                  </a>
                ))}
              </nav>
            )}
            {sectionDocuments.length > 0 && (
              <details class="document-mobile-nav">
                <summary>
                  <span>In diesem Bereich</span>
                  <strong>{document.title}</strong>
                </summary>
                <nav aria-label={`Dokumente aus ${document.section}`}>
                  {sectionDocuments.map((item) => (
                    <a
                      class:list={[{ "is-current": item.slug === document.slug, "is-child": item.parentSlug }]}
                      href={item.url}
                      aria-current={item.slug === document.slug ? "page" : undefined}
                    >
                      {item.title}
                    </a>
                  ))}
                </nav>
              </details>
            )}
          </aside>}

          <article class:list={["document-article", { "is-hidden-consultation": document.hidden, "is-onboarding-document": isOnboarding, "is-officer-document": isOfficerRoster, "is-responsibility-document": isResponsibilities, "is-hub-overview": isCuratedHubOverview }]}>
            <header>
              <div class="document-title-row">
                <div class="document-title-copy">
                  <p class="eyebrow">{document.section}</p>
                  <h1>{document.title}</h1>
                </div>
                {hasShareableArticle && (
                  <button
                    type="button"
                    class="tip-article-share"
                    data-share-page
                    data-share-url={document.url}
                    aria-label={`Artikel ${document.title} teilen`}
                    title="Artikel teilen"
                  >
                    <ImageActionIcon type="share" />
                  </button>
                )}
              </div>
              {!document.hidden && <p>{document.summary}</p>}
              {document.kind === "tip" && (
                <dl class="tip-taxonomy tip-taxonomy-detail" aria-label="Einordnung des Tipps">
                  <div>
                    <dt>Art</dt>
                    <dd>{document.artTags.map((tag) => <span class="tip-tag is-art">{tag}</span>)}</dd>
                  </div>
                  <div>
                    <dt>Thema</dt>
                    <dd>{document.topicTags.map((tag) => <span class="tip-tag is-topic">{tag}</span>)}</dd>
                  </div>
                </dl>
              )}
              {isHealingTip && (
                <a class="document-tool-link" href="/drachenhalle/tools/heilrechner/">
                  <span aria-hidden="true">✚</span>
                  Persönlichen Heilblock berechnen →
                </a>
              )}
          {!document.hidden && !["Drachenwissen", "Allianz", "Tutorials"].includes(document.section) && (
            <div class="document-header-actions">
              <a href={document.repositoryUrl} target="_blank" rel="noopener noreferrer">
                Markdown auf GitHub öffnen <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
            </header>
            {isTipsOverview && (
              <section class="knowledge-children tip-catalog" aria-labelledby="knowledge-children-title" data-tip-catalog>
                <div class="tip-catalog-heading">
                  <p class="eyebrow">Informationsseiten</p>
                  <h2 id="knowledge-children-title">Alle Tipps</h2>
                  <p>Wähle je eine Art und ein Thema. Beide Filter werden miteinander kombiniert.</p>
                </div>

                <form class="tip-filter-panel" aria-label="Tipps filtern">
                  <fieldset>
                    <legend>Art</legend>
                    <div class="tip-filter-options">
                      <label>
                        <input type="radio" name="tip-art" value="all" checked />
                        <span>Alle</span>
                      </label>
                      {tipArtOptions.map((tag) => (
                        <label>
                          <input type="radio" name="tip-art" value={tag} />
                          <span>{tag}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                  <fieldset>
                    <legend>Thema</legend>
                    <div class="tip-filter-options">
                      <label>
                        <input type="radio" name="tip-topic" value="all" checked />
                        <span>Alle</span>
                      </label>
                      {tipTopicOptions.map((tag) => (
                        <label>
                          <input type="radio" name="tip-topic" value={tag} />
                          <span>{tag}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                </form>

                <p class="tip-result-count" aria-live="polite" aria-atomic="true" data-tip-result-count>
                  {childDocuments.length} Tipps
                </p>

                <div class="knowledge-card-list" id="tip-card-list">
                  {childDocuments.map((item) => (
                    <a
                      class="knowledge-card"
                      href={item.url}
                      data-tip-card
                      data-art={item.artTags.join("|")}
                      data-topic={item.topicTags.join("|")}
                    >
                      <div>
                        <span>Drachenwissen · Tipp</span>
                        <h3>{item.title}</h3>
                        <p>{item.summary}</p>
                        <dl class="tip-taxonomy" aria-label={`Tags für ${item.title}`}>
                          <div>
                            <dt>Art</dt>
                            <dd>{item.artTags.map((tag) => <span class="tip-tag is-art">{tag}</span>)}</dd>
                          </div>
                          <div>
                            <dt>Thema</dt>
                            <dd>{item.topicTags.map((tag) => <span class="tip-tag is-topic">{tag}</span>)}</dd>
                          </div>
                        </dl>
                        <strong>Informationsseite öffnen →</strong>
                      </div>
                      {item.imageUrl && <img src={item.imageUrl} alt="" loading="lazy" />}
                    </a>
                  ))}
                </div>
                <div class="tip-filter-empty" hidden data-tip-filter-empty>
                  <strong>Keine Tipps für diese Kombination gefunden.</strong>
                  <span>Wähle eine andere Art oder ein anderes Thema.</span>
                </div>
              </section>
            )}
            {isAllianceOverview && (
              <section class="alliance-hub" aria-labelledby="alliance-children-title">
                <div class="alliance-hub-heading">
                  <p class="eyebrow">Orientierung ohne Umwege</p>
                  <h2 id="alliance-children-title">Was möchtest du nachschlagen?</h2>
                </div>
                <div class="alliance-hub-grid">
                  {childDocuments.map((item, index) => (
                    <a class="alliance-hub-card" href={item.url}>
                      <span class="alliance-hub-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                      <div>
                        <p class="eyebrow">Allianz</p>
                        <h3>{item.title}</h3>
                        <p>{item.summary}</p>
                        <strong>Öffnen →</strong>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )}
            {isTutorialOverview && (
              <section class="knowledge-children alliance-catalog" aria-labelledby="tutorial-children-title">
                <div class="tip-catalog-heading">
                  <p class="eyebrow">Schritt für Schritt</p>
                  <h2 id="tutorial-children-title">Wähle ein Tutorial</h2>
                  <p>Geführte Abläufe für den Einstieg und wiederkehrende Aufgaben im Spiel.</p>
                </div>
                <div class="knowledge-card-list">
                  {childDocuments.map((item) => (
                    <a class="knowledge-card is-onboarding" href={item.url}>
                      <div>
                        <span>Tutorial</span>
                        <h3>{item.title}</h3>
                        <p>{item.summary}</p>
                        <strong>Tutorial starten →</strong>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )}
            {isEventsOverview && (
              <section class="knowledge-children alliance-catalog" aria-labelledby="event-children-title">
                <div class="tip-catalog-heading">
                  <p class="eyebrow">Eventwissen</p>
                  <h2 id="event-children-title">Aktuelle Event-Guides</h2>
                  <p>Kurzfassung, ausführliche Mechanik und eine realistische Empfehlung passend zum eigenen Budget.</p>
                </div>
                <div class="knowledge-card-list">
                  {childDocuments.map((item) => (
                    <a class="knowledge-card" href={item.url}>
                      <div>
                        <span>Drachenwissen · Event</span>
                        <h3>{item.title}</h3>
                        <p>{item.summary}</p>
                        <strong>Event-Guide öffnen →</strong>
                      </div>
                      {item.imageUrl && <img src={item.imageUrl} alt="" loading="lazy" />}
                    </a>
                  ))}
                </div>
              </section>
            )}
            {isEventAnnouncementsOverview && (
              <section class="knowledge-children alliance-catalog" aria-labelledby="event-announcement-children-title">
                <div class="tip-catalog-heading">
                  <p class="eyebrow">Direkt für den Allianzchat</p>
                  <h2 id="event-announcement-children-title">Unsere Eventankündigungen</h2>
                  <p>Kurze Einordnung, passende Grafiken und eine Kopiervorlage für das jeweilige Ereignis.</p>
                </div>
                <div class="knowledge-card-list">
                  {childDocuments.map((item) => (
                    <a class="knowledge-card" href={item.url}>
                      <div>
                        <span>Drachenwissen · Eventankündigung</span>
                        <h3>{item.title}</h3>
                        <p>{item.summary}</p>
                        <strong>Ankündigung öffnen →</strong>
                      </div>
                      {item.imageUrl && <img src={item.imageUrl} alt="" loading="lazy" />}
                    </a>
                  ))}
                </div>
              </section>
            )}
            {isCuratedHubOverview ? null : isOfficerRoster ? (
              <div class="officer-page">
                <section class="officer-page-intro">
                  <p>
                    Unsere Offiziere unterstützen Anthlan bei der Führung und Organisation der Allianz. Die konkreten
                    Aufgaben stehen getrennt unter <a href="/drachenhalle/docs/unsere-verantwortlichkeiten/">Unsere Verantwortlichen</a>.
                  </p>
                  <span>Stand: 29. September 2026</span>
                </section>
                <div class="officer-roster" aria-label="Aktuelle Offiziere der Allianz">
                  {officerProfiles.map((officer) => (
                    <article class:list={["officer-card", { "is-pending": !officer.imageUrl }]}>
                      <div class="officer-portrait">
                        {officer.imageUrl ? (
                          <img src={officer.imageUrl} alt={`Charaktermodell von ${officer.name}`} loading="lazy" />
                        ) : (
                          <div class="officer-portrait-placeholder" aria-label={`Charaktermodell von ${officer.name} folgt`}>
                            <span aria-hidden="true">🐉</span>
                            <strong>Bild folgt</strong>
                          </div>
                        )}
                      </div>
                      <div class="officer-card-copy">
                        <span>{officer.subtitle}</span>
                        <h2>{officer.name}</h2>
                        <p>{officer.description}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ) : isResponsibilities ? (
              <div class="responsibility-page">
                <section class="responsibility-intro">
                  <p>
                    Ordne die Avatare den passenden Verantwortlichkeiten zu. Ein Avatar darf mehrere Aufgaben übernehmen.
                    Wer direkt nachschlagen möchte, kann das Spiel jederzeit auflösen.
                  </p>
                </section>

                <section class="responsibility-game" data-responsibility-game aria-labelledby="responsibility-game-title">
                  <div class="responsibility-game-heading">
                    <div>
                      <p class="eyebrow">Wer kümmert sich worum?</p>
                      <h2 id="responsibility-game-title">Ordne unsere Verantwortlichkeiten zu</h2>
                    </div>
                    <div class="responsibility-game-actions">
                      <button type="button" data-responsibility-reveal>Auflösen</button>
                      <button type="button" data-responsibility-reset>Neu versuchen</button>
                    </div>
                  </div>

                  <p class="responsibility-game-help">
                    Avatar ziehen oder antippen und anschließend einen Sockel auswählen.
                  </p>

                  <div class="responsibility-avatar-bank" aria-label="Offiziere auswählen">
                    {responsibilityPlayers.map((player) => (
                      <button
                        type="button"
                        class:list={["responsibility-avatar", { "is-unassigned": player.available === false }]}
                        draggable={player.available === false ? "false" : "true"}
                        data-responsibility-avatar={player.id}
                        aria-pressed="false"
                        disabled={player.available === false}
                        title={player.available === false ? `${player.name} hat noch keinen festen Bereich` : `${player.name} auswählen`}
                      >
                        <img src={player.imageUrl} alt="" draggable="false" />
                        <span>{player.name}</span>
                        {player.available === false && <small>noch ohne Bereich</small>}
                      </button>
                    ))}
                  </div>

                  <div class="responsibility-sockets" aria-label="Verantwortlichkeiten zuordnen">
                    {responsibilities.map((role) => {
                      const player = responsibilityPlayers.find((item) => item.id === role.officerId);
                      return (
                        <button
                          type="button"
                          class="responsibility-socket"
                          data-responsibility-socket={role.id}
                          data-accepts={role.officerId}
                          aria-label={`${role.title}: Avatar zuordnen`}
                        >
                          <span class="responsibility-role-icon" aria-hidden="true">{role.icon}</span>
                          <span class="responsibility-role-copy">
                            <strong>{role.title}</strong>
                            <small>{role.description}</small>
                          </span>
                          <span class="responsibility-dropzone">
                            <span class="responsibility-drop-placeholder" data-responsibility-placeholder aria-hidden="true">+</span>
                            <span class="responsibility-drop-answer" data-responsibility-answer hidden>
                              <img src={player?.imageUrl} alt="" />
                              <span>{role.officerLabel}</span>
                            </span>
                          </span>
                        </button>
                      );
                    })}
                  </div>

                  <p class="responsibility-game-status" data-responsibility-status role="status" aria-live="polite">
                    Wähle einen Avatar aus und ordne die erste Verantwortung zu.
                  </p>
                </section>

                <section class="responsibility-reference" aria-labelledby="responsibility-reference-title">
                  <div class="tip-catalog-heading">
                    <p class="eyebrow">Ohne Rätsel</p>
                    <h2 id="responsibility-reference-title">Alle Aufgaben auf einen Blick</h2>
                    <p>Die Zuordnung bleibt auch ohne das Spiel vollständig lesbar.</p>
                  </div>
                  <div class="responsibility-reference-grid">
                    {responsibilities.map((role) => (
                      <article>
                        <span aria-hidden="true">{role.icon}</span>
                        <div>
                          <h3>{role.title}</h3>
                          <strong>{role.officerLabel}</strong>
                          <p>{role.description}</p>
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              </div>
            ) : isOnboarding && document.onboardingSteps?.length > 0 ? (
              <div class="tutorial-shell" data-tutorial data-storage-key={tutorialStorageKey}>
                <div class="tutorial-toolbar">
                  <div class="tutorial-progress-copy">
                    <p>
                      Schritt <strong data-tutorial-current>1</strong> von {document.onboardingSteps.length}
                    </p>
                    <div
                      class="tutorial-progress"
                      role="progressbar"
                      aria-label={tutorialProgressLabel}
                      aria-valuemin="1"
                      aria-valuemax={document.onboardingSteps.length}
                      aria-valuenow="1"
                      data-tutorial-progress
                    >
                      <span></span>
                    </div>
                  </div>
                  <button type="button" class="tutorial-reset" data-tutorial-reset>Von vorn beginnen</button>
                </div>

                <nav class="tutorial-step-nav" aria-label={tutorialNavLabel}>
                  <ol>
                    {document.onboardingSteps.map((step, index) => (
                      <li>
                        <button
                          type="button"
                          aria-controls={step.id}
                          aria-pressed={index === 0 ? "true" : "false"}
                          data-tutorial-step-button={index}
                        >
                          <span aria-hidden="true">{index + 1}</span>
                          <strong>{step.title}</strong>
                        </button>
                      </li>
                    ))}
                  </ol>
                </nav>

                <div class="tutorial-step-list">
                  {document.onboardingSteps.map((step, index) => (
                    <section
                      id={step.id}
                      class="tutorial-step"
                      data-tutorial-step={index}
                      aria-label={`Schritt ${index + 1}: ${step.title}`}
                    >
                      <p class="eyebrow">Schritt {index + 1} von {document.onboardingSteps.length}</p>
                      <div class="markdown-content tutorial-step-content" set:html={step.html} />
                    </section>
                  ))}
                </div>

                <div class="tutorial-controls" aria-label="Schrittnavigation">
                  <button type="button" data-tutorial-previous>← Zurück</button>
                  <span aria-live="polite" data-tutorial-position>
                    Schritt 1 von {document.onboardingSteps.length}
                  </span>
                  <button type="button" class="is-primary" data-tutorial-next>Weiter →</button>
                  <button type="button" class="is-primary tutorial-complete-button" data-tutorial-complete hidden>
                    {tutorialCompleteLabel}
                  </button>
                </div>

                <div class="tutorial-celebration" data-tutorial-celebration hidden>
                  <div class="tutorial-celebration-particles" aria-hidden="true">
                    {Array.from({ length: 36 }, (_, index) => <span style={`--particle: ${index}`}></span>)}
                  </div>
                  {tutorialCharacters.map((character) => (
                    <img
                      class:list={[
                        "tutorial-celebration-character",
                        character.position === "left" ? "tutorial-character-davinci" : "tutorial-character-anthlan",
                      ]}
                      src={character.src}
                      width="720"
                      height="1080"
                      loading="lazy"
                      decoding="async"
                      alt={character.alt}
                    />
                  ))}
                  <div class="tutorial-celebration-card" role="status" aria-live="polite" aria-atomic="true">
                    <span class="tutorial-celebration-seal" aria-hidden="true">✓</span>
                    <p class="eyebrow">Geschafft</p>
                    <strong>{tutorialCompletionTitle}</strong>
                    <span>{tutorialCompletionText}</span>
                    <button type="button" data-tutorial-celebration-close>Schließen</button>
                  </div>
                </div>
              </div>
            ) : document.kind === "alliance" && document.allianceArticleHtml && document.allianceCopyHtml ? (
              <div class="alliance-article-body">
                <div class:list={["alliance-main-layout", { "has-aside-image": document.imageUrl }]}>
                  <section class="markdown-content alliance-main-content" set:html={document.allianceArticleHtml} />
                  {document.imageUrl && (
                    <aside class="document-visual" aria-label="Zugehörige Allianz-Grafik">
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        <img src={document.imageUrl} alt={`Grafik zu ${document.title}`} />
                      </a>
                      <p>Passende Grafik zum Teilen im Allianzchat.</p>
                      <div class="document-visual-actions" aria-label="Bildaktionen">
                        <button
                          type="button"
                          class="gallery-action"
                          data-save-image
                          data-original-url={document.imageOriginalUrl}
                          data-file-name={document.imageOriginalName}
                          data-mime-type={document.imageOriginalMimeType}
                          aria-label={`Originalgrafik zu ${document.title} speichern`}
                          title="Original speichern"
                        >
                          <ImageActionIcon type="download" />
                        </button>
                      </div>
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        Originalgrafik auf GitHub öffnen <span aria-hidden="true">↗</span>
                      </a>
                    </aside>
                  )}
                </div>
                <section class="markdown-content alliance-copy" data-copy-section>
                  <button type="button" class="copy-code-button" data-copy-code>Mitteilung kopieren</button>
                  <div set:html={document.allianceCopyHtml} />
                </section>
              </div>
            ) : isBriefKnowledgeArticle && document.hasBriefView ? (
              <div class="tip-viewer" data-tip-viewer>
                <div class="tip-view-switcher" role="group" aria-label="Ansicht des Tipps auswählen">
                  <button
                    type="button"
                    class="is-active"
                    aria-pressed="true"
                    aria-controls="kurz"
                    data-tip-view-button="brief"
                  >
                    Kurz &amp; knapp
                  </button>
                  <button
                    type="button"
                    aria-pressed="false"
                    aria-controls="ausfuehrlich"
                    data-tip-view-button="detail"
                  >
                    Ausführlich
                  </button>
                </div>

                <div class:list={["tip-switch-layout", { "has-aside-image": document.imageUrl }]}>
                  <div class="tip-view-content">
                    <section
                      id="kurz"
                      class="markdown-content tip-view tip-view-brief"
                      data-tip-view="brief"
                      set:html={document.briefHtml}
                    />
                    <section
                      id="ausfuehrlich"
                      class="tip-view tip-view-detail"
                      data-tip-view="detail"
                    >
                      <div class="markdown-content tip-detail-intro" set:html={document.detailIntroHtml} />
                      <div class="markdown-content tip-detail-body" set:html={document.detailBodyHtml} />
                    </section>
                  </div>

                  {document.imageUrl && (
                    <aside class="document-visual tip-shared-visual" aria-label={`Zugehörige ${document.kind === "event" ? "Event" : "Tipp"}-Grafik`}>
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        <img src={document.imageUrl} alt={`Grafik zu ${document.title}`} />
                      </a>
                      <p>Passende Grafik zum Teilen im Allianzchat.</p>
                      <div class="document-visual-actions" aria-label="Bildaktionen">
                        <button
                          type="button"
                          class="gallery-action"
                          data-save-image
                          data-original-url={document.imageOriginalUrl}
                          data-file-name={document.imageOriginalName}
                          data-mime-type={document.imageOriginalMimeType}
                          aria-label={`Originalgrafik zu ${document.title} speichern`}
                          title="Original speichern"
                        >
                          <ImageActionIcon type="download" />
                        </button>
                      </div>
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        Originalgrafik auf GitHub öffnen <span aria-hidden="true">↗</span>
                      </a>
                    </aside>
                  )}
                </div>
              </div>
            ) : document.kind === "tip" && document.introHtml && document.tipHtml && document.copyHtml ? (
              <div class="tip-article-body">
                <section class="markdown-content tip-intro" set:html={document.introHtml} />
                <div class:list={["tip-main-layout", { "has-aside-image": document.imageUrl }]}> 
                  <section class="markdown-content tip-main-content" set:html={document.tipHtml} />
                  {document.imageUrl && (
                    <aside class="document-visual" aria-label="Zugehörige Tipp-Grafik">
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        <img src={document.imageUrl} alt={`Grafik zu ${document.title}`} />
                      </a>
                      <p>Passende Grafik zum Teilen im Allianzchat.</p>
                      <div class="document-visual-actions" aria-label="Bildaktionen">
                        <button
                          type="button"
                          class="gallery-action"
                          data-save-image
                          data-original-url={document.imageOriginalUrl}
                          data-file-name={document.imageOriginalName}
                          data-mime-type={document.imageOriginalMimeType}
                          aria-label={`Originalgrafik zu ${document.title} speichern`}
                          title="Original speichern"
                        >
                          <ImageActionIcon type="download" />
                        </button>
                      </div>
                      <a href={document.imageRepositoryUrl} target="_blank" rel="noopener noreferrer">
                        Originalgrafik auf GitHub öffnen <span aria-hidden="true">↗</span>
                      </a>
                    </aside>
                  )}
                </div>
                <section class="markdown-content tip-copy" set:html={document.copyHtml} />
              </div>
            ) : (
              <div class:list={["markdown-content", { "consultation-content": document.hidden }]} set:html={document.html} />
            )}
          </article>
        </div>
      </main>

      <p class="share-feedback" role="status" aria-live="polite" aria-atomic="true" data-share-feedback></p>

      <SiteFooter />
    </div>

    <script>
      import { initializeImageActions } from "../../scripts/image-actions";

      for (const game of document.querySelectorAll("[data-responsibility-game]")) {
        if (!(game instanceof HTMLElement)) continue;

        const avatars = [...game.querySelectorAll("[data-responsibility-avatar]")];
        const sockets = [...game.querySelectorAll("[data-responsibility-socket]")];
        const status = game.querySelector("[data-responsibility-status]");
        const revealButton = game.querySelector("[data-responsibility-reveal]");
        const resetButton = game.querySelector("[data-responsibility-reset]");
        let selectedOfficer = null;

        const setStatus = (message) => {
          if (status) status.textContent = message;
        };

        const avatarFor = (officerId) => avatars.find(
          (avatar) => avatar instanceof HTMLElement && avatar.dataset.responsibilityAvatar === officerId,
        );

        const selectOfficer = (officerId) => {
          selectedOfficer = officerId;
          for (const avatar of avatars) {
            if (!(avatar instanceof HTMLElement)) continue;
            const isSelected = avatar.dataset.responsibilityAvatar === officerId;
            avatar.classList.toggle("is-selected", isSelected);
            avatar.setAttribute("aria-pressed", String(isSelected));
          }

          const avatar = avatarFor(officerId);
          const name = avatar?.querySelector("span")?.textContent?.trim() ?? "Avatar";
          setStatus(`${name} ausgewählt. Wähle jetzt eine Verantwortung.`);
        };

        const clearSelection = () => {
          selectedOfficer = null;
          for (const avatar of avatars) {
            avatar.classList.remove("is-selected");
            avatar.setAttribute("aria-pressed", "false");
          }
        };

        const solveSocket = (socket, officerId, options = {}) => {
          if (!(socket instanceof HTMLButtonElement) || socket.classList.contains("is-solved")) return false;

          const acceptedOfficer = socket.dataset.accepts;
          const roleName = socket.querySelector(".responsibility-role-copy strong")?.textContent?.trim() ?? "Verantwortung";
          const sourceAvatar = avatarFor(officerId);
          const officerName = sourceAvatar?.querySelector("span")?.textContent?.trim() ?? "Dieser Avatar";

          if (officerId !== acceptedOfficer) {
            socket.classList.add("is-wrong");
            sourceAvatar?.classList.add("is-rejected");
            setStatus(`${officerName} passt nicht zu „${roleName}“. Versuch es noch einmal.`);
            window.setTimeout(() => {
              socket.classList.remove("is-wrong");
              sourceAvatar?.classList.remove("is-rejected");
            }, 620);
            return false;
          }

          const placeholder = socket.querySelector("[data-responsibility-placeholder]");
          const answer = socket.querySelector("[data-responsibility-answer]");
          if (placeholder instanceof HTMLElement) placeholder.hidden = true;
          if (answer instanceof HTMLElement) answer.hidden = false;
          socket.classList.add("is-solved");
          socket.disabled = true;

          const solvedCount = sockets.filter((item) => item.classList.contains("is-solved")).length;
          if (solvedCount === sockets.length) {
            setStatus(options.revealed
              ? "Alle Verantwortlichkeiten sind aufgelöst."
              : "Alles richtig zugeordnet – unsere Verantwortlichkeiten sind vollständig besetzt!");
          } else if (!options.silent) {
            setStatus(`Richtig: ${officerName} gehört zu „${roleName}“.`);
          }

          return true;
        };

        for (const avatar of avatars) {
          if (!(avatar instanceof HTMLButtonElement)) continue;
          const officerId = avatar.dataset.responsibilityAvatar;
          if (!officerId) continue;

          avatar.addEventListener("click", () => selectOfficer(officerId));
          avatar.addEventListener("dragstart", (event) => {
            selectOfficer(officerId);
            event.dataTransfer?.setData("text/plain", officerId);
            if (event.dataTransfer) event.dataTransfer.effectAllowed = "copy";
          });
          avatar.addEventListener("dragend", () => {
            for (const socket of sockets) socket.classList.remove("is-drag-target");
          });
        }

        for (const socket of sockets) {
          if (!(socket instanceof HTMLButtonElement)) continue;

          socket.addEventListener("click", () => {
            if (!selectedOfficer) {
              setStatus("Wähle zuerst oben einen Avatar aus.");
              return;
            }
            solveSocket(socket, selectedOfficer);
          });
          socket.addEventListener("dragover", (event) => {
            if (socket.classList.contains("is-solved")) return;
            event.preventDefault();
            socket.classList.add("is-drag-target");
            if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
          });
          socket.addEventListener("dragleave", () => socket.classList.remove("is-drag-target"));
          socket.addEventListener("drop", (event) => {
            event.preventDefault();
            socket.classList.remove("is-drag-target");
            const officerId = event.dataTransfer?.getData("text/plain") || selectedOfficer;
            if (officerId) solveSocket(socket, officerId);
          });
        }

        revealButton?.addEventListener("click", () => {
          sockets.forEach((socket, index) => {
            if (!(socket instanceof HTMLButtonElement)) return;
            const officerId = socket.dataset.accepts;
            if (officerId) solveSocket(socket, officerId, { silent: index < sockets.length - 1, revealed: true });
          });
          clearSelection();
          setStatus("Alle Verantwortlichkeiten sind aufgelöst.");
        });

        resetButton?.addEventListener("click", () => {
          for (const socket of sockets) {
            if (!(socket instanceof HTMLButtonElement)) continue;
            socket.classList.remove("is-solved", "is-wrong", "is-drag-target");
            socket.disabled = false;
            const placeholder = socket.querySelector("[data-responsibility-placeholder]");
            const answer = socket.querySelector("[data-responsibility-answer]");
            if (placeholder instanceof HTMLElement) placeholder.hidden = false;
            if (answer instanceof HTMLElement) answer.hidden = true;
          }
          clearSelection();
          setStatus("Wähle einen Avatar aus und ordne die erste Verantwortung zu.");
        });
      }

      const tipCatalogs = document.querySelectorAll("[data-tip-catalog]");

      for (const catalog of tipCatalogs) {
        if (!(catalog instanceof HTMLElement)) continue;

        const cards = [...catalog.querySelectorAll("[data-tip-card]")];
        const filterInputs = [...catalog.querySelectorAll('input[type="radio"]')];
        const resultCount = catalog.querySelector("[data-tip-result-count]");
        const emptyState = catalog.querySelector("[data-tip-filter-empty]");

        const selectedValue = (name) => {
          const input = catalog.querySelector(`input[name="${name}"]:checked`);
          return input instanceof HTMLInputElement ? input.value : "all";
        };

        const applyTipFilters = () => {
          const selectedArt = selectedValue("tip-art");
          const selectedTopic = selectedValue("tip-topic");
          let visibleCount = 0;

          for (const card of cards) {
            if (!(card instanceof HTMLElement)) continue;

            const artTags = (card.dataset.art ?? "").split("|").filter(Boolean);
            const topicTags = (card.dataset.topic ?? "").split("|").filter(Boolean);
            const artMatches = selectedArt === "all" || artTags.includes(selectedArt);
            const topicMatches = selectedTopic === "all" || topicTags.includes(selectedTopic);
            const isVisible = artMatches && topicMatches;
            card.hidden = !isVisible;
            if (isVisible) visibleCount += 1;
          }

          if (resultCount) {
            resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? "Tipp" : "Tipps"}`;
          }
          if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount !== 0;
        };

        for (const input of filterInputs) input.addEventListener("change", applyTipFilters);
      }

      const tipViewers = document.querySelectorAll("[data-tip-viewer]");

      for (const viewer of tipViewers) {
        if (!(viewer instanceof HTMLElement)) continue;

        const buttons = [...viewer.querySelectorAll("[data-tip-view-button]")];
        const views = [...viewer.querySelectorAll("[data-tip-view]")];

        const showView = (viewName, updateFragment = false) => {
          const activeView = viewName === "detail" ? "detail" : "brief";
          viewer.dataset.activeView = activeView;

          for (const button of buttons) {
            const isActive = button.getAttribute("data-tip-view-button") === activeView;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", String(isActive));
          }

          for (const view of views) {
            const isActive = view.getAttribute("data-tip-view") === activeView;
            view.classList.toggle("is-active", isActive);
            view.setAttribute("aria-hidden", String(!isActive));
          }

          if (updateFragment) {
            const fragment = activeView === "detail" ? "#ausfuehrlich" : "#kurz";
            history.replaceState(null, "", fragment);
          }
        };

        const viewFromFragment = () => {
          if (window.location.hash === "#kurz") return "brief";
          if (window.location.hash === "#ausfuehrlich") return "detail";

          const target = window.location.hash
            ? document.getElementById(decodeURIComponent(window.location.hash.slice(1)))
            : null;
          return target?.closest('[data-tip-view="detail"]') ? "detail" : "brief";
        };

        viewer.classList.add("is-enhanced");
        showView(viewFromFragment());

        for (const button of buttons) {
          button.addEventListener("click", () => {
            showView(button.getAttribute("data-tip-view-button") ?? "brief", true);
          });
        }

        window.addEventListener("hashchange", () => {
          const activeView = viewFromFragment();
          showView(activeView);
          const target = window.location.hash
            ? document.getElementById(decodeURIComponent(window.location.hash.slice(1)))
            : null;
          if (target && window.location.hash !== "#kurz" && window.location.hash !== "#ausfuehrlich") {
            requestAnimationFrame(() => target.scrollIntoView());
          }
        });
      }

      for (const tutorial of document.querySelectorAll("[data-tutorial]")) {
        if (!(tutorial instanceof HTMLElement)) continue;

        const steps = [...tutorial.querySelectorAll("[data-tutorial-step]")];
        const stepButtons = [...tutorial.querySelectorAll("[data-tutorial-step-button]")];
        const previousButton = tutorial.querySelector("[data-tutorial-previous]");
        const nextButton = tutorial.querySelector("[data-tutorial-next]");
        const completeButton = tutorial.querySelector("[data-tutorial-complete]");
        const resetButton = tutorial.querySelector("[data-tutorial-reset]");
        const celebration = tutorial.querySelector("[data-tutorial-celebration]");
        const celebrationClose = tutorial.querySelector("[data-tutorial-celebration-close]");
        const currentLabel = tutorial.querySelector("[data-tutorial-current]");
        const positionLabel = tutorial.querySelector("[data-tutorial-position]");
        const progress = tutorial.querySelector("[data-tutorial-progress]");
        const progressBar = progress?.querySelector("span");
        const storageKey = tutorial.dataset.storageKey ?? "die-tutorial-step";
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let celebrationTimeout: number | undefined;

        if (steps.length === 0) continue;

        const readSavedStep = () => {
          try {
            const value = Number.parseInt(localStorage.getItem(storageKey) ?? "", 10);
            return Number.isInteger(value) ? value : 0;
          } catch {
            return 0;
          }
        };

        const stepFromFragment = () => {
          if (!window.location.hash) return null;
          const fragment = decodeURIComponent(window.location.hash.slice(1));
          const index = steps.findIndex((step) => step.id === fragment || step.querySelector(`#${CSS.escape(fragment)}`));
          return index >= 0 ? index : null;
        };

        let activeIndex = Math.min(Math.max(stepFromFragment() ?? readSavedStep(), 0), steps.length - 1);

        const showStep = (requestedIndex, { updateFragment = false, focusContent = false } = {}) => {
          activeIndex = Math.min(Math.max(requestedIndex, 0), steps.length - 1);

          for (const [index, step] of steps.entries()) {
            const isActive = index === activeIndex;
            if (step instanceof HTMLElement) {
              step.hidden = !isActive;
              step.classList.toggle("is-active", isActive);
            }
          }

          for (const [index, button] of stepButtons.entries()) {
            const isActive = index === activeIndex;
            button.classList.toggle("is-active", isActive);
            button.classList.toggle("is-complete", index < activeIndex);
            button.setAttribute("aria-pressed", String(isActive));
            if (isActive) button.setAttribute("aria-current", "step");
            else button.removeAttribute("aria-current");
          }

          if (previousButton instanceof HTMLButtonElement) previousButton.disabled = activeIndex === 0;
          if (nextButton instanceof HTMLButtonElement) nextButton.hidden = activeIndex === steps.length - 1;
          if (completeButton instanceof HTMLButtonElement) completeButton.hidden = activeIndex !== steps.length - 1;
          if (currentLabel) currentLabel.textContent = String(activeIndex + 1);
          if (positionLabel) positionLabel.textContent = `Schritt ${activeIndex + 1} von ${steps.length}`;
          if (progress) {
            progress.setAttribute("aria-valuenow", String(activeIndex + 1));
            progress.setAttribute("aria-valuetext", `Schritt ${activeIndex + 1} von ${steps.length}`);
          }
          if (progressBar instanceof HTMLElement) {
            progressBar.style.width = `${((activeIndex + 1) / steps.length) * 100}%`;
          }

          try {
            localStorage.setItem(storageKey, String(activeIndex));
          } catch {
            // Der Einstieg funktioniert auch, wenn lokale Speicherung blockiert ist.
          }

          const activeStep = steps[activeIndex];
          if (updateFragment && activeStep?.id) history.replaceState(null, "", `#${activeStep.id}`);

          if (focusContent && activeStep instanceof HTMLElement) {
            const heading = activeStep.querySelector("h2");
            if (heading instanceof HTMLElement) {
              heading.tabIndex = -1;
              heading.focus({ preventScroll: true });
            }
          }
        };

        const hideCelebration = () => {
          window.clearTimeout(celebrationTimeout);
          if (!(celebration instanceof HTMLElement)) return;
          celebration.classList.remove("is-visible");
          window.setTimeout(() => {
            celebration.hidden = true;
          }, prefersReducedMotion.matches ? 0 : 220);
        };

        const showCelebration = () => {
          if (!(celebration instanceof HTMLElement)) return;
          window.clearTimeout(celebrationTimeout);
          celebration.hidden = false;
          requestAnimationFrame(() => celebration.classList.add("is-visible"));
          tutorial.classList.add("is-complete");
          for (const button of stepButtons) button.classList.add("is-complete");
          try {
            localStorage.setItem(`${storageKey}-complete`, "true");
          } catch {
            // Der Abschluss funktioniert auch, wenn lokale Speicherung blockiert ist.
          }
          celebrationTimeout = window.setTimeout(hideCelebration, 5200);
        };

        tutorial.classList.add("is-enhanced");
        showStep(activeIndex);

        for (const [index, button] of stepButtons.entries()) {
          button.addEventListener("click", () => showStep(index, { updateFragment: true, focusContent: true }));
        }
        previousButton?.addEventListener("click", () => showStep(activeIndex - 1, { updateFragment: true, focusContent: true }));
        nextButton?.addEventListener("click", () => showStep(activeIndex + 1, { updateFragment: true, focusContent: true }));
        completeButton?.addEventListener("click", showCelebration);
        celebrationClose?.addEventListener("click", hideCelebration);
        resetButton?.addEventListener("click", () => {
          hideCelebration();
          tutorial.classList.remove("is-complete");
          try {
            localStorage.removeItem(`${storageKey}-complete`);
          } catch {
            // Der Neustart funktioniert auch ohne lokale Speicherung.
          }
          showStep(0, { updateFragment: true, focusContent: true });
        });

        window.addEventListener("hashchange", () => {
          const fragmentStep = stepFromFragment();
          if (fragmentStep !== null) showStep(fragmentStep, { focusContent: true });
        });
      }

      initializeImageActions();

      for (const button of document.querySelectorAll("[data-copy-code]")) {
        button.addEventListener("click", async () => {
          if (!(button instanceof HTMLButtonElement)) return;
          const section = button.closest("[data-copy-section]");
          const code = section?.querySelector("pre code");
          const copyText = code?.textContent ?? "";
          if (!copyText) return;

          try {
            await navigator.clipboard.writeText(copyText);
            button.textContent = "Kopiert!";
          } catch {
            const textarea = document.createElement("textarea");
            textarea.value = copyText;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.append(textarea);
            textarea.select();
            document.execCommand("copy");
            textarea.remove();
            button.textContent = "Kopiert!";
          }

          window.setTimeout(() => {
            button.textContent = "Mitteilung kopieren";
          }, 1800);
        });
      }
    </script>
  </body>
</html>
