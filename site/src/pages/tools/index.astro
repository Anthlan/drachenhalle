---
import SocialMeta from "../../components/SocialMeta.astro";
import "../../styles/global.css";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Interaktive Planungshilfen der DIE Drachenhalle." />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Tools · DIE Drachenhalle</title>
  <SocialMeta title={`Tools · DIE Drachenhalle`} description="Interaktive Planungshilfen der DIE Drachenhalle." />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="tools" />
      <main class="tool-main" id="main-content">
        <header class="tools-overview-hero">
          <p class="eyebrow">Praktisch, schnell und ein bisschen verspielt</p>
          <h1>Tools der Drachenhalle</h1>
          <p>Kleine Planungshilfen für wiederkehrende Entscheidungen im Allianzalltag.</p>
        </header>
        <section class="tools-overview-grid" aria-label="Verfügbare Tools">
          <a href="/drachenhalle/tools/wettkampfplaner/">
            <span aria-hidden="true">🎯</span>
            <div><p class="eyebrow">Deine Wettkampfwoche</p><h2>Allianz-Wettkampf-Punkteplaner</h2><p>Wähle ein Tagesmotto, plane mehrere Vorräte und bereite Radar für Montag, Mittwoch und Freitag vor.</p><strong>Tagesplan erstellen →</strong></div>
          </a>
          <a href="/drachenhalle/tools/schildrechner/">
            <span aria-hidden="true">🛡️</span>
            <div>
              <p class="eyebrow">Einsatzbereit</p>
              <h2>Schildplaner</h2>
              <p>Prüft deinen Bestand gegen den nächsten Raubzug und erstellt Kalendererinnerungen.</p>
              <strong>Plan erstellen →</strong>
            </div>
          </a>
          <a href="/drachenhalle/tools/heilrechner/">
            <span aria-hidden="true">🏥</span>
            <div>
              <p class="eyebrow">Einsatzbereit</p>
              <h2>Heilungsplaner</h2>
              <p>Plant einen sicheren Heilblock für deine Truppen und die verfügbare Allianzhilfe.</p>
              <strong>Heilblock planen →</strong>
            </div>
          </a>
          <a href="/drachenhalle/tools/eventrechner/">
            <span aria-hidden="true">✈️</span>
            <div>
              <p class="eyebrow">Aktuelles Flügelevent</p>
              <h2>Flügelevent-Planer</h2>
              <p>Vergleicht Casino-Erwartungswert, Risikokorridor und garantierten Gutschein-Direktkauf.</p>
              <strong>Eventziel planen →</strong>
            </div>
          </a>
        </section>
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
