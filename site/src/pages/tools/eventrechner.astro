---
import "../../styles/global.css";
import ImageActionIcon from "../../components/ImageActionIcon.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";

const shopPages = [
  {
    id: "exklusiv",
    label: "Exklusiv",
    eyebrow: "Tagesangebote & Sammlerstücke",
    image: "/drachenhalle/brand/event-shop/vorratsdepot-exklusiv.png",
    imageAlt: "Ingame-Vorratsdepot mit exklusiven Belohnungen und Tagesangeboten",
    rewards: [
      { id: "ur-splitter", name: "UR-Omni-Heldensplitter", unit: "10 Splitter", price: 60, max: 1, limit: "Heute übrig: 1", x: 10, y: 41 },
      { id: "deluxe-truhe", name: "Optionale Deluxe-Truhe", unit: "1 Truhe", price: 100, max: 1, limit: "Heute übrig: 1", x: 50, y: 41 },
      { id: "vibranium", name: "Vibranium-Verteidigungslinie", unit: "1 Skin", price: 4000, max: 1, limit: "Maximal 1", x: 90, y: 41, premium: true },
      { id: "hologramm", name: "Holografische Dekoration", unit: "1 Dekoration", price: 2000, max: 1, limit: "Maximal 1", x: 10, y: 60 },
      { id: "flugzeug-deko", name: "Flugzeug-Dekoration", unit: "1 Dekoration", price: 2000, max: 1, limit: "Maximal 1", x: 50, y: 60 },
      { id: "avatarrahmen", name: "Event-Avatarrahmen", unit: "1 Rahmen", price: 800, max: 1, limit: "Maximal 1", x: 90, y: 60 },
      { id: "namensschild", name: "Event-Namensschild", unit: "1 Namensschild", price: 200, max: 1, limit: "Maximal 1", x: 10, y: 80 },
      { id: "gebaeudeteil-a", name: "Gebäudeteil A", unit: "1 Teil", price: 100, max: 80, limit: "Maximal 80", x: 50, y: 80 },
      { id: "gebaeudeteil-b", name: "Gebäudeteil B", unit: "1 Teil", price: 100, max: 80, limit: "Maximal 80", x: 90, y: 80 },
    ],
  },
  {
    id: "ausbau",
    label: "Ausbau",
    eyebrow: "Fragmente, Baupläne & Ressourcen",
    image: "/drachenhalle/brand/event-shop/vorratsdepot-ausbau.png",
    imageAlt: "Ingame-Vorratsdepot mit Ausbaugegenständen und Ressourcen",
    rewards: [
      { id: "gebaeudeteil-c", name: "Gebäudeteil C", unit: "1 Teil", price: 40, max: 80, limit: "Maximal 80", x: 10, y: 41 },
      { id: "event-zufallstruhe", name: "Event-Zufallstruhe", unit: "1 Truhe", price: 100, max: 30, limit: "Maximal 30", x: 50, y: 41 },
      { id: "deko-gutscheine", name: "Dekorationsgutscheine", unit: "100 Gutscheine", price: 80, max: 100, limit: "Maximal 100", x: 90, y: 41 },
      { id: "puzzleteil", name: "Goldenes Puzzleteil", unit: "1 Teil", price: 16, max: 300, limit: "Maximal 300", x: 10, y: 60 },
      { id: "bauplan-rot", name: "Roter Bauplan", unit: "1 Bauplan", price: 300, max: 10, limit: "Maximal 10", x: 50, y: 60 },
      { id: "bauplan-gold", name: "Goldener Bauplan", unit: "1 Bauplan", price: 60, max: 100, limit: "Maximal 100", x: 90, y: 60 },
      { id: "ur-truhe", name: "UR-Auswahltruhe", unit: "1 Truhe", price: 300, max: 5, limit: "Maximal 5", x: 10, y: 80 },
      { id: "holz", name: "Holz", unit: "100 Holz", price: 60, max: 200, limit: "Maximal 200", x: 50, y: 80 },
      { id: "fortschrittsbuch", name: "Fortschrittsbücher", unit: "100 Bücher", price: 40, max: 200, limit: "Maximal 200", x: 90, y: 80 },
    ],
  },
  {
    id: "material",
    label: "Material",
    eyebrow: "Beschleuniger & Verbrauchsmaterial",
    image: "/drachenhalle/brand/event-shop/vorratsdepot-material.png",
    imageAlt: "Ingame-Vorratsdepot mit Beschleunigern, Kisten und Verbrauchsmaterial",
    rewards: [
      { id: "beschleuniger-3h", name: "3-Stunden-Beschleuniger", unit: "1 Beschleuniger", price: 16, max: 200, limit: "Maximal 200", x: 10, y: 41 },
      { id: "flugmaterial", name: "Flugmaterial", unit: "10.000 Material", price: 16, max: 100, limit: "Maximal 100", x: 50, y: 41 },
      { id: "fortschrittskiste-a", name: "Fortschrittskiste A", unit: "1 Truhe", price: 8, max: 1000, limit: "Maximal 1.000", x: 90, y: 41 },
      { id: "fortschrittskiste-b", name: "Fortschrittskiste B", unit: "1 Truhe", price: 8, max: 1000, limit: "Maximal 1.000", x: 10, y: 62 },
      { id: "metallspulen", name: "Metallspulen", unit: "100 Spulen", price: 4, max: 1000, limit: "Maximal 1.000", x: 50, y: 62 },
      { id: "handbuecher", name: "Trainingshandbücher", unit: "100 Bücher", price: 4, max: 1000, limit: "Maximal 1.000", x: 90, y: 62 },
      { id: "versorgungskisten", name: "Versorgungskisten", unit: "10 Kisten", price: 40, max: 1000, limit: "Maximal 1.000", x: 10, y: 85 },
    ],
  },
].map((page) => ({
  ...page,
  rewards: page.rewards.map((reward) => ({
    ...reward,
    image: `/drachenhalle/brand/event-shop/items/${reward.id}.webp`,
  })),
}));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Plane Münzen, Vorratsgutscheine und Echtgeldpakete für das aktuelle Flügelevent."
    />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Flügelevent-Planer · Tools · DIE Drachenhalle</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="tools" />

      <main class="tool-main" id="main-content">
        <nav class="tool-breadcrumb" aria-label="Brotkrümelnavigation">
          <a href="/drachenhalle/tools/">Tools</a>
          <span aria-hidden="true">/</span>
          <span>Flügelevent-Planer</span>
        </nav>

        <header class="tool-hero flight-tool-hero">
          <div class="flight-hero-copy">
            <p class="eyebrow">Gefechtsvorbereitung der Flugbesatzung</p>
            <div class="flight-hero-title-line">
              <h1>Flügelevent-Planer</h1>
              <button
                type="button"
                class="tip-article-share tool-share-button"
                data-share-page
                data-flight-share
                data-share-url="/drachenhalle/tools/eventrechner/"
                aria-label="Flügelevent-Planer teilen"
                title="Flügelevent-Planer teilen"
              >
                <ImageActionIcon type="share" />
              </button>
            </div>
            <p>
              Prüfe, was dein Münz- und Gutscheinbestand statistisch wert ist, und vergleiche den
              Casino-Weg mit einem gezielten Nachkauf der erwarteten Restlücke.
            </p>
            <div class="flight-hero-actions">
              <a href="/drachenhalle/docs/event-01-gefechtsvorbereitung-flugbesatzung/">Event-Guide öffnen →</a>
              <button
                class="flight-method-icon"
                type="button"
                data-flight-info-open
                aria-label="Daten und Methodik anzeigen"
                aria-haspopup="dialog"
                aria-controls="flight-info-dialog"
                title="Daten und Methodik"
              >
                <span aria-hidden="true">i</span>
              </button>
            </div>
          </div>
          <div class="flight-hero-character" aria-hidden="true">
            <span class="flight-propeller">✦</span>
            <img
              src="/drachenhalle/brand/tool-flight-anthlan-navigator.webp"
              alt=""
              width="480"
              height="720"
            />
          </div>
          <div class="flight-hero-route" aria-label="Vom Bestand zum Kaufplan">
            <div><span>01</span><strong>Bestand</strong><small>Münzen &amp; Gutscheine</small></div>
            <i aria-hidden="true">→</i>
            <div><span>02</span><strong>Prognose</strong><small>Chance &amp; Streuung</small></div>
            <i aria-hidden="true">→</i>
            <div class="is-result"><span>03</span><strong>Kaufplan</strong><small>Casino oder direkt</small></div>
          </div>
        </header>

        <section class="flight-calculator" data-flight-event-calculator aria-labelledby="flight-form-title">
          <form class="flight-form" data-flight-event-form>
            <div class="flight-form-heading">
              <p class="eyebrow">Deine Ausgangslage</p>
              <h2 id="flight-form-title">Was hast du – und wohin willst du?</h2>
              <p>Der Planer rechnet nur mit Münzen und Vorratsgutscheinen. Hilfsgüter aus dem Versorgungsabwurf bleiben außen vor.</p>
            </div>

            <fieldset>
              <legend>Bestand &amp; Ziel</legend>
              <div class="flight-field-grid is-three">
                <label>
                  <span>Fliegende-Stern-Münzen</span>
                  <input name="currentCoins" type="number" min="0" max="99999" step="1" value="0" inputmode="numeric" />
                </label>
                <label>
                  <span>Vorratsgutscheine</span>
                  <input name="currentVouchers" type="number" min="0" max="99999" step="1" value="0" inputmode="numeric" />
                </label>
                <div class="flight-target-field">
                  <label for="flight-target-vouchers">Gutscheinziel</label>
                  <div class="flight-target-control">
                    <input id="flight-target-vouchers" name="targetVouchers" type="number" min="1" max="999999" step="1" value="4000" inputmode="numeric" />
                    <button
                      type="button"
                      data-flight-target-open
                      aria-label="Vordefiniertes Gutscheinziel auswählen"
                      aria-haspopup="dialog"
                      aria-controls="flight-target-dialog"
                      title="Ziel auswählen"
                    >
                      <span aria-hidden="true">◎</span>
                    </button>
                  </div>
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend>Restlaufzeit</legend>
              <div class="flight-field-grid is-time">
                <label>
                  <span>Noch Tage</span>
                  <input name="remainingDays" type="number" min="0" max="30" step="1" value="3" inputmode="numeric" />
                </label>
                <label>
                  <span>Noch Stunden</span>
                  <input name="remainingHours" type="number" min="0" max="23" step="1" value="0" inputmode="numeric" />
                </label>
                <label>
                  <span>Offene Gutscheine</span>
                  <input name="remainingFreeVouchers" type="number" min="0" max="99" step="1" value="0" inputmode="numeric" />
                </label>
              </div>
              <p class="flight-field-note">Aus der Restlaufzeit werden angefangene tägliche Kaufperioden ermittelt. Prüfe vor dem Kauf trotzdem den Ingame-Timer.</p>
            </fieldset>

            <fieldset>
              <legend>Kaufstrategie</legend>
              <div class="flight-strategy-options" role="radiogroup" aria-label="Reihenfolge für den Kombi-Plan">
                <label>
                  <input name="purchaseStrategy" type="radio" value="casino-first" />
                  <span><strong>Erst Casino, dann Gutscheine</strong><small>Nur so viele Münzpakete wie nötig, danach die verbleibende Lücke sicher schließen.</small></span>
                </label>
                <label>
                  <input name="purchaseStrategy" type="radio" value="voucher-first" />
                  <span><strong>Erst Gutscheine, dann Casino</strong><small>Direktpakete zuerst ausschöpfen und den Rest über Münzen planen.</small></span>
                </label>
                <label>
                  <input name="purchaseStrategy" type="radio" value="cost-optimized" checked />
                  <span><strong>Geldoptimiert</strong><small>Die günstigste verfügbare Kombination für deine gewählte Planungssicherheit.</small></span>
                </label>
              </div>
            </fieldset>

            <fieldset>
              <legend>Planungsannahmen</legend>
              <div class="flight-option-grid">
                <label>
                  <input name="includeFree" type="checkbox" value="yes" checked />
                  <span><strong>Gratis-Münzen einplanen</strong><small>1 Münze je erreichbarer Kaufperiode.</small></span>
                </label>
                <label>
                  <input name="includeDiamonds" type="checkbox" value="yes" />
                  <span><strong>500-Diamanten-Gutschein einplanen</strong><small>1 zusätzlicher Gutschein je Kaufperiode.</small></span>
                </label>
                <div class="flight-task-box-note">
                  <strong>Zusatzbelohnungen nicht eingerechnet</strong>
                  <small>Punkte-Fortschritt und tägliche Aufgaben lassen sich mit den belegten Daten noch nicht verlässlich aus der Münzzahl ableiten.</small>
                </div>
                <label>
                  <span class="flight-select-label"><strong>Gewünschte Planungssicherheit</strong><small>Für die obere Grenze des Casino-Korridors.</small></span>
                  <select name="confidence">
                    <option value="0.8" selected>80 % – realistisch</option>
                    <option value="0.9">90 % – vorsichtig</option>
                    <option value="0.95">95 % – sehr vorsichtig</option>
                  </select>
                </label>
              </div>
            </fieldset>

            <div class="flight-form-footer">
              <div class="tool-memory-actions flight-memory-actions">
                <button type="button" class="tool-memory-button" data-flight-save aria-label="Eventstand speichern" title="Eventstand speichern">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12l2 2v16H5V3Zm3 0v6h8V3M8 21v-8h8v8" /></svg>
                </button>
                <button type="button" class="tool-memory-reset" data-flight-clear hidden aria-label="Gespeicherte Werte löschen" title="Gespeicherte Werte löschen">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 3h6l1 4H8l1-4Zm-2 4 1 14h8l1-14M10 11v6m4-6v6" /></svg>
                </button>
                <p class="tool-memory-status" role="status" aria-live="polite" data-flight-storage-status>Nur auf diesem Gerät gespeichert.</p>
              </div>
              <div class="flight-form-submit-group">
                <p class="tool-error" role="alert" data-flight-event-error hidden></p>
                <button class="tool-primary-button flight-submit" type="submit">Flugplan berechnen →</button>
              </div>
            </div>
          </form>

          <section class="flight-result" data-flight-event-result data-state="concerned" aria-live="polite">
            <div class="flight-result-intro">
              <div>
                <p class="eyebrow" data-flight-result-kicker>Dein Kurs zum Ziel</p>
                <h2 data-flight-result-title>Noch Nachschub einplanen</h2>
                <p data-flight-result-summary></p>
              </div>
              <div class="flight-result-character" aria-hidden="true">
                <img data-flight-character="navigator" src="/drachenhalle/brand/tool-flight-anthlan-navigator.webp" alt="" hidden />
                <img data-flight-character="concerned" src="/drachenhalle/brand/tool-flight-anthlan-concerned.webp" alt="" />
                <img data-flight-character="success" src="/drachenhalle/brand/tool-flight-anthlan-success.webp" alt="" hidden />
              </div>
            </div>

            <div class="flight-result-facts" aria-label="Planungsgrundlage">
              <div><span>Kaufperioden</span><strong data-flight-windows>0</strong></div>
              <div><span>Künftige Gratismünzen</span><strong data-flight-free-coins>0</strong></div>
              <div><span>Künftige Direktgutscheine</span><strong data-flight-free-vouchers>0</strong></div>
            </div>

            <article class="flight-inventory-projection">
              <div class="flight-inventory-copy">
                <p class="eyebrow">Deine Basis ohne Nachkauf</p>
                <h3>Was dein Bestand voraussichtlich erreicht</h3>
                <p class="flight-basis-equation">
                  <span><strong data-flight-current-vouchers>0</strong> vorhandene Gutscheine</span>
                  <b aria-hidden="true">+</b>
                  <span><strong data-flight-coin-expected>0</strong> erwartbar aus Münzen</span>
                  <b aria-hidden="true">=</b>
                  <span class="is-total"><strong data-flight-current-expected>0</strong> erwartbarer Endstand</span>
                </p>
              </div>
              <dl>
                <div><dt>Typischer Korridor</dt><dd data-flight-current-range>0–0</dd></div>
                <div><dt>Zielchance</dt><dd data-flight-current-chance>0 %</dd></div>
                <div><dt>Erwartete Restlücke</dt><dd data-flight-direct-gap>0 Gutscheine</dd></div>
              </dl>
            </article>

            <div class="flight-route-comparison">
              <article class="flight-route-card is-casino">
                <div class="flight-route-icon" aria-hidden="true">🎰</div>
                <p class="eyebrow">Mehr Ertrag, mehr Zufall</p>
                <h3>Casino-Weg</h3>
                <strong class="flight-route-price" data-flight-casino-cost>–</strong>
                <p data-flight-casino-outcome></p>
                <div class="flight-route-meta">
                  <span data-flight-casino-coins></span>
                  <span data-flight-casino-chance></span>
                </div>
                <p class="flight-package-plan" data-flight-casino-plan></p>
              </article>

              <article class="flight-route-card is-direct">
                <div class="flight-route-icon" aria-hidden="true">🎟️</div>
                <p class="eyebrow">Erwartete Restlücke schließen</p>
                <h3>Gutschein-Nachkauf</h3>
                <strong class="flight-route-price" data-flight-direct-cost>–</strong>
                <p data-flight-direct-outcome></p>
                <p class="flight-package-plan" data-flight-direct-plan></p>
                <p class="flight-route-note">Die Rechnung nutzt deinen erwartbaren Münzertrag. Drehe vorhandene Münzen zuerst und kaufe anschließend nur die tatsächlich verbliebene Differenz.</p>
              </article>

              <article class="flight-route-card is-hybrid">
                <div class="flight-route-icon" aria-hidden="true">🧭</div>
                <p class="eyebrow" data-flight-hybrid-kicker>Kombiniert nach deiner Strategie</p>
                <h3>Kombi-Plan</h3>
                <strong class="flight-route-price" data-flight-hybrid-cost>–</strong>
                <p data-flight-hybrid-outcome></p>
                <div class="flight-route-meta">
                  <span data-flight-hybrid-coins></span>
                  <span data-flight-hybrid-vouchers></span>
                </div>
                <div class="flight-hybrid-steps">
                  <p><span>01</span><strong data-flight-hybrid-step-one>–</strong></p>
                  <p><span>02</span><strong data-flight-hybrid-step-two>–</strong></p>
                </div>
              </article>
            </div>

            <aside class="flight-recommendation">
              <span aria-hidden="true">✦</span>
              <div>
                <p class="eyebrow">Anthlans Empfehlung</p>
                <p data-flight-recommendation></p>
              </div>
            </aside>
          </section>
        </section>

        <aside class="flight-tool-disclaimer">
          <strong>Kein Kaufversprechen:</strong>
          Wahrscheinlichkeiten sind keine Garantie. Regionale Preise und Angebotslimits können abweichen. Der Planer verwendet die am 28.09.2026 in Deutschland dokumentierten Ingame-Angebote.
        </aside>

        <dialog class="healing-help-dialog tool-info-dialog flight-info-dialog" id="flight-info-dialog" aria-labelledby="flight-info-title">
          <div class="healing-help-content tool-info-dialog-shell">
            <header class="healing-help-heading tool-info-dialog-header">
              <div>
                <p class="eyebrow">Daten &amp; Methodik</p>
                <h2 id="flight-info-title">So rechnet der Flügelevent-Planer</h2>
              </div>
              <button class="healing-help-close" type="button" aria-label="Information schließen" title="Schließen" data-flight-info-close>×</button>
            </header>

            <section class="flight-info-section">
              <h3>Erwartungswert je Münze</h3>
              <div class="flight-method-grid">
                <article><strong>10,01</strong><span>Grundbelohnung</span><small>5, 50, 250 oder 500 Gutscheine.</small></article>
                <article><strong>2,77</strong><span>Symbolkombinationen</span><small>Direkte Gutschein-Kombinationen.</small></article>
                <article><strong>2,31</strong><span>Spielautomaten-Luftabwurf</span><small>40-%-Gutscheinpool der Truhenziehung.</small></article>
                <article class="is-total"><strong>15,08</strong><span>Gesamt erwartet</span><small>Je eingesetzter Münze, nicht garantiert.</small></article>
              </div>
              <p>Der eigenständige Bereich <strong>Versorgungsabwurf</strong> mit Hilfsgütern bringt weder Münzen noch Vorratsgutscheine und wird ausdrücklich nicht eingerechnet.</p>
            </section>

            <section class="flight-info-section">
              <h3>Paketdaten</h3>
              <div class="flight-package-tables">
                <table>
                  <caption>Münzpakete</caption>
                  <thead><tr><th>Münzen</th><th>Preis</th><th>Limit je Periode</th></tr></thead>
                  <tbody>
                    <tr><td>2</td><td>1,19 €</td><td>1</td></tr><tr><td>4</td><td>2,49 €</td><td>1</td></tr>
                    <tr><td>5</td><td>5,99 €</td><td>1</td></tr><tr><td>10</td><td>11,99 €</td><td>1</td></tr>
                    <tr><td>20</td><td>23,99 €</td><td>1</td></tr><tr><td>50</td><td>59,99 €</td><td>1</td></tr>
                    <tr><td>100</td><td>119,99 €</td><td>20</td></tr>
                  </tbody>
                </table>
                <table>
                  <caption>Direkte Gutscheinpakete</caption>
                  <thead><tr><th>Gutscheine</th><th>Preis</th><th>Limit je Periode</th></tr></thead>
                  <tbody>
                    <tr><td>20</td><td>2,49 €</td><td>1</td></tr><tr><td>40</td><td>5,99 €</td><td>1</td></tr>
                    <tr><td>80</td><td>11,99 €</td><td>1</td></tr><tr><td>160</td><td>23,99 €</td><td>1</td></tr>
                    <tr><td>400</td><td>59,99 €</td><td>1</td></tr><tr><td>800</td><td>119,99 €</td><td>1</td></tr>
                  </tbody>
                </table>
              </div>
            </section>

            <section class="flight-info-section">
              <h3>Wie ist der Korridor zu lesen?</h3>
              <p>Der Rechner verwendet Erwartungswert und statistische Streuung aller dokumentierten Gutschein-Ausgänge. Der gewählte Sicherheitswert erhöht die geplante Münzmenge. Seltene Glückstreffer können trotzdem außerhalb des dargestellten Korridors liegen.</p>
              <p>Die separate Punkte-Fortschrittsleiste zeigt feste Belohnungen von 200 Vorratsgutscheinen bei 300 Punkten und weiteren 200 bei 500 Punkten. Die vorliegenden Bilder belegen jedoch nicht, wie viele Punkte eine Ziehung bringt. Diese 400 Gutscheine werden daher nicht automatisch aus der Münzzahl abgeleitet.</p>
              <p>Zusätzlich enthalten die täglichen zeitbegrenzten Aufgaben Zufallsboxen. Die zwei dokumentierten Gutscheinboxen liefern im Mittel 4 beziehungsweise rund 10,01 Gutscheine. Weil die Anforderungen der späteren Aufgabenstufen verborgen sind, bleiben auch diese Boxen außerhalb der automatischen Planung.</p>
              <a class="flight-info-guide-link" href="/drachenhalle/docs/event-01-gefechtsvorbereitung-flugbesatzung/">Vollständigen Event-Guide lesen →</a>
            </section>
          </div>
        </dialog>

        <dialog class="healing-help-dialog tool-info-dialog flight-target-dialog" id="flight-target-dialog" aria-labelledby="flight-target-title">
          <div class="healing-help-content tool-info-dialog-shell">
            <header class="healing-help-heading tool-info-dialog-header">
              <div>
                <p class="eyebrow">Zielvorgabe</p>
                <h2 id="flight-target-title">Stelle dein Ziel zusammen</h2>
                <p>Wähle deine gewünschten Belohnungen wie im Vorratsdepot. Preis und Kaufmaximum stammen aus den drei dokumentierten Shop-Seiten.</p>
              </div>
              <button class="healing-help-close" type="button" aria-label="Zielauswahl schließen" title="Schließen" data-flight-target-close>×</button>
            </header>

            <div class="flight-shop-tabs" role="tablist" aria-label="Bereiche des Vorratsdepots">
              {shopPages.map((page, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`flight-shop-tab-${page.id}`}
                  aria-controls={`flight-shop-panel-${page.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  data-flight-shop-tab={page.id}
                >
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{page.label}</strong>
                </button>
              ))}
            </div>

            <div class="flight-shop-pages">
              {shopPages.map((page, pageIndex) => (
                <section
                  class="flight-shop-page"
                  id={`flight-shop-panel-${page.id}`}
                  role="tabpanel"
                  aria-labelledby={`flight-shop-tab-${page.id}`}
                  data-flight-shop-panel={page.id}
                  hidden={pageIndex !== 0}
                >
                  <figure class="flight-shop-reference">
                    <img src={page.image} alt={page.imageAlt} width="1170" height="2532" loading="lazy" />
                    <figcaption>
                      <span class="eyebrow">Ingame-Referenz</span>
                      <strong>{page.eyebrow}</strong>
                      <small>Die Auswahl darunter übernimmt Aufbau, Preise und Limits dieser Shop-Seite.</small>
                    </figcaption>
                  </figure>

                  <div class="flight-shop-grid">
                    {page.rewards.map((reward) => (
                      <article class:list={["flight-shop-item", reward.premium && "is-premium"]}>
                        <img
                          class="flight-shop-item-art"
                          src={reward.image}
                          alt=""
                          width="240"
                          height="240"
                          loading="lazy"
                          aria-hidden="true"
                        />
                        <div class="flight-shop-item-copy">
                          <span>{reward.unit}</span>
                          <strong>{reward.name}</strong>
                          <small>{reward.limit}</small>
                        </div>
                        <label>
                          <span>Menge</span>
                          <input
                            type="number"
                            min="0"
                            max={reward.max}
                            step="1"
                            value="0"
                            inputmode="numeric"
                            data-flight-reward-quantity
                            data-reward-id={reward.id}
                            data-price={reward.price}
                            aria-label={`Gewünschte Menge ${reward.name}`}
                          />
                        </label>
                        <p><strong>{reward.price.toLocaleString("de-DE")}</strong><span>Gutscheine je Kauf</span></p>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>

            <footer class="flight-shop-total">
              <div>
                <span>Dein zusammengestelltes Gutscheinziel</span>
                <strong><output data-flight-target-total>0</output> Vorratsgutscheine</strong>
                <small data-flight-target-selection>Noch keine Belohnung ausgewählt.</small>
              </div>
              <div class="flight-shop-total-actions">
                <button type="button" class="tool-memory-reset" data-flight-target-reset>Auswahl leeren</button>
                <button type="button" class="tool-primary-button" data-flight-target-apply disabled>Ziel übernehmen →</button>
              </div>
            </footer>
          </div>
        </dialog>
      </main>

      <SiteFooter />
    </div>

    <p class="share-feedback" role="status" aria-live="polite" aria-atomic="true" data-share-feedback></p>

    <script>
      import { initializeFlightEventCalculator } from "../../scripts/flight-event-calculator";
      import { initializeImageActions } from "../../scripts/image-actions";

      initializeFlightEventCalculator();
      initializeImageActions();

      const dialog = document.querySelector("#flight-info-dialog");
      const openButton = document.querySelector("[data-flight-info-open]");
      const closeButton = document.querySelector("[data-flight-info-close]");
      const targetDialog = document.querySelector("#flight-target-dialog");
      const targetOpenButton = document.querySelector("[data-flight-target-open]");
      const targetCloseButton = document.querySelector("[data-flight-target-close]");
      const targetInput = document.querySelector("input[name='targetVouchers']");
      const flightForm = document.querySelector("[data-flight-event-form]");
      const shopTabs = Array.from(document.querySelectorAll("[data-flight-shop-tab]"));
      const shopPanels = Array.from(document.querySelectorAll("[data-flight-shop-panel]"));
      const rewardInputs = Array.from(document.querySelectorAll("[data-flight-reward-quantity]"));
      const targetTotal = document.querySelector("[data-flight-target-total]");
      const targetSelection = document.querySelector("[data-flight-target-selection]");
      const targetApplyButton = document.querySelector("[data-flight-target-apply]");
      const targetResetButton = document.querySelector("[data-flight-target-reset]");

      if (dialog instanceof HTMLDialogElement) {
        openButton?.addEventListener("click", () => dialog.showModal());
        closeButton?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      }

      if (targetDialog instanceof HTMLDialogElement) {
        const activateShopPage = (pageId: string) => {
          shopTabs.forEach((tab) => {
            if (!(tab instanceof HTMLButtonElement)) return;
            const active = tab.dataset.flightShopTab === pageId;
            tab.setAttribute("aria-selected", active ? "true" : "false");
            tab.tabIndex = active ? 0 : -1;
          });
          shopPanels.forEach((panel) => {
            if (panel instanceof HTMLElement) panel.hidden = panel.dataset.flightShopPanel !== pageId;
          });
        };

        const updateTargetTotal = () => {
          let total = 0;
          let selectedRewards = 0;
          let selectedPurchases = 0;

          rewardInputs.forEach((field) => {
            if (!(field instanceof HTMLInputElement)) return;
            const maximum = Number(field.max || 0);
            const amount = Math.max(0, Math.min(maximum, Math.floor(Number(field.value) || 0)));
            if (String(amount) !== field.value) field.value = String(amount);
            if (amount > 0) {
              selectedRewards += 1;
              selectedPurchases += amount;
              total += amount * Number(field.dataset.price || 0);
            }
          });

          if (targetTotal instanceof HTMLOutputElement) targetTotal.value = total.toLocaleString("de-DE");
          if (targetSelection instanceof HTMLElement) {
            targetSelection.textContent = selectedRewards > 0
              ? `${selectedRewards} Belohnungsarten · ${selectedPurchases.toLocaleString("de-DE")} Käufe ausgewählt`
              : "Noch keine Belohnung ausgewählt.";
          }
          if (targetApplyButton instanceof HTMLButtonElement) targetApplyButton.disabled = total <= 0;
          return total;
        };

        shopTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            if (tab instanceof HTMLButtonElement) activateShopPage(tab.dataset.flightShopTab ?? "exklusiv");
          });
        });
        rewardInputs.forEach((field) => field.addEventListener("input", updateTargetTotal));

        targetOpenButton?.addEventListener("click", () => {
          const hasSelection = rewardInputs.some((field) => field instanceof HTMLInputElement && Number(field.value) > 0);
          if (!hasSelection && targetInput instanceof HTMLInputElement) {
            const currentTarget = Number(targetInput.value);
            const matchingReward = rewardInputs.find((field) => (
              field instanceof HTMLInputElement && Number(field.dataset.price) === currentTarget
            ));
            if (matchingReward instanceof HTMLInputElement) matchingReward.value = "1";
          }
          updateTargetTotal();
          targetDialog.showModal();
        });
        targetCloseButton?.addEventListener("click", () => targetDialog.close());
        targetResetButton?.addEventListener("click", () => {
          rewardInputs.forEach((field) => {
            if (field instanceof HTMLInputElement) field.value = "0";
          });
          updateTargetTotal();
        });
        targetApplyButton?.addEventListener("click", () => {
          const total = updateTargetTotal();
          if (total <= 0 || !(targetInput instanceof HTMLInputElement)) return;
          targetInput.value = String(total);
          targetDialog.close();
          if (flightForm instanceof HTMLFormElement) flightForm.requestSubmit();
        });
        targetDialog.addEventListener("click", (event) => {
          if (event.target === targetDialog) targetDialog.close();
        });
        updateTargetTotal();
      }
    </script>
  </body>
</html>
