---
import "../../styles/global.css";
import ImageActionIcon from "../../components/ImageActionIcon.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import eventsData from "../../data/events.generated.json";

const raidEvents = eventsData.items
  .filter((event) => /raubzug/i.test(event.title))
  .map(({ slug, title, date, time, end, endDate, detailUrl }) => ({ slug, title, date, time, end, endDate, detailUrl }));
const capitalEvents = eventsData.items
  .filter((event) => /hauptstadteroberung/i.test(event.title))
  .map(({ title, date, time, end, endDate, detailUrl }) => ({ title, date, time, end, endDate, detailUrl }));
const calculatorData = JSON.stringify({ raidEvents, capitalEvents }).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Plane deine Friedensschilde für den nächsten Raubzug und lade passende Kalendererinnerungen herunter."
    />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Schildplaner · Tools · DIE Drachenhalle</title>
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="tools" />

      <main class="tool-main" id="main-content">
        <nav class="tool-breadcrumb" aria-label="Brotkrümelnavigation">
          <a href="/drachenhalle/tools/">Tools</a>
          <span aria-hidden="true">/</span>
          <span>Schildplaner</span>
        </nav>

        <header class="tool-hero shield-tool-hero">
          <div class="shield-hero-copy">
            <p class="eyebrow">Raubzug-Planung</p>
            <div class="shield-hero-title-line">
              <h1>Schildplaner</h1>
              <button
                type="button"
                class="tip-article-share tool-share-button"
                data-share-page
                data-share-url="/drachenhalle/tools/schildrechner/"
                aria-label="Schildplaner teilen"
                title="Schildplaner teilen"
              >
                <ImageActionIcon type="share" />
              </button>
            </div>
            <p>
              Trage deinen Schildbestand, den gewünschten Start und deine aktiven Kampfzeiten ein.
              Der Planer prüft den nächsten Raubzug, erkennt eine parallele Hauptstadteroberung
              und erstellt einen passenden Ablauf aus Schutz- und Plünderphasen.
            </p>
          </div>
          <div class="shield-hero-flow" aria-label="Vom Schildbestand zum fertigen Schildplan">
            <div>
              <b class="shield-flow-icon" aria-hidden="true">🛡️</b>
              <span>01</span>
              <strong>Bestand</strong>
              <small>72h, 24h, 12h und 8h</small>
            </div>
            <i aria-hidden="true">→</i>
            <div>
              <b class="shield-flow-icon" aria-hidden="true">⚔️</b>
              <span>02</span>
              <strong>Kampfzeiten</strong>
              <small>Schutz- und Plünderfenster</small>
            </div>
            <i aria-hidden="true">→</i>
            <div class="is-result">
              <b class="shield-flow-icon" aria-hidden="true">✓</b>
              <span>03</span>
              <strong>Schildplan</strong>
              <small>mit Kalendererinnerungen</small>
            </div>
          </div>
        </header>

        <section class="shield-calculator" data-shield-calculator aria-labelledby="shield-form-title">
          <form class="shield-form" data-shield-form>
            <div class="shield-next-event" data-next-event>
              <p class="eyebrow">Automatisch aus den Terminen</p>
              <h2 id="shield-form-title">Nächster Raubzug</h2>
              <p data-raid-date>Der nächste Raubzug wird geladen …</p>
              <a data-raid-link href="/drachenhalle/termine/" hidden>Termindetails öffnen →</a>
              <p class="shield-capital-hint" data-capital-hint hidden></p>
            </div>

            <fieldset>
              <legend>Dein Schildbestand</legend>
              <div class="shield-inventory-grid">
                <label class="shield-inventory-item">
                  <span>72h-Schilde</span>
                  <input name="shields72" type="number" min="0" max="20" step="1" value="0" inputmode="numeric" />
                </label>
                <label class="shield-inventory-item">
                  <span>24h-Schilde</span>
                  <input name="shields24" type="number" min="0" max="20" step="1" value="1" inputmode="numeric" />
                </label>
                <label class="shield-inventory-item">
                  <span>12h-Schilde</span>
                  <input name="shields12" type="number" min="0" max="20" step="1" value="0" inputmode="numeric" />
                </label>
                <label class="shield-inventory-item">
                  <span>8h-Schilde</span>
                  <input name="shields8" type="number" min="0" max="20" step="1" value="1" inputmode="numeric" />
                </label>
              </div>

              <button
                class="tool-info-launch shield-price-launch"
                type="button"
                aria-label="Schildpreise, Verfügbarkeit und Basis-Buff anzeigen"
                aria-haspopup="dialog"
                aria-controls="shield-basis-help-dialog"
                title="Schildwissen anzeigen"
                data-shield-help-open
              >
                <span class="tool-info-launch-icon" aria-hidden="true">i</span>
                <span>
                  <strong>Schildpreise &amp; Basis-Buff</strong>
                  <small>Kosten, Wochenlimits und Fundstelle im Spiel</small>
                </span>
              </button>
            </fieldset>

            <fieldset>
              <legend>Dein Plan</legend>
              <div class="shield-plan-fields">
                <label>
                  <span>Erstes Schild setzen</span>
                  <input name="firstShield" type="datetime-local" required />
                </label>
                <div class="shield-control-with-help">
                  <label>
                    <span>Optimierung</span>
                    <select name="strategy" aria-describedby="shield-optimization-help-title">
                      <option value="fewest">Möglichst wenige Schilde</option>
                      <option value="least-waste">Möglichst wenig Laufzeit verschenken</option>
                      <option value="cost">Diamanten vermeiden &amp; Allianzmünzen sparen</option>
                    </select>
                  </label>
                  <button
                    class="shield-help-trigger"
                    type="button"
                    aria-label="Tipp: Unterschiede der Optimierungen"
                    aria-haspopup="dialog"
                    aria-controls="shield-optimization-help-dialog"
                    title="Optimierungen erklärt"
                    data-shield-optimization-help-open
                  >?</button>
                </div>
              </div>
            </fieldset>

            <fieldset class="shield-combat-fieldset">
              <legend>Aktive Kampfzeiten</legend>
              <p class="shield-field-help">
                Plane jedes Zeitfenster vom ersten bis zum letzten beabsichtigten Angriff. Ab dem
                letzten Angriff laufen 15 Minuten Battle Frenzy – unabhängig davon, auf welchem
                Server du angreifst. Erst danach kann der Schutz neu beginnen.
              </p>
              <div class="shield-plan-fields shield-combat-options">
                <label data-capital-mode-field hidden>
                  <span>Hauptstadteroberung</span>
                  <select name="capitalMode">
                    <option value="passive">Nein – ich bleibe unter Schild</option>
                    <option value="active">Ja – ich kämpfe aktiv mit</option>
                    <option value="unclear">Noch unklar</option>
                  </select>
                </label>
                <label>
                  <span>Zusätzlicher Sicherheitspuffer</span>
                  <select name="returnBuffer">
                    <option value="0" selected>Kein zusätzlicher Puffer</option>
                    <option value="5">5 Minuten</option>
                    <option value="10">10 Minuten</option>
                    <option value="15">15 Minuten</option>
                  </select>
                </label>
              </div>

              <div class="shield-raid-windows">
                <div class="shield-raid-windows-heading">
                  <div>
                    <strong>Plünderfenster auf dem anderen Server</strong>
                    <span>Bis zu fünf freie Zeitfenster ergänzen.</span>
                  </div>
                  <button type="button" class="shield-secondary-button" data-add-raid-window>
                    Zeitfenster hinzufügen +
                  </button>
                </div>
                <div class="shield-raid-window-list" data-raid-window-list>
                  <p class="shield-raid-window-empty" data-raid-window-empty>
                    Noch kein aktives Plünderfenster eingeplant.
                  </p>
                </div>
                <p class="shield-window-status" data-window-status aria-live="polite"></p>
              </div>
            </fieldset>

            <button class="tool-primary-button" type="submit" data-calculate-button>
              Schildplan erstellen
            </button>
            <p class="shield-form-error" role="alert" data-form-error hidden></p>
          </form>

          <section class="shield-result" data-shield-result aria-live="polite" aria-atomic="false" hidden>
            <div class="shield-result-character" aria-hidden="true">
              <img
                class="shield-character shield-character-calm"
                src="/drachenhalle/brand/tutorial-chibi-anthlan.webp"
                width="696"
                height="1072"
                alt=""
                data-character-calm
              />
              <img
                class="shield-character shield-character-concerned"
                src="/drachenhalle/brand/tool-shield-anthlan-concerned.webp"
                width="696"
                height="1044"
                alt=""
                data-character-concerned
                hidden
              />
            </div>
            <div class="shield-result-copy">
              <div class="shield-result-intro">
                <p class="eyebrow" data-result-kicker>Auswertung</p>
                <h2 data-result-title>Dein Schildplan</h2>
                <p data-result-summary></p>
              </div>

              <div class="shield-result-facts" data-result-facts></div>

              <aside class="shield-purchase-recommendation" data-purchase-recommendation hidden>
                <div class="shield-purchase-icon" aria-hidden="true">🛒</div>
                <div>
                  <p class="eyebrow" data-purchase-kicker>Einkaufsempfehlung</p>
                  <h3 data-purchase-title>Günstiger planen</h3>
                  <p data-purchase-summary></p>
                  <div class="shield-purchase-facts" data-purchase-facts></div>
                  <button
                    class="shield-secondary-button shield-purchase-apply"
                    type="button"
                    data-use-cost-plan
                    hidden
                  >Günstigen Plan verwenden →</button>
                </div>
              </aside>

              <div class="shield-schedule">
                <h3>Empfohlene Zeitpunkte</h3>
                <p class="shield-schedule-legend" aria-label="Legende des Schildplans">
                  <span class="is-protected">🛡 Schildschutz</span>
                  <span class="is-active">⚔ Bewusst ungeschützt</span>
                  <span class="is-gap">⚠ Schutzlücke</span>
                </p>
                <ol data-schedule-list></ol>
              </div>

              <p class="shield-result-note" data-result-note></p>

              <div class="shield-result-actions">
                <button class="tool-primary-button" type="button" data-download-plan disabled>
                  Erinnerungen als ICS laden ↓
                </button>
                <a data-result-event-link href="/drachenhalle/termine/">Raubzugtermin öffnen →</a>
              </div>

              <section class="shield-timeflow" data-shield-timeline hidden aria-labelledby="shield-timeflow-title">
                <div class="shield-timeflow-heading">
                  <div>
                    <p class="eyebrow">Zeitstrahl</p>
                    <h3 id="shield-timeflow-title">So wirken sich deine Zeitspannen aus</h3>
                  </div>
                  <p>Von deinem ersten geplanten Schild bis zum Ende der letzten Schildlaufzeit.</p>
                </div>
                <div
                  class="shield-timeflow-track"
                  data-shield-timeline-track
                  role="img"
                  aria-label="Zeitlicher Verlauf des Schildplans"
                ></div>
                <div class="shield-timeflow-range" aria-hidden="true">
                  <span data-shield-timeline-start></span>
                  <span data-shield-timeline-end></span>
                </div>
                <ol class="shield-timeflow-phases" data-shield-timeline-phases></ol>
              </section>
            </div>
          </section>
        </section>

        <div class="shield-raid-cheer" data-raid-cheer hidden role="status" aria-live="polite" aria-atomic="true">
          <img
            src="/drachenhalle/brand/tool-shield-anthlan-battlecry.webp"
            width="480"
            height="720"
            alt=""
            aria-hidden="true"
          />
          <div class="shield-raid-cheer-bubble">
            <strong>Für DIE!</strong>
            <span>Auf zum Raubzug!</span>
          </div>
        </div>

        <dialog
          class="healing-help-dialog shield-help-dialog tool-info-dialog"
          id="shield-optimization-help-dialog"
          aria-labelledby="shield-optimization-help-title"
        >
          <div class="healing-help-content">
            <header class="healing-help-heading">
              <div>
                <p class="eyebrow">Schildkombination auswählen</p>
                <h2 id="shield-optimization-help-title">Was bedeutet „Optimierung“?</h2>
              </div>
              <button
                type="button"
                class="healing-help-close"
                aria-label="Erklärung schließen"
                title="Schließen"
                data-shield-optimization-help-close
              >×</button>
            </header>

            <ul class="shield-optimization-help-list">
              <li>
                <strong>Möglichst wenige Schilde</strong>
                <span>Minimiert die Anzahl der Schildwechsel. Bei Gleichstand gewinnt der Plan mit weniger überschüssiger Laufzeit.</span>
              </li>
              <li>
                <strong>Möglichst wenig Laufzeit verschenken</strong>
                <span>Deckt die Schutzphasen möglichst passgenau ab und minimiert zuerst ungenutzte Schildstunden.</span>
              </li>
              <li>
                <strong>Diamanten vermeiden &amp; Allianzmünzen sparen</strong>
                <span>Vermeidet zuerst diamantpflichtige Schilde und vergleicht danach die bekannten Wiederbeschaffungskosten im Allianzshop.</span>
              </li>
            </ul>
            <p class="shield-help-copy">
              Die wöchentlichen Shoplimits werden im Ergebnis als Warnung angezeigt. Bereits angesparte
              Schilde kannst du unabhängig davon in deinen Bestand eintragen.
            </p>
          </div>
        </dialog>

        <dialog
          class="healing-help-dialog shield-help-dialog tool-info-dialog"
          id="shield-basis-help-dialog"
          aria-labelledby="shield-basis-help-title"
        >
          <div class="healing-help-content">
            <header class="healing-help-heading">
              <div>
                <p class="eyebrow">Schildwissen</p>
                <h2 id="shield-basis-help-title">Preise, Verfügbarkeit &amp; Basis-Buff</h2>
              </div>
              <button
                type="button"
                class="healing-help-close"
                aria-label="Tipp schließen"
                title="Schließen"
                data-shield-help-close
              >×</button>
            </header>

            <section class="tool-info-section" aria-labelledby="shield-prices-title">
              <div class="tool-info-section-heading">
                <span>01</span>
                <div>
                  <p class="eyebrow">Planungsgrundlage</p>
                  <h3 id="shield-prices-title">Kosten und wöchentliche Verfügbarkeit</h3>
                </div>
              </div>
              <div class="shield-price-overview" aria-label="Preise und wöchentliche Verfügbarkeit der Schilde">
                <article>
                  <strong>72h</strong>
                  <span>Allianzshop: nicht erhältlich</span>
                  <span>Basis-Buff: 12.000 Diamanten</span>
                </article>
                <article>
                  <strong>24h</strong>
                  <span>20.000 Allianzmünzen · 3 pro Woche</span>
                  <span>Basis-Buff: Preis unbekannt</span>
                </article>
                <article>
                  <strong>12h</strong>
                  <span>10.000 Allianzmünzen · 3 pro Woche</span>
                  <span>Basis-Buff: 2.500 Diamanten</span>
                </article>
                <article>
                  <strong>8h</strong>
                  <span>7.500 Allianzmünzen · 8 pro Woche</span>
                  <span>Basis-Buff: 1.500 Diamanten</span>
                </article>
              </div>
              <p class="tool-info-footnote">Die Kostenoptimierung bewertet 24h-, 12h- und 8h-Schilde über den Allianzshop und 72h-Schilde über den Basis-Buff. Der unbekannte Diamantpreis des 24h-Schilds wird nicht geschätzt.</p>
            </section>

            <section class="tool-info-section" aria-labelledby="shield-guide-title">
              <div class="tool-info-section-heading">
                <span>02</span>
                <div>
                  <p class="eyebrow">Im Spiel nachsehen</p>
                  <h3 id="shield-guide-title">So erreichst du die Schildauswahl</h3>
                </div>
              </div>
              <p class="shield-help-copy">
                Basis-Buffs sind die zeitlich begrenzten Verstärkungen deiner Basis. In diesem Menü
                findest du auch die Friedensschilde, die direkt mit Diamanten gekauft und aktiviert werden können.
              </p>
              <ol class="healing-help-steps shield-basis-help-steps tool-guide-grid">
              <li>
                <figure class="tool-guide-card">
                  <img
                    src="/drachenhalle/tutorial/schildplaner/01-basis-buff.png"
                    alt="Eigene Basis mit markiertem Schild-Symbol zum Öffnen der Basis-Buffs"
                    loading="lazy"
                  />
                  <figcaption>
                    <strong>1. Basis-Buffs öffnen</strong>
                    <span>Tippe deine eigene Basis an und öffne anschließend das markierte Schild-Symbol.</span>
                  </figcaption>
                </figure>
              </li>
              <li>
                <figure class="tool-guide-card">
                  <img
                    src="/drachenhalle/tutorial/schildplaner/02-schild-buffseite.jpg"
                    alt="Schild-Reiter der Basis-Buffs mit den verfügbaren Friedensschilden"
                    loading="lazy"
                  />
                  <figcaption>
                    <strong>2. Schild auswählen</strong>
                    <span>Im Reiter „Schild“ siehst du deinen Bestand und kannst weitere Schilde mit Diamanten kaufen.</span>
                  </figcaption>
                </figure>
              </li>
              </ol>
            </section>
          </div>
        </dialog>

        <section class="tool-reference" aria-labelledby="shield-reference-title">
          <header>
            <p class="eyebrow">Grundlage & Grenzen</p>
            <h2 id="shield-reference-title">Was der Planer berücksichtigt</h2>
          </header>
          <div class="tool-reference-grid">
            <article>
              <span aria-hidden="true">🛡️</span>
              <div>
                <h3>Der gemeinsame Schildplan</h3>
                <p>
                  Der Planer verwendet den im Allianztext beschriebenen Gefahrenzeitraum und
                  plant mit 72-, 24-, 12- und 8-Stunden-Schilden. Bekannte Shoppreise und
                  wöchentliche Verfügbarkeiten fließen in die Kostenübersicht ein.
                </p>
                <a href="/drachenhalle/docs/eventankuendigung-raubzugkaempfe/">
                  Raubzug-Ankündigung lesen →
                </a>
              </div>
            </article>
            <article>
              <span aria-hidden="true">⚔️</span>
              <div>
                <h3>Hauptstadt und Battle Frenzy</h3>
                <p>
                  Aktive Angriffe können den Schild beenden. Bei aktiver Teilnahme plant das Tool
                  deshalb getrennte Schutzphasen, 15 Minuten Battle Frenzy und auf Wunsch einen
                  zusätzlichen Sicherheitspuffer ein. Entscheidend ist immer dein letzter Angriff,
                  unabhängig vom besuchten Server.
                </p>
                <a href="/drachenhalle/docs/tipp-13-expeditionswahnsinn-hauptstadteroberung/">
                  Tipp zur Hauptstadteroberung öffnen →
                </a>
              </div>
            </article>
          </div>
          <p class="tool-disclaimer">
            Der Planer ist eine Planungshilfe. Prüfe vor jeder Aktion die aktuelle Ingame-Anzeige:
            Spielupdates, offensive Aktionen oder abweichende Eventzeiten können einen Schildplan verändern.
          </p>
        </section>
      </main>

      <SiteFooter />
    </div>

    <p class="share-feedback" role="status" aria-live="polite" aria-atomic="true" data-share-feedback></p>

    <template id="shield-raid-window-template">
      <div class="shield-raid-window" data-raid-window>
        <label>
          <span>Erster geplanter Angriff</span>
          <input type="datetime-local" data-window-start required />
        </label>
        <label>
          <span>Letzter geplanter Angriff</span>
          <input type="datetime-local" data-window-end required />
        </label>
        <button type="button" class="shield-window-remove" data-remove-raid-window aria-label="Plünderfenster entfernen" title="Plünderfenster entfernen">
          ×
        </button>
      </div>
    </template>

    <script type="application/json" id="shield-events-data" set:html={calculatorData}></script>
    <script>
      import { initializeImageActions } from "../../scripts/image-actions";
      import { initializeShieldCalculator } from "../../scripts/shield-calculator";

      initializeShieldCalculator();
      initializeImageActions();

      const connectShieldHelpDialog = (dialogSelector: string, openSelector: string, closeSelector: string) => {
        const helpDialog = document.querySelector(dialogSelector);
        const helpOpen = document.querySelector(openSelector);
        const helpClose = document.querySelector(closeSelector);
        if (!(helpDialog instanceof HTMLElement)) return;

        const openHelp = () => {
          const dialog = helpDialog as HTMLDialogElement;
          if (typeof dialog.showModal === "function") dialog.showModal();
          else dialog.setAttribute("open", "");
        };
        const closeHelp = () => {
          const dialog = helpDialog as HTMLDialogElement;
          if (typeof dialog.close === "function") dialog.close();
          else dialog.removeAttribute("open");
        };

        helpOpen?.addEventListener("click", openHelp);
        helpClose?.addEventListener("click", closeHelp);
        helpDialog.addEventListener("click", (event) => {
          if (event.target === helpDialog) closeHelp();
        });
      };

      connectShieldHelpDialog(
        "#shield-basis-help-dialog",
        "[data-shield-help-open]",
        "[data-shield-help-close]",
      );
      connectShieldHelpDialog(
        "#shield-optimization-help-dialog",
        "[data-shield-optimization-help-open]",
        "[data-shield-optimization-help-close]",
      );
    </script>
  </body>
</html>
