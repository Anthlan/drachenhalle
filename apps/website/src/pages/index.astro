---
import SocialMeta from "../components/SocialMeta.astro";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HallAtmosphere from "../components/HallAtmosphere.astro";
import newsData from "../data/news.generated.json";
import eventsData from "../data/events.generated.json";
import docsData from "../data/docs.generated.json";
import galleryData from "../data/gallery.generated.json";
import changelog from "../data/changelog.generated.json";

const formatDate = (value) => value
  ? new Intl.DateTimeFormat("de-DE", { day: "2-digit", month: "long", year: "numeric", timeZone: "Europe/Berlin" }).format(new Date(value))
  : "Noch nicht veröffentlicht";

const today = new Intl.DateTimeFormat("sv-SE", { timeZone: "Europe/Berlin" }).format(new Date());
const upcomingEvents = eventsData.items.filter((event) => event.date >= today).slice(0, 3);
const nextEvent = upcomingEvents[0] ?? null;
const laterEvents = upcomingEvents.slice(1);
const featuredNews = newsData.items[0] ?? null;
const secondaryNews = newsData.items.slice(1, 3);
const featuredNewsDocument = featuredNews
  ? docsData.items.find((document) => !document.hidden && featuredNews.html.includes(`href="${document.url}"`))
  : null;
const latestGalleryItems = galleryData.items
  .filter((item) => ["Chatbild", "Reaktionsbild", "Avatar", "Charaktermodell"].includes(item.category))
  .slice(0, 4);
const fallbackKnowledge = docsData.items.filter((document) => document.kind === "tip" && !document.hidden).reverse();
const upcomingKnowledge = upcomingEvents.flatMap((event) => event.related ?? []);
const knowledgeCandidates = upcomingKnowledge.length > 0 ? upcomingKnowledge : fallbackKnowledge;
const featuredKnowledge = knowledgeCandidates
  .filter((document, index, items) => items.findIndex((candidate) => candidate.slug === document.slug) === index)
  .slice(0, 3);

const nextEventDate = nextEvent ? new Date(`${nextEvent.date}T12:00:00`) : null;
const nextEventDay = nextEventDate ? new Intl.DateTimeFormat("de-DE", { day: "2-digit" }).format(nextEventDate) : null;
const nextEventMonth = nextEventDate ? new Intl.DateTimeFormat("de-DE", { month: "short" }).format(nextEventDate).replace(".", "") : null;
const eventTimeLabel = (event) => event.time ? `${event.time}${event.end ? `–${event.end}` : ""} Uhr` : "Ganztägig";

const relativeLabel = (date) => {
  const difference = Math.round((new Date(`${date}T12:00:00Z`) - new Date(`${today}T12:00:00Z`)) / 86400000);
  if (difference === 0) return "Heute";
  if (difference === 1) return "Morgen";
  return null;
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Neuigkeiten und die letzten Änderungen aus der öffentlichen DIE Drachenhalle."
    />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Aktuelles · DIE Drachenhalle</title>
  <SocialMeta title={`Aktuelles · DIE Drachenhalle`} description="Neuigkeiten und die letzten Änderungen aus der öffentlichen DIE Drachenhalle." />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="news" />

      <main class="news-main" id="main-content">
        <section class="welcome-hero" aria-labelledby="welcome-title">
          <div class="welcome-copy">
            <p class="eyebrow">Die Drachenritter · DIE</p>
            <h1 id="welcome-title">Willkommen in der Drachenhalle</h1>
            <p>
              Der gemeinsame Ort für Neuigkeiten, Termine, Wissen und die Geschichten unserer Allianz.
            </p>
          </div>
          <nav class="home-shortcuts" aria-label="Schnellzugriff"><a href="/drachenhalle/termine/">Termine</a><a href="/drachenhalle/tools/">Rechner</a><a href="/drachenhalle/docs/dein-einstieg-bei-uns/">Dein Einstieg</a></nav>
          <figure class="welcome-visual">
            <img
              src="/drachenhalle/brand/die-drachenhalle-willkommen.webp"
              width="1600"
              height="900"
              alt="Von links stehen Somea, mysteryZ, Leader Anthlan, Drachenherz und DaVinci1986 am Strategietisch der Drachenhalle."
              fetchpriority="high"
            />
            <HallAtmosphere />
            <figcaption>Anthlan und die vier offiziellen Offiziere der Drachenritter.</figcaption>
          </figure>
        </section>

        <section class="home-today" aria-labelledby="home-today-title">
          <a
            class="home-alliance-chibi"
            href="/drachenhalle/docs/allianz/"
            aria-label="Anthlan zeigt dir den Weg zur Allianz"
          >
            <img
              src="/drachenhalle/brand/tutorial-chibi-anthlan.webp"
              width="696"
              height="1072"
              alt="Chibi Anthlan zwinkert und zeigt den Daumen nach oben."
              loading="lazy"
            />
            <span>Zur Allianz →</span>
          </a>
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Jetzt wichtig</p>
              <h2 id="home-today-title">Heute in der Drachenhalle</h2>
            </div>
            <p><a class="section-text-link" href="/drachenhalle/termine/">Alle Termine ansehen →</a></p>
          </header>

          {nextEvent ? (
            <div class="home-event-layout">
              <article class:list={["home-event-feature", `event-theme-${nextEvent.theme ?? "standard"}`]}>
                <div class="home-event-date" aria-hidden="true">
                  {relativeLabel(nextEvent.date) && <span>{relativeLabel(nextEvent.date)}</span>}
                  <strong>{nextEventDay}</strong>
                  <small>{nextEventMonth}</small>
                </div>
                <div class="home-event-copy">
                  <span>{nextEvent.category} · {eventTimeLabel(nextEvent)}</span>
                  <h3>{nextEvent.title}</h3>
                  <p>{nextEvent.summary}</p>
                  <div>
                    <a href={nextEvent.detailUrl}>Termin ansehen →</a>
                    <a href={nextEvent.calendarUrl} download>Kalender ↓</a>
                  </div>
                </div>
              </article>
              {laterEvents.length > 0 && (
                <div class="home-event-later" aria-label="Weitere kommende Termine">
                  {laterEvents.map((event) => (
                    <a class={`event-theme-${event.theme ?? "standard"}`} href={event.detailUrl}>
                      <time datetime={event.date}>{formatDate(`${event.date}T12:00:00+02:00`)}</time>
                      <strong>{event.title}</strong>
                      <span>{eventTimeLabel(event)} · Details →</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <p class="events-empty">Aktuell sind keine kommenden Events eingetragen.</p>
          )}
        </section>

        <section class="news-section" id="neuigkeiten" aria-labelledby="news-list-title">
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Gezielt veröffentlicht</p>
              <h2 id="news-list-title">Neuigkeiten</h2>
            </div>
            <p>Wichtige Meldungen, neue Inhalte und Hinweise aus der Drachenhalle.</p>
          </header>

          {featuredNews ? (
            <div class="home-news-layout">
              <a class="home-news-feature" href={featuredNews.url}>
                {featuredNewsDocument?.imageUrl && (
                  <img src={featuredNewsDocument.imageUrl} alt="" loading="lazy" />
                )}
                <div>
                  <div class="news-card-meta">
                    <span>{featuredNews.category}</span>
                    <time datetime={featuredNews.date}>{formatDate(`${featuredNews.date}T12:00:00+02:00`)}</time>
                  </div>
                  <h3>{featuredNews.title}</h3>
                  <p>{featuredNews.summary}</p>
                  <strong>Weiterlesen →</strong>
                </div>
              </a>
              {secondaryNews.length > 0 && (
                <div class="home-news-secondary">
                  {secondaryNews.map((item) => (
                    <a href={item.url}>
                      <div class="news-card-meta">
                        <span>{item.category}</span>
                        <time datetime={item.date}>{formatDate(`${item.date}T12:00:00+02:00`)}</time>
                      </div>
                      <h3>{item.title}</h3>
                      <p>{item.summary}</p>
                      <strong>Weiterlesen →</strong>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <p class="news-empty">Noch sind keine Neuigkeiten veröffentlicht.</p>
          )}
        </section>

        <section class="home-gallery" aria-labelledby="home-gallery-title">
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Frisch aus der Bildsammlung</p>
              <h2 id="home-gallery-title">Neu in der Galerie</h2>
            </div>
            <p><a class="section-text-link" href="/drachenhalle/galerie/">Alle Bilder entdecken →</a></p>
          </header>
          <div class="home-gallery-grid">
            {latestGalleryItems.map((item) => (
              <a href={`/drachenhalle/galerie/#bild-${item.id}`}>
                <img src={item.thumbnailUrl} alt={item.title} loading="lazy" />
                <span>{item.category}</span>
                <strong>{item.title}</strong>
              </a>
            ))}
          </div>
        </section>

        <section class="home-knowledge" aria-labelledby="home-knowledge-title">
          <header class="content-section-heading">
            <div>
              <p class="eyebrow">Passend zu den nächsten Einsätzen</p>
              <h2 id="home-knowledge-title">Drachenwissen für heute</h2>
            </div>
            <p>Weiterführende Tipps und Informationen, die gerade besonders hilfreich sind.</p>
          </header>
          <div class="home-knowledge-grid">
            {featuredKnowledge.map((document) => (
              <a href={document.url}>
                {document.imageUrl && <img src={document.imageUrl} alt="" loading="lazy" />}
                <div>
                  <span>{document.label ?? "Drachenwissen"}</span>
                  <h3>{document.title}</h3>
                  <p>{document.summary}</p>
                  <strong>Öffnen →</strong>
                </div>
              </a>
            ))}
          </div>
        </section>

        <p class="home-update-note">
          Stand der Drachenhalle: <time datetime={changelog.date ?? undefined}>{formatDate(changelog.date)}</time>
        </p>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
