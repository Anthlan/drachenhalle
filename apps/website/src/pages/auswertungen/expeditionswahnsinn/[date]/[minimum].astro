---
import ExpeditionReport from "../../../../components/ExpeditionReport.astro";
import { expeditionReports } from "../../../../data/expedition-reports";
export function getStaticPaths() {
 return expeditionReports.map(report => ({params:{date:report.date,minimum:"50000"},props:{report}}));
}
const {report}=Astro.props;
---
<ExpeditionReport report={report} minimumPoints={50000} />
