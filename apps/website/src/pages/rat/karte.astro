---
import SocialMeta from "../../components/SocialMeta.astro";
import "../../styles/global.css";
import ImageActionIcon from "../../components/ImageActionIcon.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import mapData from "../../data/map.generated.json";

const mapAspect = mapData.width / mapData.height;
const mapCellSize = mapData.width / 1000;
const interactiveRegions = mapData.regions.map(({ id, code, cityLevel, center }) => ({ id, code, cityLevel, center }));
const renderRegions = [...mapData.regions].sort((first, second) => Number(first.manualBoundary) - Number(second.manualBoundary));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Interne Planungskarte für den Allianzrat der DIE Drachenhalle." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Planungskarte · Strategieraum · DIE Drachenhalle</title>
  <SocialMeta title={`Planungskarte · Strategieraum · DIE Drachenhalle`} description="Interne Planungskarte für den Allianzrat der DIE Drachenhalle." />
  </head>
  <body>
    <div class="page-shell map-page-shell">
      <SiteHeader active="" />

      <main class="council-map-main" id="main-content">
        <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
          <a href="/drachenhalle/rat/">Strategieraum</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Planungskarte</span>
        </nav>

        <header class="council-map-hero">
          <div>
            <p class="eyebrow">Allianzrat · Planungsinstrument</p>
            <h1>Gebietskarte</h1>
            <p>Gebietsgrenzen und Stadtlevel prüfen sowie Spielkoordinaten ablesen.</p>
          </div>
          <button
            type="button"
            class="tip-article-share"
            data-share-page
            data-share-url="/drachenhalle/rat/karte/"
            aria-label="Planungskarte teilen"
            title="Planungskarte teilen"
          >
            <ImageActionIcon type="share" />
          </button>
        </header>

        <section
          class="council-map-workspace"
          data-council-map
          data-regions={JSON.stringify(interactiveRegions)}
          style={`--map-aspect: ${mapAspect}`}
          aria-labelledby="map-workspace-title"
        >
          <h2 class="visually-hidden" id="map-workspace-title">Interaktive Gebietskarte</h2>

          <div class="council-map-toolbar" aria-label="Kartensteuerung">
            <div class="map-zoom-controls" role="group" aria-label="Zoom">
              <button type="button" data-map-zoom-out aria-label="Verkleinern" title="Verkleinern">−</button>
              <button type="button" data-map-reset>Gesamtansicht</button>
              <button type="button" data-map-zoom-in aria-label="Vergrößern" title="Vergrößern">+</button>
            </div>
            <label class="map-layer-toggle">
              <input type="checkbox" data-map-layer checked />
              <span>Gebietsgrenzen</span>
            </label>
            <output class="map-coordinate-output" data-map-coordinates aria-live="polite">X 500 · Y 500</output>
          </div>

          <div class="council-map-layout">
            <div
              class="council-map-viewport"
              data-map-viewport
              tabindex="0"
              aria-label="Interaktive Karte. Mit Pfeiltasten verschieben, mit Plus und Minus zoomen."
            >
              <div class="council-map-stage" data-map-stage>
                <svg
                  class="council-map-vector"
                  data-map-vector
                  viewBox="0 0 1000 1000"
                  role="img"
                  aria-label="Schematische Karte der Spielwelt mit Gebietsgrenzen"
                >
                  <defs>
                    <pattern id="map-grid-cell" width={mapCellSize} height={mapCellSize} patternUnits="userSpaceOnUse">
                      <path class="map-grid-cell-line" d={`M${mapCellSize} 0H0V${mapCellSize}`} fill="none" />
                    </pattern>
                    <pattern id="map-grid-ten" width={mapCellSize * 10} height={mapCellSize * 10} patternUnits="userSpaceOnUse">
                      <rect width={mapCellSize * 10} height={mapCellSize * 10} fill="url(#map-grid-cell)" />
                      <path d={`M${mapCellSize * 10} 0H0V${mapCellSize * 10}`} fill="none" stroke="rgba(246, 216, 141, 0.1)" stroke-width="0.8" />
                    </pattern>
                    <pattern id="map-grid-major" width={mapCellSize * 100} height={mapCellSize * 100} patternUnits="userSpaceOnUse">
                      <rect width={mapCellSize * 100} height={mapCellSize * 100} fill="url(#map-grid-ten)" />
                      <path d={`M${mapCellSize * 100} 0H0V${mapCellSize * 100}`} fill="none" stroke="rgba(246, 216, 141, 0.24)" stroke-width="1.5" />
                    </pattern>
                    <radialGradient id="map-field" cx="50%" cy="45%" r="72%">
                      <stop offset="0%" stop-color="#172441" />
                      <stop offset="100%" stop-color="#080d1c" />
                    </radialGradient>
                  </defs>
                  <rect width="1000" height="1000" fill="url(#map-field)" />
                  <rect width="1000" height="1000" fill="url(#map-grid-major)" />
                  <g class="map-vector-regions" data-map-regions>
                    <g class="map-vector-region-layer">
                      {renderRegions.map((region) => (
                        <g class="map-vector-region" data-map-region-shape={region.id}>
                          <path class="map-vector-region-fill" d={region.fillPath} />
                          <path class="map-vector-region-outline" d={region.outlinePath} />
                        </g>
                      ))}
                    </g>
                    <g class="map-level-markers">
                      {renderRegions.map((region) => (
                        <g
                          class="map-region-label"
                          data-map-region={region.id}
                          transform={`translate(${region.center.vectorX} ${region.center.vectorY})`}
                          role="button"
                          tabindex="0"
                          aria-label={`${region.code}: Stadtlevel ${region.cityLevel}`}
                        >
                          <circle r="15" />
                          <text text-anchor="middle" dominant-baseline="central" aria-hidden="true">{region.cityLevel}</text>
                        </g>
                      ))}
                    </g>
                  </g>
                  <g class="map-axis-labels" aria-hidden="true">
                    <text x="14" y="978">1 × 1</text>
                    <text x="986" y="978" text-anchor="end">999 × 1</text>
                    <text x="14" y="30">1 × 999</text>
                    <text x="986" y="30" text-anchor="end">999 × 999</text>
                    <text x="500" y="978" text-anchor="middle">X 500</text>
                    <text x="14" y="505">Y 500</text>
                  </g>
                </svg>
              </div>
              <p class="map-gesture-hint">Ziehen zum Verschieben · 1×1-Raster erscheint beim Zoomen · Gebiet antippen für Details</p>
            </div>

            <aside class="council-map-inspector" aria-live="polite">
              <p class="eyebrow">Auswahl</p>
              <div data-map-selection>
                <h2>Gebiet wählen</h2>
                <p>Tippe eine Fläche oder einen Levelmarker an. Das Stadtlevel stammt aus <code>Karte/GEBIETE.md</code>.</p>
              </div>
              <dl class="map-coordinate-legend">
                <div><dt>Unten links</dt><dd>1 × 1</dd></div>
                <div><dt>Oben rechts</dt><dd>999 × 999</dd></div>
              </dl>
            </aside>
          </div>
        </section>
      </main>

      <p class="share-feedback" role="status" aria-live="polite" aria-atomic="true" data-share-feedback></p>
      <SiteFooter />
    </div>

    <script>
      import { initializeImageActions } from "../../scripts/image-actions";
      import { initializeCouncilMap } from "../../scripts/council-map";

      initializeImageActions();
      initializeCouncilMap();
    </script>
  </body>
</html>
