---
import SocialMeta from "../../components/SocialMeta.astro";
import "../../styles/global.css";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import newsData from "../../data/news.generated.json";

export function getStaticPaths() {
  return newsData.items.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const formatDate = (value) => new Intl.DateTimeFormat("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Berlin",
}).format(new Date(`${value}T12:00:00+02:00`));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={article.summary} />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>{article.title} · DIE Drachenhalle</title>
  <SocialMeta title={`${article.title} · DIE Drachenhalle`} description={article.summary} />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="news" />

      <main class="document-main news-detail-main" id="main-content">
        <nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
          <a href="/drachenhalle/">Aktuelles</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{article.title}</span>
        </nav>

        <article class="document-article news-article">
          <header>
            <div class="news-card-meta">
              <span>{article.category}</span>
              <time datetime={article.date}>{formatDate(article.date)}</time>
            </div>
            <h1>{article.title}</h1>
            <p>{article.summary}</p>
          </header>
          <div class="markdown-content" set:html={article.html} />
        </article>
      </main>

      <SiteFooter />
    </div>
    <script>
      import {translateClient} from "../../i18n/client";
      for (const code of document.querySelectorAll<HTMLElement>(".news-article pre code.language-html")) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code-button";
        const label = translateClient("Mitteilung kopieren");
        button.textContent = label;
        code.parentElement!.before(button);
        button.addEventListener("click", async () => {
          const text = code.textContent?.trimEnd() || "";
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const field = document.createElement("textarea");
            field.value = text;
            field.style.position = "fixed";
            field.style.opacity = "0";
            document.body.append(field);
            field.select();
            const copied = document.execCommand("copy");
            field.remove();
            button.focus();
            if (!copied) return;
          }
          button.textContent = translateClient("Kopiert!");
          window.setTimeout(() => { button.textContent = label; }, 1800);
        });
      }
    </script>
  </body>
</html>
