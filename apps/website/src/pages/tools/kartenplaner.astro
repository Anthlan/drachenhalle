---
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import expedition from "../../data/expedition-2026-10-24.json";
import { buildings, buildingName } from "../../data/season-map";
const alliances = expedition.alliances.filter(a => a.server === 105).sort((a,b) => b.power-a.power).slice(0,10);
---
<!doctype html>
<html lang="de"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Kartenplaner · DIE Drachenhalle</title></head>
<body><div class="page-shell"><SiteHeader active="tools" />
<main id="main-content" class="tool-main" data-planner>
  <header class="tool-hero"><p class="eyebrow">Saisonplanung · 06.11.2026</p><h1>Kartenplaner</h1><p>Neutrale Planungskarte ohne vorgegebene Allianzgebiete. Eigene Einträge sind Vorschläge, keine bestätigten Besitzstände.</p></header>
  <details><summary>Kartenbild auswerten</summary><p>20 × 20 Rasterfelder. Die Hauptstadt Lv7 liegt im Zentrum. Darum liegen Ziele der Stufen 4 bis 6; außen überwiegend Schutzräume Lv1, Märkte Lv2 und Wasserwerke Lv3. Rasteradressen dienen nur dieser Planung und sind keine Spielkoordinaten.</p></details>
  <p>Allianz auf ein Feld ziehen oder eine Allianz anklicken und danach ein Feld wählen. Änderungen bleiben in diesem Browser. Pläne lassen sich exportieren und importieren.</p>
  <section class="alliance-tray" aria-label="Allianzen zur Planung">
    <h2>Top 10 · Server 105</h2><p>Nach Allianzstärke · Hauptstadteroberung vom 24.10.2026</p>
    <div class="alliance-tokens">{alliances.map((a,i)=><button type="button" draggable="true" data-alliance-token={a.tag} data-planner-alliance={a.tag} aria-pressed="false" title={a.tag === 'DIE' ? 'DIE' : a.alliance}><small>{i+1}</small><strong>{a.tag}</strong></button>)}</div>
  </section>
  <div class="planner-layout">
    <section aria-label="Planungskarte"><label>Zoom <input data-zoom type="range" min="100" max="250" step="25" value="100" /> <output data-zoom-value>100 %</output></label>
      <div class="map-scroll"><div class="planning-map" data-map>
        <div class="column-labels" aria-hidden="true">{Array.from({length:20},(_,i)=><span>{String.fromCharCode(65+i)}</span>)}</div>
        <div class="planning-grid">{Array.from({length:400}, (_, i) => {const code = String.fromCharCode(65+i%20)+(Math.floor(i/20)+1);const capital=['J10','K10','J11','K11'].includes(code);const level=capital ? 7 : buildings[code];const name=level ? buildingName(code,level):'';return <button type="button" data-cell={code} data-capital={capital ? "true" : undefined} data-building={name} data-level={level} aria-label={code} title={code}><small class="cell-coordinate">{code}</small>{level && (!capital || code==='J10') && <span class:list={["building", {"capital-label":capital}]}>{name}<b>Lv{level}</b></span>}<span class="assignment" data-assignment></span></button>;})}</div>
      </div></div>
    </section>
    <aside><h2 data-selection>Feld auswählen</h2><form data-editor><label>Allianz<select name="alliance"><option value="">Offen</option>{alliances.map(a=><option value={a.tag}>{a.tag}</option>)}</select></label><label>Notiz<textarea name="note" maxlength="300" rows="3"></textarea></label><button type="submit" disabled data-save>Übernehmen</button><button type="button" disabled data-clear>Feldeintrag entfernen</button></form>
      <p role="status" data-status aria-live="polite"></p><button type="button" data-export>Plan exportieren</button><label class="import-label">Plan importieren<input data-import type="file" accept="application/json,.json" /></label><p>Ein Import ersetzt den lokalen Plan erst nach Bestätigung.</p>
      <h3>Geplante Felder</h3><ul data-list></ul>
    </aside>
  </div>
  <noscript>Der Kartenplaner benötigt JavaScript. Das Kartenbild und seine Auswertung bleiben sichtbar.</noscript>
</main><SiteFooter /></div>
<script>import "../../scripts/season-planner";</script>
</body></html>
<style>
  details{padding:1rem;border:1px solid #8d784b;border-radius:8px}summary{cursor:pointer}.planner-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:1.5rem;margin:1.5rem 0}.map-scroll{overflow:auto;margin-top:.6rem;border:1px solid #8d784b}.planning-map{position:relative;width:100%;min-width:1000px;padding-top:24px}.planning-grid{display:grid;aspect-ratio:1400/960;grid-template-columns:repeat(20,1fr);grid-template-rows:repeat(20,1fr);border-top:1px solid #777;border-left:1px solid #777}.planning-grid button{border:0;border-right:1px solid #777;border-bottom:1px solid #777;border-radius:0;padding:0;min-width:0;min-height:0;background:#e7e7e7;color:#161616;cursor:pointer;position:relative}.planning-grid button:hover,.planning-grid button:focus-visible,.planning-grid button[data-drop-target]{outline:3px solid #075bff;outline-offset:-3px;z-index:2}.planning-grid button[aria-pressed=true]{box-shadow:inset 0 0 0 3px #075bff}.planning-grid .assignment{position:absolute;inset:auto 1px 1px;font-size:11px;font-weight:bold;color:var(--alliance-ink,#111);background:var(--alliance-color,#fff);line-height:1.4;z-index:2}.assignment:empty{display:none}.planner-layout aside{padding:1rem;background:#151d26;border:1px solid #8d784b;border-radius:8px}form,label{display:grid;gap:.5rem}form{gap:1rem}select,textarea{width:100%;padding:.5rem;background:#fff;color:#111}button,.import-label{padding:.6rem;cursor:pointer}.import-label{margin-top:1rem}input[type=file]{max-width:100%}[data-list]{padding-left:1.2rem;max-height:300px;overflow:auto}[data-list] button{text-align:left;background:transparent;color:inherit;border:0}input[type=range]{max-width:200px}.alliance-tray{margin-top:1.5rem}.alliance-tray h2{margin-bottom:.3rem}.alliance-tokens{display:flex;flex-wrap:wrap;gap:.5rem}.alliance-tokens button{display:flex;align-items:center;gap:.6rem;background:var(--alliance-color,#f0eee8);color:var(--alliance-ink,#171b22);border:1px solid #a89a76;border-radius:6px;cursor:grab;touch-action:none;min-width:85px}.alliance-tokens button[aria-pressed=true]{outline:3px solid #70b7ff}.alliance-tokens small{opacity:.85}.column-labels{position:absolute;inset:0 0 auto;display:grid;grid-template-columns:repeat(20,1fr);text-align:center;font-size:12px}.cell-coordinate{position:absolute;left:2px;top:1px;font-size:8px;color:#555}.planning-grid .building{position:absolute;inset:12px 1px auto;font-size:9px;line-height:1.1;text-align:center;pointer-events:none}.building b{display:block;font-weight:normal}@media(max-width:900px){.planner-layout{grid-template-columns:1fr}}

  :global([data-planner-alliance="GGR"]){--alliance-color:#f59e0b;--alliance-ink:#111}
  :global([data-planner-alliance="CCE"]){--alliance-color:#be185d;--alliance-ink:#fff}
  :global([data-planner-alliance="BTs"]){--alliance-color:#fde047;--alliance-ink:#111}
  :global([data-planner-alliance="Lrs"]){--alliance-color:#0284c7;--alliance-ink:#fff}
  :global([data-planner-alliance="IGGG"]){--alliance-color:#7e22ce;--alliance-ink:#fff}
  :global([data-planner-alliance="TuT"]){--alliance-color:#f0abfc;--alliance-ink:#111}
  :global([data-planner-alliance="BOD"]){--alliance-color:#b91c1c;--alliance-ink:#fff}
  :global([data-planner-alliance="DIE"]){--alliance-color:#15803d;--alliance-ink:#fff}
  :global([data-planner-alliance="LIG"]){--alliance-color:#0f766e;--alliance-ink:#fff}
  :global([data-planner-alliance="Beep"]){--alliance-color:#cbd5e1;--alliance-ink:#111}
  .planning-grid button[data-planner-alliance]:not([data-planner-alliance=""]){background:var(--alliance-color);color:var(--alliance-ink)}

  .planning-grid button[data-level]:not([data-capital])::after{content:"";position:absolute;inset:0;border:3px solid #17212b;pointer-events:none}
  .planning-grid button[data-capital]{border:0}
  .planning-grid button[data-cell="J10"]::after{content:"";position:absolute;inset:0 auto auto 0;width:200%;height:200%;box-sizing:border-box;border:4px solid #17212b;pointer-events:none;z-index:3}
  .planning-grid .capital-label{inset:0;width:200%;height:200%;display:flex;flex-direction:column;justify-content:center;font-size:13px;z-index:3;pointer-events:none;color:#111;text-shadow:0 0 3px #fff,0 0 3px #fff}
  .planning-grid button[data-planner-alliance]:not([data-planner-alliance=""]) .cell-coordinate{color:var(--alliance-ink)}
  .planning-grid button[data-capital] .cell-coordinate{display:none}
  .planning-grid button[data-cell="J10"]{z-index:1}
</style>
