---
import SocialMeta from "../../components/SocialMeta.astro";
import "../../styles/global.css";
import ImageActionIcon from "../../components/ImageActionIcon.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Berechne dein persönliches Instant-Heal-Zeitfenster und eine passende Soldatenzahl für die Allianzhilfe."
    />
    <link rel="icon" type="image/png" href="/drachenhalle/favicon.png" />
    <title>Heilungsplaner · Tools · DIE Drachenhalle</title>
  <SocialMeta title={`Heilungsplaner · Tools · DIE Drachenhalle`} description="Berechne dein persönliches Instant-Heal-Zeitfenster und eine passende Soldatenzahl für die Allianzhilfe." />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader active="tools" />

      <main class="tool-main" id="main-content">
        <nav class="tool-breadcrumb" aria-label="Brotkrümelnavigation">
          <a href="/drachenhalle/tools/">Tools</a>
          <span aria-hidden="true">/</span>
          <span>Heilungsplaner</span>
        </nav>

        <header class="tool-hero healing-tool-hero">
          <div class="healing-hero-copy">
            <p class="eyebrow">Allianzhilfe richtig ausnutzen</p>
            <div class="healing-hero-title-line">
              <h1>Heilungsplaner</h1>
              <button
                type="button"
                class="tip-article-share tool-share-button"
                data-share-page
                data-share-url="/drachenhalle/tools/heilrechner/"
                aria-label="Heilungsplaner teilen"
                title="Heilungsplaner teilen"
              >
                <ImageActionIcon type="share" />
              </button>
            </div>
            <p>
              Plane für T1 bis T10, wie viele Soldaten deine aktiven Helfer sofort heilen können.
              Bei gemischten Heilblöcken orientierst du dich sicherheitshalber an der höchsten Truppenstufe.
            </p>
          </div>
          <div class="healing-hero-flow" aria-label="Vom Spielwert zum sicheren Heilblock">
            <div>
              <span>01</span>
              <strong>Werte</strong>
              <small>Hilfszeit und Limit</small>
            </div>
            <i aria-hidden="true">→</i>
            <div>
              <span>02</span>
              <strong>Helfer</strong>
              <small>aktive Unterstützung</small>
            </div>
            <i aria-hidden="true">→</i>
            <div class="is-result">
              <span>03</span>
              <strong>Heilblock</strong>
              <small>sicher abgerundet</small>
            </div>
          </div>
        </header>

        <section class="healing-calculator" data-healing-calculator aria-labelledby="healing-form-title">
          <form class="healing-form" data-healing-form>
            <div class="healing-form-intro">
              <p class="eyebrow">Schritt 1</p>
              <h2 id="healing-form-title">Deine Allianzhilfe</h2>
              <p>Trage die Werte so ein, wie sie in deinen Kampfwerten angezeigt werden.</p>
              <button
                class="tool-info-launch healing-info-launch"
                type="button"
                aria-label="Werte, Messgrundlage und Rechenweg anzeigen"
                aria-haspopup="dialog"
                aria-controls="healing-help-dialog"
                title="Werte und Rechenweg anzeigen"
                data-healing-help-open
              >
                <span class="tool-info-launch-icon" aria-hidden="true">i</span>
                <span>
                  <strong>Werte &amp; Rechenweg</strong>
                  <small>Fundstellen, Grundzeiten und Formel</small>
                </span>
              </button>
            </div>

            <fieldset>
              <legend>Hilfen &amp; Reserve</legend>
              <div class="healing-field-grid">
                <label>
                  <span>Hilfszeit (Sekunden)</span>
                  <input name="helpSeconds" type="number" min="1" max="999999" step="1" value="742" inputmode="numeric" />
                </label>
                <label>
                  <span>Persönliches Hilfslimit</span>
                  <input name="helpLimit" type="number" min="1" max="100" step="1" value="25" inputmode="numeric" />
                </label>
                <label>
                  <span>Aktive Helfer</span>
                  <input name="activeHelpers" type="number" min="0" max="100" step="1" value="5" inputmode="numeric" />
                </label>
                <label>
                  <span>Sicherheitsreserve</span>
                  <select name="reservePercent">
                    <option value="0">Keine Reserve</option>
                    <option value="5" selected>5 % empfohlen</option>
                    <option value="10">10 % vorsichtig</option>
                    <option value="15">15 % sehr vorsichtig</option>
                  </select>
                </label>
              </div>
              <div class="tool-memory-actions">
                <button type="button" class="tool-memory-button" data-healing-save-values>
                  Persönliche Werte speichern
                </button>
                <button type="button" class="tool-memory-reset" data-healing-clear-values hidden>
                  Gespeicherte Werte löschen
                </button>
                <p class="tool-memory-status" role="status" aria-live="polite" data-healing-storage-status>
                  Nur auf diesem Gerät. Aktive Helfer werden bewusst nicht gespeichert.
                </p>
              </div>
            </fieldset>

            <fieldset>
              <legend>Berechnungsart</legend>
              <div class="healing-method-grid">
                <label class="healing-method-option">
                  <input type="radio" name="calculationMode" value="tier" checked />
                  <span>
                    <strong>Nach Truppenstufe</strong>
                    <small>Direkte Auswahl von T1 bis T10</small>
                  </span>
                </label>
                <label class="healing-method-option">
                  <input type="radio" name="calculationMode" value="calibration" />
                  <span>
                    <strong>Eigene Kalibrierung</strong>
                    <small>Für eigene Messwerte und Sonderfälle</small>
                  </span>
                </label>
              </div>

              <div class="healing-mode-panel" data-healing-mode-panel="tier">
                <div class="healing-field-grid is-tier">
                  <label>
                    <span>Truppenstufe</span>
                    <select name="troopTier">
                      <option value="t1">T1</option>
                      <option value="t2">T2</option>
                      <option value="t3">T3</option>
                      <option value="t4">T4</option>
                      <option value="t5">T5</option>
                      <option value="t6">T6</option>
                      <option value="t7">T7</option>
                      <option value="t8" selected>T8</option>
                      <option value="t9">T9</option>
                      <option value="t10">T10</option>
                    </select>
                  </label>
                  <label>
                    <span>Heilungsgeschwindigkeit ohne Rollenbonus (%)</span>
                    <input name="healingSpeed" type="number" min="0" max="9999" step="0.01" value="100.90" inputmode="decimal" />
                  </label>
                </div>
                <label class="healing-role-option">
                  <input name="tacticalMinister" type="checkbox" value="yes" />
                  <span>
                    <strong>Taktischer Minister aktiv</strong>
                    <small>Der Planer addiert für diese Berechnung 20 Prozentpunkte.</small>
                  </span>
                </label>
                <aside class="healing-tier-notice">
                  <span aria-hidden="true">!</span>
                  <p><strong>Mehrere Truppenstufen?</strong> Wähle immer die höchste Stufe, die in deinem Heilblock vorkommt. So plant der Planer vorsichtig und überschätzt die mögliche Soldatenzahl nicht. Trage bei der Heilungsgeschwindigkeit immer den Wert <strong>ohne</strong> den Bonus des Taktischen Ministers ein.</p>
                </aside>
                <p class="healing-field-help">
                  Der eingegebene Prozentwert wird als Bonus auf die Grundgeschwindigkeit gerechnet. Das Amt erhöht ihn optional um 20 Prozentpunkte.
                </p>
              </div>

              <div class="healing-mode-panel" data-healing-mode-panel="calibration" hidden>
                <p class="healing-field-help">
                  Wähle im Krankenhaus eine einheitliche Truppengruppe und trage Anzahl sowie die
                  dort angezeigte Heilzeit ein. Deine aktuellen Boni sind darin bereits enthalten.
                </p>
                <div class="healing-field-grid is-calibration">
                  <label>
                    <span>Ausgewählte Soldaten</span>
                    <input name="calibrationSoldiers" type="number" min="1" max="99999999" step="1" inputmode="numeric" placeholder="z. B. 100" />
                  </label>
                  <label>
                    <span>Heilzeit · Stunden</span>
                    <input name="calibrationHours" type="number" min="0" max="999" step="1" inputmode="numeric" placeholder="1" />
                  </label>
                  <label>
                    <span>Heilzeit · Minuten</span>
                    <input name="calibrationMinutes" type="number" min="0" max="59" step="1" inputmode="numeric" placeholder="14" />
                  </label>
                  <label>
                    <span>Heilzeit · Sekunden</span>
                    <input name="calibrationSeconds" type="number" min="0" max="59" step="1" inputmode="numeric" placeholder="40" />
                  </label>
                </div>
              </div>
            </fieldset>

            <button class="tool-primary-button" type="submit">Heilblock planen</button>
            <p class="healing-form-error" role="alert" data-healing-error hidden></p>
          </form>

          <section class="healing-result" data-healing-result data-state="warning" aria-live="polite" aria-atomic="false">
            <div class="healing-result-character" aria-hidden="true">
              <img
                src="/drachenhalle/brand/tool-healing-anthlan-happy.webp"
                alt=""
                width="696"
                height="1044"
                data-healing-character-happy
              />
              <img
                src="/drachenhalle/brand/tool-healing-anthlan-concerned.webp"
                alt=""
                width="696"
                height="1044"
                data-healing-character-concerned
                hidden
              />
              <img
                src="/drachenhalle/brand/tool-healing-anthlan-unsure.webp"
                alt=""
                width="696"
                height="1044"
                data-healing-character-unsure
                hidden
              />
              <img
                src="/drachenhalle/brand/tool-healing-anthlan-over-limit.webp"
                alt=""
                width="696"
                height="1044"
                data-healing-character-over-limit
                hidden
              />
            </div>
            <div class="healing-result-heading">
              <div class="healing-result-icon" aria-hidden="true">✚</div>
              <div>
                <p class="eyebrow" data-healing-kicker>Zeitfenster berechnet</p>
                <h2 data-healing-title>Dein sicherer Heilblock</h2>
                <p data-healing-summary></p>
              </div>
            </div>

            <div class="healing-result-facts" data-healing-facts></div>

            <div class="healing-recommendation" data-healing-recommendation>
              <p class="eyebrow">Empfehlung</p>
              <strong data-healing-soldiers>Soldatenzahl noch offen</strong>
              <p data-healing-detail></p>
            </div>

            <ol class="healing-steps" aria-label="Empfohlener Ablauf">
              <li><span>1</span><p>Passenden Heilblock auswählen.</p></li>
              <li><span>2</span><p>Heilung starten und im Allianzchat um Hilfe bitten.</p></li>
              <li><span>3</span><p>Nach den Hilfen den nächsten kleinen Block starten.</p></li>
            </ol>
          </section>
        </section>

        <section class="tool-reference" aria-labelledby="healing-reference-title">
          <header>
            <p class="eyebrow">Grundlage & Genauigkeit</p>
            <h2 id="healing-reference-title">Zwei Wege zur passenden Soldatenzahl</h2>
          </header>
          <div class="tool-reference-grid">
            <article>
              <span aria-hidden="true">🤝</span>
              <div>
                <h3>Hilfszeit × Helfer</h3>
                <p>
                  Das sichere Zeitfenster basiert auf deiner persönlichen Hilfszeit und höchstens
                  so vielen Helfern, wie dein Hilfslimit zulässt.
                </p>
                <a href="/drachenhalle/docs/tipp-08-soldaten-schneller-heilen/">
                  Tipp 8 vollständig lesen →
                </a>
              </div>
            </article>
            <article>
              <span aria-hidden="true">🧪</span>
              <div>
                <h3>Andere Truppen kalibrieren</h3>
                <p>
                  Solange weitere Basiswerte fehlen, übersetzt eine eigene Messung das sichere
                  Zeitfenster für jede andere Stufe oder Truppenzusammensetzung.
                </p>
              </div>
            </article>
          </div>
          <p class="tool-disclaimer">
            Der Planer ist eine Planungshilfe. Prüfe den Heil-Timer vor dem Start im Spiel und
            plane nur Helfer ein, die voraussichtlich sofort reagieren. Änderungen an Truppen,
            Gebäuden, Überlebenden oder Allianz-Technologie können das Ergebnis verändern.
          </p>
        </section>

        <dialog class="healing-help-dialog tool-info-dialog" id="healing-help-dialog" aria-labelledby="healing-help-title">
          <div class="healing-help-content">
            <header class="healing-help-heading">
              <div>
                <p class="eyebrow">Grundlage des Planers</p>
                <h2 id="healing-help-title">Werte finden &amp; Berechnung verstehen</h2>
              </div>
              <button type="button" class="healing-help-close" aria-label="Anleitung schließen" title="Schließen" data-healing-help-close>×</button>
            </header>

            <section class="tool-info-section" aria-labelledby="healing-values-title">
              <div class="tool-info-section-heading">
                <span>01</span>
                <div>
                  <p class="eyebrow">Im Spiel nachsehen</p>
                  <h3 id="healing-values-title">Diese drei Werte brauchst du</h3>
                </div>
              </div>
              <ol class="healing-help-steps tool-guide-grid">
              <li>
                <figure class="tool-guide-card">
                  <img src="/drachenhalle/tutorial/heilrechner/01-basis-buff.png" alt="Eigene Basis mit markiertem Schild-Symbol" loading="lazy" />
                  <figcaption><strong>1. Buffs öffnen</strong><span>Tippe deine eigene Basis an und öffne das Schild-Symbol.</span></figcaption>
                </figure>
              </li>
              <li>
                <figure class="tool-guide-card">
                  <img src="/drachenhalle/tutorial/heilrechner/02-hilflimit-hilfszeit.png" alt="Wirtschaftstyp mit markiertem Hilfslimit und markierter Hilfszeit" loading="lazy" />
                  <figcaption><strong>2. Hilfswerte ablesen</strong><span>Öffne „Wirtschaftstyp“ und übernimm Hilfslimit sowie Hilfszeit.</span></figcaption>
                </figure>
              </li>
              <li>
                <figure class="tool-guide-card">
                  <img src="/drachenhalle/tutorial/heilrechner/03-heilungsgeschwindigkeit.png" alt="Wirtschaftstyp mit markierter Heilungsgeschwindigkeit" loading="lazy" />
                  <figcaption><strong>3. Heilungsgeschwindigkeit</strong><span>Scrolle im selben Bereich zur Heilungsgeschwindigkeit und trage den Wert ohne den Rollenbonus des Taktischen Ministers ein.</span></figcaption>
                </figure>
              </li>
              </ol>
            </section>

            <section class="tool-info-section" aria-labelledby="healing-formula-title">
              <div class="tool-info-section-heading">
                <span>02</span>
                <div>
                  <p class="eyebrow">Messwerte &amp; Methodik</p>
                  <h3 id="healing-formula-title">So entsteht dein Heilblock</h3>
                </div>
              </div>
              <div class="healing-methodology-grid">
                <article>
                  <strong>Grundzeiten je Soldat</strong>
                  <p>T5 bis T9 wurden gemessen: 60, 70, 80, 90 und 100 Sekunden. T1 bis T4 sowie T10 folgen derselben Zehn-Sekunden-Staffelung und sind deshalb hochgerechnet.</p>
                </article>
                <article>
                  <strong>Die Formel</strong>
                  <div class="healing-formula" aria-label="Berechnungsformel">
                    <span>Sicheres Zeitfenster</span>
                    <code>Hilfszeit × nutzbare Helfer × (1 − Reserve)</code>
                    <span>Sekunden je Soldat</span>
                    <code>Grundzeit ÷ (1 + (Basiswert + ggf. 20) ÷ 100)</code>
                    <span>Empfohlene Soldaten</span>
                    <code>⌊ sicheres Zeitfenster ÷ Sekunden je Soldat ⌋</code>
                  </div>
                </article>
              </div>
              <p class="tool-info-footnote">Der Planer rundet die Soldatenzahl immer ab. Bei mehreren Truppenstufen gilt zur sicheren Planung die höchste vorhandene Stufe. Für „Taktischer Minister“ muss die eingegebene Heilungsgeschwindigkeit den Rollenbonus noch nicht enthalten.</p>
            </section>
          </div>
        </dialog>
      </main>

      <SiteFooter />
    </div>

    <p class="share-feedback" role="status" aria-live="polite" aria-atomic="true" data-share-feedback></p>

    <script>
      import { initializeImageActions } from "../../scripts/image-actions";
      import { initializeHealingCalculator } from "../../scripts/healing-calculator";

      initializeHealingCalculator();
      initializeImageActions();

      const healingHelpDialog = document.querySelector("#healing-help-dialog");
      const healingHelpOpen = document.querySelector("[data-healing-help-open]");
      const healingHelpClose = document.querySelector("[data-healing-help-close]");

      if (healingHelpDialog instanceof HTMLElement) {
        const openHealingHelp = () => {
          const dialog = healingHelpDialog as HTMLDialogElement;
          if (typeof dialog.showModal === "function") dialog.showModal();
          else dialog.setAttribute("open", "");
        };
        const closeHealingHelp = () => {
          const dialog = healingHelpDialog as HTMLDialogElement;
          if (typeof dialog.close === "function") dialog.close();
          else dialog.removeAttribute("open");
        };

        healingHelpOpen?.addEventListener("click", openHealingHelp);
        healingHelpClose?.addEventListener("click", closeHealingHelp);
        healingHelpDialog.addEventListener("click", (event) => {
          if (event.target === healingHelpDialog) closeHealingHelp();
        });
      }
    </script>
  </body>
</html>
