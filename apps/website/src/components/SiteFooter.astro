---
const repositoryUrl = "https://github.com/Anthlan/drachenhalle";
const pageViewsApiUrl = import.meta.env.PUBLIC_PAGE_VIEWS_API_URL?.replace(/\/$/, "") ?? "";
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN ?? "";
---

<footer>
  <div class="footer-copy">
    <p>Inoffizielles Fan- und Community-Projekt · DIE Drachenhalle</p>
    {pageViewsApiUrl && (
      <p
        class="page-view-count"
        data-page-views
        data-endpoint={pageViewsApiUrl}
        title="Gezählt werden Seitenaufrufe, keine einzelnen Personen."
        aria-live="polite"
        hidden
      >
        <span data-page-view-current></span> Aufrufe dieser Seite
        <span aria-hidden="true">·</span>
        <span data-page-view-total></span> insgesamt
      </p>
    )}
  </div>
  <nav class="footer-links" aria-label="Weiterführende Links">
    <a href="/drachenhalle/docs/styleguides/">Styleguides</a>
    <a href={repositoryUrl}>Auf GitHub ansehen <span aria-hidden="true">↗</span></a>
  </nav>
</footer>

{cloudflareAnalyticsToken && (
  <span data-traffic-analytics data-token={cloudflareAnalyticsToken} hidden></span>
)}

<script>
  import { initializeCloudflareAnalytics } from "../scripts/cloudflare-analytics";
  import { initializePageViews } from "../scripts/page-views";

  initializePageViews();
  initializeCloudflareAnalytics();
</script>
