---
const embers = [5, 10, 15, 21, 26, 31, 37, 42, 48, 53, 58, 64, 69, 74, 80, 85, 90, 95];
---

<div class="hall-atmosphere" aria-hidden="true">
  <div class="hall-light"></div>
  <div class="hall-mist"></div>
  {embers.map((left, index) => (
    <span class="hall-ember" style={`--left:${left}%;--delay:${-2 - index * 1.3}s;--duration:${7 + index % 4}s;--drift:${index % 2 ? 42 : -32}px;--size:${1.5 + index % 3 * .5}px`}></span>
  ))}
</div>
<button class="hall-motion-toggle" type="button" aria-pressed="false" hidden>
  Animation pausieren
</button>

<style>
  .hall-atmosphere {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hall-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 12% 65%, rgb(255 141 37 / 34%), transparent 40%),
      radial-gradient(ellipse at 88% 55%, rgb(255 183 71 / 28%), transparent 42%),
      radial-gradient(ellipse at 52% 90%, rgb(255 168 61 / 24%), transparent 55%);
    mix-blend-mode: screen;
    animation: hall-glow 3.5s ease-in-out -1.5s infinite alternate;
  }

  .hall-mist {
    position: absolute;
    inset: 78% -25% -12%;
    background:
      radial-gradient(ellipse at 24% 62%, rgb(188 203 225 / 27%), transparent 40%),
      radial-gradient(ellipse at 70% 82%, rgb(225 193 145 / 23%), transparent 42%);
    animation: hall-drift 10s ease-in-out -4s infinite alternate;
  }

  .hall-ember {
    position: absolute;
    bottom: 3%;
    left: var(--left);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: #ffd093;
    box-shadow: 0 0 6px 1px rgb(238 146 51 / 60%);
    opacity: 0;
    animation: hall-rise var(--duration) linear var(--delay) infinite;
  }

  .hall-motion-toggle {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    padding: 8px 11px;
    min-height: 44px;
    border: 1px solid rgb(246 216 141 / 35%);
    border-radius: 4px;
    background: rgb(6 9 20 / 82%);
    color: var(--gold-pale);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  .hall-motion-toggle:hover { background: var(--navy); }
  .hall-motion-toggle:focus-visible { outline: 2px solid var(--gold-pale); outline-offset: 3px; }
  .hall-atmosphere[data-paused] > div,
  .hall-atmosphere[data-paused] > span { animation-play-state: paused; }

  @keyframes hall-glow {
    from { opacity: .35; }
    to { opacity: 1; }
  }

  @keyframes hall-drift {
    from { transform: translateX(-10%); opacity: .55; }
    to { transform: translateX(10%); opacity: 1; }
  }

  @keyframes hall-rise {
    0% { transform: translate(0, 0); opacity: 0; }
    12% { opacity: .95; }
    60% { opacity: .8; }
    100% { transform: translate(var(--drift), -240px); opacity: 0; }
  }

  @media (max-width: 600px) {
    .hall-ember:nth-of-type(even) { display: none; }
    .hall-motion-toggle { top: 8px; right: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hall-light, .hall-mist, .hall-ember { animation: none; }
    .hall-light { opacity: .5; }
    .hall-mist { opacity: .5; }
    .hall-ember, .hall-motion-toggle { display: none; }
  }
</style>

<script>
  const atmosphere = document.querySelector<HTMLElement>(".hall-atmosphere");
  const toggle = document.querySelector<HTMLButtonElement>(".hall-motion-toggle");
  if (atmosphere && toggle) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let paused = false;
    let visible = true;
    const update = () => {
      atmosphere.toggleAttribute("data-paused", paused || !visible || document.hidden || reducedMotion.matches);
      toggle.hidden = reducedMotion.matches;
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.textContent = paused ? "Animation fortsetzen" : "Animation pausieren";
    };
    toggle.addEventListener("click", () => { paused = !paused; update(); });
    reducedMotion.addEventListener("change", update);
    document.addEventListener("visibilitychange", update);
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    });
    observer.observe(atmosphere);
    update();
  }
</script>
